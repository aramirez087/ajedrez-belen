---
import fontsCss from '../styles/fonts.css?inline';
import landingCss from '../styles/landing.css?inline';
import KnightScene from '../components/KnightScene.astro';
import HeroBoard from '../components/HeroBoard.astro';
import ClubPhoto from '../components/ClubPhoto.astro';
import PuzzleBoard from '../components/PuzzleBoard.astro';
import OperaGame from '../components/OperaGame.astro';
import ClubPurpose from '../components/ClubPurpose.astro';
import ChessPieceSprite from '../components/ChessPieceSprite.astro';
import ChessPiece, { type PieceId } from '../components/ChessPiece.astro';
import { association as a } from '../data/association';
import { knightImage, crestImage } from '../data/landing-media';

const waBase = 'https://wa.me/' + a.whatsapp?.replace(/\D/g, '');
const wa = (msg: string) => `${waBase}?text=${encodeURIComponent(msg)}`;
const contactUrl = wa('Hola, Ajedrez Belén. Quiero coordinar una primera clase gratuita. ¿Me ayudan a confirmar el grupo y la fecha?');
const crest = crestImage(a.crest);
const knight = knightImage(a.heroKnight);
const canonicalUrl = 'https://ajedrezbelen.com/';
const pageTitle = 'Clases de ajedrez en Belén, Heredia | Ajedrez Belén';
const socialImage = new URL('/media/og-portada.jpg', canonicalUrl).href;

// A climb along one diagonal: every square on it shares a colour, as on a real board.
const classes: { step: number; name: string; invitation: string; description: string; fee: string; symbol: PieceId; square: string }[] = [
  { step: 0, name: 'Iniciación', invitation: 'Tu primera jugada', description: 'Conocer las piezas, descubrir el tablero y disfrutar de las primeras partidas.', fee: a.fees[0].amount, symbol: 'wP', square: 'b2' },
  { step: 1, name: 'Cadetes e intermedios', invitation: 'Encuentra tu juego', description: 'Reconocer ideas, practicar y tomar decisiones con más confianza.', fee: a.fees[1].amount, symbol: 'wR', square: 'd4' },
  { step: 2, name: 'Avanzados', invitation: 'Piensa un paso más allá', description: 'Profundizar en la estrategia y seguir afinando cada partida.', fee: a.fees[1].amount, symbol: 'wQ', square: 'f6' },
];
const principles: { title: string; body: string; symbol: PieceId }[] = [
  { title: 'Jugar', body: 'Partidas desde el primer día. Se aprende jugando, no mirando.', symbol: 'bN' },
  { title: 'Pensar', body: 'Ideas, planes y decisiones. Cada jugada entrena la cabeza.', symbol: 'bB' },
  { title: 'Compartir', body: 'Un rival al frente y un amigo al lado. El tablero nos reúne.', symbol: 'bR' },
];
const contents = [
  { href: '#niveles', title: 'Clases y precios', kicker: `Tres niveles, desde ${a.fees[0].amount}` },
  { href: '#reto', title: 'El reto', kicker: '¿Mate en una jugada?' },
  { href: '#partida', title: 'La partida', kicker: 'París, 1858' },
  { href: '#asociacion', title: 'El club', kicker: 'Quiénes somos' },
  { href: '#preguntas', title: 'Preguntas', kicker: 'Antes de mover' },
];
const steps = [
  { title: 'Escríbenos', body: 'Cuéntanos quién quiere aprender y su edad. Te compartimos el formulario para la clase de prueba, uno por atleta.' },
  { title: 'Coordina tu visita', body: 'Confirmamos con los entrenadores el grupo y la fecha. Para principiantes hay dos horarios los sábados.' },
  { title: 'Prueba una clase gratis', body: 'Conoce al grupo y la dinámica en el Polideportivo de Belén. Después decides si quieres continuar, sin compromiso.' },
];
const faqs = [
  { q: '¿Necesito saber jugar para empezar?', a: 'No. El nivel de Iniciación está hecho para dar los primeros pasos: conocer las piezas, el tablero y disfrutar las primeras partidas desde cero.' },
  { q: '¿Cuánto cuesta la mensualidad?', a: 'Iniciación cuesta ₡12.000 al mes y los niveles de cadetes, intermedios y avanzados ₡15.000 al mes. Con dos o más hermanos o miembros de la misma familia inscritos, el 25 % de descuento se aplica automáticamente en la mensualidad de cada uno.' },
  { q: '¿Desde qué edad se puede participar?', a: `Recibimos niños, jóvenes y adultos desde los ${a.minimumAge} años. No necesitas experiencia para empezar en Iniciación.` },
  { q: '¿Puedo probar una clase antes de inscribirme?', a: 'Sí. La primera clase de evaluación es gratuita y sin compromiso. Escríbenos por WhatsApp: te compartimos el formulario, uno por atleta, y coordinamos la fecha con los entrenadores.' },
  { q: '¿Dónde y cuándo son las clases?', a: `Nos encontramos en el ${a.venue}. ${a.schedule} Confirma con nosotros la disponibilidad del grupo y la fecha de tu primera visita.` },
  { q: '¿Cuántas clases hay por semana?', a: 'Principiantes tiene una clase presencial por semana. Los otros grupos incluyen una clase presencial y otra virtual por semana. Te compartimos los horarios y la duración del grupo que te corresponda al coordinar.' },
  { q: '¿Hay un costo adicional para competir?', a: 'Cuando un atleta empieza a participar en torneos federados, debe pagar ₡13.000 al año por la inscripción a la Federación Costarricense de Ajedrez (FCA). La asociación gestiona esta inscripción; es un pago separado de la mensualidad.' },
];
// Morphy vs. Brunswick and Isouard, Paris 1858, in Spanish algebraic notation.
const score: [string, string?][] = [
  ['e4', 'e5'], ['Cf3', 'd6'], ['d4', 'Ag4'], ['dxe5', 'Axf3'], ['Dxf3', 'dxe5'], ['Ac4', 'Cf6'], ['Db3', 'De7'], ['Cc3', 'c6'], ['Ag5', 'b5'],
  ['Cxb5', 'cxb5'], ['Axb5+', 'Cbd7'], ['O-O-O', 'Td8'], ['Txd7', 'Txd7'], ['Td1', 'De6'], ['Axd7+', 'Cxd7'], ['Db8+', 'Cxb8'], ['Td8#'],
];
// The five positions shown on the board above: 3…Ag4, 9.Ag5, 12.O-O-O, 16.Db8+ and 17.Td8#.
const keyMoves = new Set(['3b', '9w', '12w', '16w', '17w']);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: a.name,
  alternateName: a.fullName,
  url: canonicalUrl,
  telephone: a.whatsapp ? `+${a.whatsapp}` : undefined,
  email: a.email,
  sport: 'Chess',
  description: 'Club y clases de ajedrez en Belén, Heredia, Costa Rica. Niveles de iniciación, cadetes, intermedios y avanzados.',
  address: { '@type': 'PostalAddress', addressLocality: 'Belén', addressRegion: 'Heredia', addressCountry: 'CR' },
  sameAs: ['https://www.facebook.com/ajedrezbelen'],
};
---
<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Clases de ajedrez desde los 6 años en el Polideportivo de Belén, Heredia. Principiantes los sábados, desde ₡12.000 al mes. Coordina tu primera clase gratis." />
    <meta name="theme-color" content="#f3eee3" />
    <meta name="color-scheme" content="only light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content="Ajedrez desde los 6 años en el Polideportivo de Belén. Principiantes los sábados y mensualidades desde ₡12.000. Coordina tu primera clase gratis." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portada de Ajedrez Belén: un caballo de madera frente a la palabra Ajedrez. Primera clase gratis." />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/media/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/media/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bodoni-moda-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bodoni-moda-latin-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={knight.src} as="image" imagesrcset={knight.srcset} imagesizes={knight.sizes} fetchpriority="high" />
    <style is:inline set:html={fontsCss}></style>
    <style is:inline set:html={landingCss}></style>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <ChessPieceSprite />
    <svg class="piece-sprite" aria-hidden="true" focusable="false" width="0" height="0">
      <symbol id="icon-wa" viewBox="0 0 24 24"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.69.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z" /></symbol>
      <symbol id="icon-arrow" viewBox="0 0 20 20"><path d="M3.5 10h13M11 4.5l5.5 5.5-5.5 5.5" /></symbol>
      <symbol id="icon-down" viewBox="0 0 20 20"><path d="M10 3.5v13M4.5 11l5.5 5.5 5.5-5.5" /></symbol>
      <symbol id="icon-out" viewBox="0 0 20 20"><path d="M5.5 14.5 14.5 5.5M7 5.5h7.5V13" /></symbol>
      <symbol id="icon-pin" viewBox="0 0 20 20"><path d="M10 18s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z" /><circle cx="10" cy="8" r="2.2" /></symbol>
      <symbol id="icon-star" viewBox="0 0 20 20"><path d="m10 1.5 2.6 5.5 6 .7-4.5 4.1 1.2 5.9L10 14.8l-5.3 2.9 1.2-5.9L1.4 7.7l6-.7Z" /></symbol>
      <symbol id="icon-scissors" viewBox="0 0 24 24"><circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12" /></symbol>
    </svg>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header" data-header>
      <div class="frame header-inner">
        <a href="#inicio" class="brand" aria-label="Ajedrez Belén, inicio">
          <img {...crest} alt="" width="36" height="39" />
          <span class="brand-text">Ajedrez Belén</span>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="#niveles">Clases</a>
          <a href="#reto">El reto</a>
          <a class="nav-optional" href="#partida">La partida</a>
          <a href="#asociacion">El club</a>
          <a href="#preguntas">Preguntas</a>
        </nav>
        <a class="header-cta" href={contactUrl} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp"><svg class="icon icon-fill" aria-hidden="true"><use href="#icon-wa" /></svg><span class="header-cta-label">Escríbenos</span></a>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <section id="inicio" class="cover" aria-labelledby="hero-heading">
        <div class="frame cover-frame">
          <p class="cover-issue" data-hero style="--d: 0"><span>Belén, Heredia · Costa Rica</span><span>Club de ajedrez · Polideportivo de Belén</span><span>Desde los {a.minimumAge} años</span></p>
          <p class="masthead" aria-hidden="true"><span>Ajedrez</span></p>
          <KnightScene src={a.heroKnight} />
          <div class="cover-copy">
            <h1 id="hero-heading" data-hero style="--d: 1"><span>Un tablero.</span> <span>Un mundo</span> <em>por descubrir.</em></h1>
            <p class="cover-lede" data-hero style="--d: 2">Ajedrez para niños, jóvenes y adultos desde los {a.minimumAge} años, en el Polideportivo de Belén. Tu primera clase es gratis.</p>
            <div class="cover-actions" data-hero style="--d: 3">
              <a class="button" href={contactUrl} target="_blank" rel="noopener noreferrer">Probar una clase gratis <span class="button-badge"><svg class="icon icon-fill" aria-hidden="true"><use href="#icon-wa" /></svg></span><span class="visually-hidden"> (WhatsApp)</span></a>
              <a class="text-link" href="#niveles">Ver clases y precios <svg class="icon icon-down" aria-hidden="true"><use href="#icon-down" /></svg></a>
            </div>
          </div>
          <dl class="cover-facts" data-hero style="--d: 4">
            <div><dt>Mensualidad</dt><dd><span class="cur">₡</span>{a.fees[0].amount.slice(1)}<small>al mes, en Iniciación</small></dd></div>
            <div><dt>Desde los</dt><dd>{a.minimumAge} <em>años</em><small>niños, jóvenes y adultos</small></dd></div>
            <div><dt>Primera clase</dt><dd><em>Gratis</em><small>sin compromiso</small></dd></div>
          </dl>
        </div>
      </section>

      <nav class="contents" aria-label="En esta página">
        <div class="frame contents-inner">
          <p class="contents-label" aria-hidden="true">Índice</p>
          <ol class="contents-list">
            {contents.map((c, i) => (
              <li><a href={c.href}><span class="contents-num">{String(i + 1).padStart(2, '0')}</span><span class="contents-title">{c.title}</span><span class="contents-kicker">{c.kicker}</span></a></li>
            ))}
          </ol>
        </div>
      </nav>

      <section id="niveles" class="levels" aria-labelledby="levels-heading">
        <div class="frame">
          <header class="section-head">
            <p class="kicker" data-reveal><span class="kicker-num">01</span>Clases y mensualidades</p>
            <h2 id="levels-heading" class="section-title" data-reveal>De peón <em>a dama.</em></h2>
            <p class="section-lede" data-reveal style="--d: 1">Tres niveles y un mismo tablero. Tu primera partida o tu próximo reto: empieza donde estás y sube a tu ritmo.</p>
          </header>
          <div class="ladder-wrap">
          <div class="ladder-path" data-reveal aria-hidden="true"><span class="ladder-stop" style="--at: .25"><span>c3</span></span><span class="ladder-stop" style="--at: .75"><span>e5</span></span></div>
          <ol id="mensualidades" class="ladder" aria-label="Niveles y mensualidades">
            {classes.map((c) => (
              <li class="rung" style={`--step: ${c.step}; --d: ${c.step}`} data-reveal>
                <div class="rung-tile" aria-hidden="true"><ChessPiece id={c.symbol} /><span class="rung-coord">{c.square}</span></div>
                <div class="rung-body">
                  <p class="rung-step">Nivel {c.step + 1} · {c.invitation}</p>
                  <h3>{c.name}</h3>
                  <p class="rung-desc">{c.description}</p>
                  <p class="rung-price"><span class="price"><span class="cur">₡</span>{c.fee.slice(1)}</span><span class="price-per">por mes</span></p>
                  <a class="text-link" href={wa(`Hola, Ajedrez Belén. Quiero información sobre el nivel ${c.name}.`)} target="_blank" rel="noopener noreferrer" aria-label={`Empezar aquí: ${c.name}, por WhatsApp`}>Empezar aquí <svg class="icon icon-out" aria-hidden="true"><use href="#icon-out" /></svg></a>
                </div>
              </li>
            ))}
          </ol>
          </div>
          <p class="levels-help" data-reveal><span>¿No sabes por dónde empezar?</span><a class="text-link" href={wa('Hola, Ajedrez Belén. No sé qué nivel me conviene, ¿me ayudan a encontrarlo?')} target="_blank" rel="noopener noreferrer">Te ayudamos a encontrar tu nivel <svg class="icon icon-out" aria-hidden="true"><use href="#icon-out" /></svg><span class="visually-hidden"> (WhatsApp)</span></a></p>
          <dl class="levels-facts">
            <div data-reveal><dt>Dónde nos encontramos</dt><dd>{a.venue}.</dd></div>
            <div data-reveal style="--d: 1"><dt>Principiantes · sábados</dt><dd>8:00 a. m. o 1:00 p. m.</dd></div>
            <div data-reveal style="--d: 2"><dt>Tu primera clase</dt><dd>Gratuita y sin compromiso.<span>Confirma el grupo y la fecha por WhatsApp.</span></dd></div>
          </dl>
          <div class="coupon" data-reveal>
            <svg class="icon coupon-scissors" aria-hidden="true"><use href="#icon-scissors" /></svg>
            <p class="coupon-figure" aria-hidden="true">25<span>%</span></p>
            <div class="coupon-body">
              <p class="coupon-label">Descuento familiar</p>
              <h3>Una pasión que se comparte.</h3>
              <p>Con dos o más hermanos o miembros de la misma familia inscritos, el 25 % de descuento se aplica automáticamente en la mensualidad de cada uno.</p>
            </div>
            <a class="button button-ink" href={wa('Hola, Ajedrez Belén. Quiero consultar por el descuento familiar.')} target="_blank" rel="noopener noreferrer">Consultar <span class="button-badge"><svg class="icon icon-fill" aria-hidden="true"><use href="#icon-wa" /></svg></span><span class="visually-hidden"> el descuento familiar por WhatsApp</span></a>
          </div>
          <details class="pay-note"><summary>Sobre el pago mensual <span class="plus" aria-hidden="true"></span></summary><p>El pago se realiza dentro de los primeros 8 días del mes. Al realizarlo, identifica al atleta con su nombre y apellido. Las familias inscritas registran la transferencia en el <a href="/portal">Portal de pagos</a> y reciben su comprobante tras la verificación.</p></details>
        </div>
      </section>

      <section id="equipo" class="team-feature" aria-labelledby="team-heading">
        <div class="frame team-feature-grid">
          <div class="team-feature-copy" data-reveal>
            <p class="kicker">Las caras de Belén</p>
            <h2 id="team-heading">El ajedrez nos reúne.<br /><em>El equipo nos une.</em></h2>
            <p>Detrás de cada partida hay personas que aprenden, se acompañan y crecen juntas. Aquí también hay un lugar para ti.</p>
            <a class="text-link" href="#asociacion">Conoce nuestro club <svg class="icon icon-down" aria-hidden="true"><use href="#icon-down" /></svg></a>
          </div>
          <figure class="team-feature-photo" data-reveal>
            <ClubPhoto name="equipo-belen" alt="El equipo de Ajedrez Belén reunido al aire libre con sus uniformes rojos y la bandera del club." sizes="(min-width: 1600px) 815px, (min-width: 1488px) calc(865px - 3.18vw), (min-width: 800px) 54.85vw, (min-width: 455px) 91.2vw, calc(100vw - 40px)" />
            <figcaption><span>Muchas historias. Un mismo equipo.</span><span>Belén · Costa Rica</span></figcaption>
          </figure>
        </div>
      </section>

      <section id="reto" class="challenge" aria-labelledby="challenge-heading">
        <div class="frame">
          <p class="column-rule" aria-hidden="true"><span>Ajedrez Belén · La columna del club</span><span>Problema de la semana</span></p>
          <div class="challenge-grid">
            <div class="challenge-copy">
              <p class="kicker" data-reveal><span class="kicker-num">02</span>El reto</p>
              <h2 id="challenge-heading" class="section-title" data-reveal>¿Puedes dar<br /><em>jaque mate</em><br />en una jugada?</h2>
              <p class="dropcap" data-reveal>Así empieza todo en el club: con una posición, una idea y las ganas de encontrarla. Juegan las blancas. Una sola jugada y la partida se acaba.</p>
              <div class="puzzle-win" data-puzzle-win>
                <p>Esa es la sensación. Ahora imagínala cada semana.</p>
                <a class="button" href={wa('Hola, Ajedrez Belén. Resolví el reto de la página y quiero información sobre las clases.')} target="_blank" rel="noopener noreferrer">Quiero jugar en serio <span class="button-badge"><svg class="icon icon-fill" aria-hidden="true"><use href="#icon-wa" /></svg></span><span class="visually-hidden"> (WhatsApp)</span></a>
              </div>
            </div>
            <div data-reveal style="--d: 1"><PuzzleBoard /></div>
          </div>
        </div>
      </section>

      <section id="partida" class="opera-section" aria-labelledby="game-heading">
        <div class="frame">
          <header class="section-head">
            <p class="kicker" data-reveal><span class="kicker-num">03</span>La partida · Ópera de París</p>
            <h2 id="game-heading" class="section-title" data-reveal>París, 1858.<br /><em>Una obra maestra</em><br />en 17 jugadas.</h2>
            <p class="section-lede" data-reveal style="--d: 1">Paul Morphy, de 21 años, jugó esta partida en un palco de la ópera contra dos aristócratas que consultaban cada movimiento. Sigue bajando: el tablero te muestra cinco jugadas destacadas.</p>
          </header>
          <OperaGame />
          <div class="game-score">
            <p class="game-score-label" id="planilla-label">Planilla completa · Las jugadas destacadas, en rojo</p>
            <ol class="game-moves" aria-labelledby="planilla-label">
              {score.map(([white, black], i) => (
                <li><span class="move-number">{i + 1}.</span> <span class:list={[{ 'is-key': keyMoves.has(`${i + 1}w`) }]}>{white}{keyMoves.has(`${i + 1}w`) && <span class="visually-hidden"> (destacada)</span>}</span>{black && <> <span class:list={[{ 'is-key': keyMoves.has(`${i + 1}b`) }]}>{black}{keyMoves.has(`${i + 1}b`) && <span class="visually-hidden"> (destacada)</span>}</span></>}</li>
              ))}
            </ol>
            <p class="game-result">1–0</p>
          </div>
          <p class="game-source">Morphy vs. Duque Karl de Brunswick y Conde Isouard · Ópera de París, 1858 · Defensa Philidor — conocida como «la partida de la ópera».</p>
        </div>
      </section>

      <section id="asociacion" class="club" aria-labelledby="intro-heading">
        <div class="frame">
          <div class="club-intro">
            <p class="kicker" data-reveal><span class="kicker-num">04</span>El club</p>
            <h2 id="intro-heading" class="section-title" data-reveal>Aprender a jugar.<br /><em>Encontrar con quién.</em></h2>
            <div class="club-copy" data-reveal style="--d: 1">
              <p class="association-name">{a.fullName}</p>
              <p>Somos una asociación conformada por padres de familia. Con el apoyo del CCDR de Belén, compartimos el ajedrez con niños, jóvenes y adultos: un espacio para aprender juntos y disfrutar cada partida.</p>
              <p class="club-note">Para quienes empiezan.<br />Para quienes nunca dejan de aprender.</p>
            </div>
          </div>
          <div class="club-moments" aria-label="Momentos de nuestro club">
            <figure class="club-moment moment-play" data-reveal>
              <ClubPhoto name="concentracion" alt="Una jugadora de Belén concentrada en la posición de las piezas durante una partida." sizes="(min-width: 1500px) 400px, (min-width: 800px) 28vw, (min-width: 480px) 44vw, 90vw" />
              <figcaption><span>01 / En el tablero</span><strong>Cada jugada, un nuevo reto.</strong></figcaption>
            </figure>
            <figure class="club-moment moment-achievement" data-reveal style="--d: 1">
              <ClubPhoto name="alegria" alt="Una atleta de Belén sonríe mientras muestra sus medallas." sizes="(min-width: 1500px) 400px, (min-width: 800px) 28vw, (min-width: 480px) 44vw, 90vw" />
              <figcaption><span>02 / La alegría</span><strong>El esfuerzo también se celebra.</strong></figcaption>
            </figure>
            <figure class="club-moment moment-friends" data-reveal style="--d: 2">
              <ClubPhoto name="amistad" alt="Cuatro compañeros de Ajedrez Belén sonríen abrazados al aire libre." sizes="(min-width: 1500px) 500px, (min-width: 800px) 34vw, 90vw" />
              <figcaption><span>03 / Más allá de la partida</span><strong>Lo mejor es compartirlo.</strong></figcaption>
              <p>La concentración frente al tablero. La alegría de superarse. Los amigos que quedan después de la partida.</p>
            </figure>
          </div>
          {a.heroPhoto && <figure class="association-photo"><HeroBoard photo={a.heroPhoto} photoDescription={a.heroPhotoDescription} /></figure>}
          <ol class="principles">
            {principles.map((p, i) => (
              <li data-reveal style={`--d: ${i}`}><h3><span>{String(i + 1).padStart(2, '0')}</span>{p.title}</h3><p>{p.body}</p><ChessPiece id={p.symbol} class="principle-glyph" /></li>
            ))}
          </ol>
          <ClubPurpose />
        </div>
      </section>

      <section id="preguntas" class="faq" aria-labelledby="faq-heading">
        <div class="frame faq-grid">
          <div class="faq-head">
            <p class="kicker" data-reveal><span class="kicker-num">05</span>Preguntas frecuentes</p>
            <h2 id="faq-heading" class="section-title" data-reveal>Antes de <em>mover,</em><br />pregunta.</h2>
            <p data-reveal>¿Tu duda no está aquí? Escríbenos y te respondemos con gusto.</p>
            <a class="text-link" href={wa('Hola, Ajedrez Belén. Tengo una pregunta sobre las clases.')} target="_blank" rel="noopener noreferrer">Preguntar por WhatsApp <svg class="icon icon-out" aria-hidden="true"><use href="#icon-out" /></svg></a>
          </div>
          <div class="faq-list">
            {faqs.map((f) => <details><summary>{f.q} <span class="plus" aria-hidden="true"></span></summary><p>{f.a}</p></details>)}
            <details><summary>¿Cómo se paga la mensualidad? <span class="plus" aria-hidden="true"></span></summary><p>El pago se realiza dentro de los primeros 8 días de cada mes. Al hacerlo, identifica al atleta con su nombre y apellido. Las familias inscritas registran la transferencia en el <a href="/portal">Portal de pagos</a> y reciben su comprobante tras la verificación. Si tienes dudas, te ayudamos por WhatsApp.</p></details>
          </div>
        </div>
      </section>

      <section id="consultas" class="finale" aria-labelledby="contact-heading">
        <div class="frame">
          <p class="finale-top"><span>Nos vemos en el tablero</span><span class="finale-stars" aria-hidden="true">{[0, 1, 2].map(() => <svg><use href="#icon-star" /></svg>)}</span></p>
          <h2 id="contact-heading" class="finale-title" data-reveal>¿Jugamos?</h2>
          <div class="finale-grid">
            <div data-reveal>
              <p class="finale-lede">Tu primera clase es gratuita. Conoce al grupo, prueba la dinámica y decide si quieres continuar. Coordinemos tu visita por WhatsApp.</p>
              <a class="button button-paper" href={contactUrl} target="_blank" rel="noopener noreferrer">Coordinar mi clase gratis <span class="button-badge"><svg class="icon icon-fill" aria-hidden="true"><use href="#icon-wa" /></svg></span><span class="visually-hidden"> (WhatsApp)</span></a>
            </div>
            <div class="steps" data-reveal style="--d: 1">
              <h3>De la primera duda a la primera jugada</h3>
              <ol>
                {steps.map((s, i) => <li><span class="step-num" aria-hidden="true">{i + 1}</span><h4>{s.title}</h4><p>{s.body}</p></li>)}
              </ol>
            </div>
          </div>
          <div id="ubicacion" class="practical">
            <p><svg class="icon" aria-hidden="true"><use href="#icon-pin" /></svg>{a.venue}</p>
            <p>{a.schedule}</p>
            <a href={'mailto:' + a.email}>{a.email}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="frame">
        <div class="footer-top">
          <a class="footer-brand" href="#inicio"><img {...crest} alt="" width="40" height="44" loading="lazy" /><span>Ajedrez Belén<span>El juego sigue.</span></span></a>
          <div class="footer-links"><a href="https://ajedrezbelen.com/privacy/">Política de privacidad</a><a href="/terminos/">Términos</a><a href="/app/">La aplicación</a><a href="/portal">Portal de pagos</a><a href="https://www.facebook.com/ajedrezbelen" target="_blank" rel="noopener noreferrer">Facebook <svg class="icon" aria-hidden="true"><use href="#icon-out" /></svg></a></div>
        </div>
        <div class="footer-bottom">
          <p class="footer-app">La aplicación Ajedrez Belén sirve para que las familias inscriban atletas, consulten la mensualidad, registren el pago de las clases y vean los eventos. Si conectas Google, la aplicación pide solo tu nombre y tu correo verificado, para reconocerte y enviarte el comprobante.</p>
          <p class="footer-note">Belén, Heredia · Hecho entre partidas</p>
        </div>
      </div>
    </footer>
    <a class="mobile-cta" data-mobile-cta href={contactUrl} target="_blank" rel="noopener noreferrer"><span>Probar una clase gratis</span><span class="button-badge"><svg class="icon icon-fill" aria-hidden="true"><use href="#icon-wa" /></svg></span><span class="visually-hidden"> (WhatsApp)</span></a>
    <script>
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      // Enhance only after the reveal observer is ready; content stays visible if scripts fail.
      document.documentElement.classList.add('js');

      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) new ResizeObserver(() => {
        document.documentElement.style.setProperty('--header-offset', `${header.getBoundingClientRect().height}px`);
      }).observe(header);
      // The cover's height on tall screens depends on the Índice strip below it.
      const contents = document.querySelector<HTMLElement>('.contents');
      if (contents) new ResizeObserver(() => {
        document.documentElement.style.setProperty('--contents-h', `${contents.getBoundingClientRect().height}px`);
      }).observe(contents);

      // The phone bar keeps a WhatsApp invitation in view. It yields to the hero button and the closing section,
      // which carry their own, and to the opera story, where the pinned board already takes the top of the screen.
      const cta = document.querySelector('[data-mobile-cta]');
      const yieldTo = new Map<Element, boolean>();
      const ctaObserver = new IntersectionObserver((entries) => {
        entries.forEach((e) => yieldTo.set(e.target, e.isIntersecting));
        cta?.classList.toggle('is-on', ![...yieldTo.values()].some(Boolean));
      });
      document.querySelectorAll('.cover-actions .button, .opera, .finale').forEach((el) => ctaObserver.observe(el));

      // Mark the section being read in the header navigation.
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]')];
      // The cover and the closing section have no link; reaching them clears the mark.
      const sections = [...document.querySelectorAll('#inicio, #consultas'), ...navLinks.map((a) => document.querySelector(a.hash))].filter(Boolean) as Element[];
      const spy = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          navLinks.forEach((a) => {
            const on = a.hash === '#' + e.target.id;
            a.classList.toggle('is-current', on);
            if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
          });
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      sections.forEach((el) => spy.observe(el));

      let ticking = false;
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { header?.classList.toggle('is-scrolled', scrollY > 8); ticking = false; });
      }, { passive: true });
    </script>
  </body>
</html>
