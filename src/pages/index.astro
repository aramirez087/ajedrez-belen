---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import KnightScene from '../components/KnightScene.astro';
import HeroBoard from '../components/HeroBoard.astro';
import PuzzleBoard from '../components/PuzzleBoard.astro';
import OperaGame from '../components/OperaGame.astro';
import { association as a } from '../data/association';

const waBase = 'https://wa.me/' + a.whatsapp?.replace(/\D/g, '');
const wa = (msg: string) => `${waBase}?text=${encodeURIComponent(msg)}`;
const contactUrl = wa('Hola, Ajedrez Belén. Quiero información sobre las clases de ajedrez.');

const classes = [
  { index: '01', name: 'Iniciación', invitation: 'Tu primera jugada', description: 'Conocer las piezas, descubrir el tablero y disfrutar de las primeras partidas.', fee: a.fees[0].amount, piece: 'pawn', glyph: '♟' },
  { index: '02', name: 'Cadetes e intermedios', invitation: 'Encuentra tu juego', description: 'Reconocer ideas, practicar y tomar decisiones con más confianza.', fee: a.fees[1].amount, piece: 'rook', glyph: '♜' },
  { index: '03', name: 'Avanzados', invitation: 'Piensa un paso más allá', description: 'Profundizar en la estrategia y seguir afinando cada partida.', fee: a.fees[1].amount, piece: 'queen', glyph: '♛' },
];
const notation = ['1. e4 e5', '2. Cf3 Cc6', '3. Ab5 a6', '4. O-O Cf6', '5. Te1 Ae7', '6. c3 O-O', '7. d4 exd4', '8. cxd4 d5', '…tu turno', 'Jaque mate'];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: a.name,
  sport: 'Chess',
  description: 'Club y clases de ajedrez en Belén, Heredia, Costa Rica. Niveles de iniciación, cadetes, intermedios y avanzados.',
  address: { '@type': 'PostalAddress', addressLocality: 'Belén', addressRegion: 'Heredia', addressCountry: 'CR' },
  sameAs: ['https://www.facebook.com/ajedrezbelen'],
};
---
<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Ajedrez Belén. Un espacio en Belén, Heredia, para aprender ajedrez, seguir mejorando y compartir cada partida. Clases desde ₡12.000 al mes." />
    <meta name="theme-color" content="#f7f4ec" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content="Ajedrez Belén | Un tablero. Un mundo por descubrir." />
    <meta property="og:description" content="Clases de ajedrez en Belén, Heredia. Tres niveles, desde tu primera jugada hasta pensar un paso más allá. Desde ₡12.000 al mes." />
    <meta property="og:image" content="/media/knight-staunton-v4.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Ajedrez Belén | Un tablero. Un mundo por descubrir.</title>
    <link rel="icon" href="/media/favicon.png" type="image/png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={a.heroKnight} as="image" type="image/webp" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" data-header>
      <div class="frame header-inner">
        <a href="#inicio" class="brand" aria-label="Ajedrez Belén, inicio">
          <img src={a.crest ?? '/media/crest-provisional.webp'} alt="" width="46" height="50" />
          <span>Ajedrez<br />Belén<span class="brand-caption">Un juego. Una comunidad.</span></span>
        </a>
        <nav aria-label="Navegación principal">
          <a class="nav-club" href="#asociacion">El club</a>
          <a class="nav-game" href="#partida">La partida</a>
          <a href="#reto">El reto</a>
          <a href="#niveles">Las clases</a>
          <a class="nav-fees" href="#preguntas">Preguntas</a>
        </nav>
        <a href={contactUrl} target="_blank" rel="noopener noreferrer" class="nav-contact">Hablemos <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a>
      </div>
    </header>
    <div class="scroll-rail" data-rail aria-hidden="true">
      <span class="rail-coord" data-rail-coord>e2</span>
      <span class="rail-track"><span class="rail-fill" data-rail-fill></span><span class="rail-pawn" data-rail-pawn>♟</span></span>
      <span class="rail-coord rail-coord-end">e8</span>
    </div>
    <main id="contenido" tabindex="-1">
      <section id="inicio" class="hero frame" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="hero-place" data-hero="1"><span class="checker-mark" aria-hidden="true"></span>Belén, Heredia · Costa Rica</p>
          <h1 id="hero-heading" data-hero="2">
            <span>Un tablero.</span>
            <span>Un mundo</span>
            <em>por descubrir.</em>
          </h1>
          <p class="hero-description" data-hero="3">Un espacio para aprender ajedrez, compartir cada partida y descubrir hasta dónde puedes llegar.</p>
          <div class="hero-actions" data-hero="4">
            <a class="button" href={contactUrl} target="_blank" rel="noopener noreferrer">Quiero aprender <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h14M11 4l6 6-6 6" /></svg></a>
            <a class="text-link" href="#reto">Primero, un reto <span aria-hidden="true">↓</span></a>
          </div>
          <dl class="hero-facts" data-hero="5">
            <div><dt>Desde</dt><dd>₡<span data-count="12000">12.000</span><em> / mes</em></dd></div>
            <div><dt>Niveles</dt><dd><span data-count="3">3</span><em> para cada paso</em></dd></div>
            <div><dt>Hermanos</dt><dd><span data-count="25">25</span>%<em> de descuento</em></dd></div>
          </dl>
        </div>
        <KnightScene src={a.heroKnight} />
        <div class="hero-bottom" aria-hidden="true"><span>Un juego que nos reúne.</span><span>Descubre tu próxima jugada <span class="down-arrow">↓</span></span></div>
      </section>

      <div class="notation-band" aria-hidden="true">
        <div class="notation-track">
          {[0, 1].map(() => (
            <span class="notation-run">{notation.map((n) => <span class="notation-move">{n}<i>♟</i></span>)}</span>
          ))}
        </div>
      </div>

      <section id="asociacion" class="introduction frame" aria-labelledby="intro-heading">
        <p class="section-index" data-reveal><span>01</span> El club</p>
        <div class="intro-main">
          <h2 id="intro-heading" data-reveal>Aprender a jugar.<br /><em>Encontrar con quién.</em></h2>
          <div class="intro-copy" data-reveal>
            <p>El ajedrez empieza con dos personas y un tablero. En Belén, es también una forma de encontrarnos, aprender juntos y disfrutar del camino.</p>
            <p class="intro-footnote">Para quienes empiezan.<br />Para quienes nunca dejan de aprender.</p>
          </div>
          <figure class="intro-photo" data-reveal>
            <img src="/media/chess-staunton-v2.webp" alt="Tablero de ajedrez verde con piezas de madera en plena partida." width="1200" height="800" loading="lazy" decoding="async" />
            <figcaption><span>Cada partida cuenta una historia distinta.</span><span class="checker-mark" aria-hidden="true"></span></figcaption>
          </figure>
          {a.heroPhoto && <figure class="association-photo"><HeroBoard photo={a.heroPhoto} photoDescription={a.heroPhotoDescription} /></figure>}
        </div>
        <ol class="principles">
          <li data-reveal><span class="principle-num">01</span><div><h3>Jugar</h3><p>Partidas desde el primer día. Se aprende jugando, no mirando.</p></div><span class="principle-glyph" aria-hidden="true">♞</span></li>
          <li data-reveal><span class="principle-num">02</span><div><h3>Pensar</h3><p>Ideas, planes y decisiones. Cada jugada entrena la cabeza.</p></div><span class="principle-glyph" aria-hidden="true">♝</span></li>
          <li data-reveal><span class="principle-num">03</span><div><h3>Compartir</h3><p>Un rival al frente y un amigo al lado. El tablero nos reúne.</p></div><span class="principle-glyph" aria-hidden="true">♜</span></li>
        </ol>
      </section>

      <section id="partida" class="game" aria-labelledby="game-heading">
        <div class="frame">
          <p class="section-index" data-reveal><span>02</span> La partida</p>
          <div class="game-heading" data-reveal>
            <h2 id="game-heading">París, 1858.<br /><em>Una obra maestra</em> en 17 jugadas.</h2>
            <p>Paul Morphy, de 21 años, jugó esta partida en un palco de la ópera contra dos aristócratas que consultaban cada movimiento. Sigue bajando: el tablero la reproduce para ti, jugada a jugada.</p>
          </div>
          <OperaGame />
          <p class="game-source" data-reveal>Morphy vs. Duque Karl de Brunswick y Conde Isouard · Ópera de París, 1858 · Defensa Philidor — conocida como «la partida de la ópera».</p>
        </div>
      </section>

      <section id="reto" class="challenge" aria-labelledby="challenge-heading">
        <div class="frame challenge-grid">
          <div class="challenge-copy">
            <p class="section-index section-index-light" data-reveal><span>03</span> El reto</p>
            <h2 id="challenge-heading" data-reveal>¿Puedes dar<br /><em>jaque mate</em><br />en una jugada?</h2>
            <p data-reveal>Así empieza todo en el club: con una posición, una idea y las ganas de encontrarla. Juegan las blancas. Una sola jugada y la partida se acaba.</p>
            <div class="puzzle-win" data-puzzle-win data-reveal>
              <p>Esa es la sensación. Ahora imagínala cada semana.</p>
              <a class="button" href={wa('Hola, Ajedrez Belén. Resolví el reto de la página y quiero información sobre las clases.')} target="_blank" rel="noopener noreferrer">Quiero jugar en serio <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h14M11 4l6 6-6 6" /></svg></a>
            </div>
          </div>
          <div data-reveal><PuzzleBoard /></div>
        </div>
      </section>

      <section id="niveles" class="programme" aria-labelledby="levels-heading">
        <span class="giant-word" data-giant aria-hidden="true">Ajedrez Belén · Ajedrez Belén ·</span>
        <div class="frame">
          <p class="section-index" data-reveal><span>04</span> Las clases</p>
          <div class="programme-heading" data-reveal>
            <h2 id="levels-heading">Cada nivel,<br /><em>un nuevo horizonte.</em></h2>
            <p>Tu primera partida o tu próximo reto.<br />Encuentra tu lugar en el tablero.</p>
          </div>
          <table id="mensualidades" class="programme-table" role="table">
            <caption class="visually-hidden">Clases de ajedrez y mensualidades</caption>
            <thead role="rowgroup"><tr role="row"><th id="level-column" scope="col" role="columnheader">Tu punto de partida</th><th id="description-column" scope="col" role="columnheader">Lo que exploramos</th><th id="fee-column" scope="col" role="columnheader">Mensualidad</th></tr></thead>
            <tbody role="rowgroup">
              {classes.map(c => (
                <tr class="class-row" role="row" data-reveal>
                  <th id={'level-' + c.piece} scope="row" role="rowheader"><div class="class-identity">
                    <span class="class-index" aria-hidden="true">{c.index}</span>
                    <span class="piece-icon" aria-hidden="true">{c.glyph}</span>
                    <span><span class="class-invitation">{c.invitation}</span><span class="class-name">{c.name}</span></span>
                  </div></th>
                  <td class="class-description" role="cell" headers={'level-' + c.piece + ' description-column'}>{c.description}</td>
                  <td class="class-price" role="cell" headers={'level-' + c.piece + ' fee-column'}>
                    <span class="price-amount"><span class="price-currency">₡</span>{c.fee.slice(1)}</span>
                    <span class="price-period">por mes</span>
                    <a class="class-cta" href={wa(`Hola, Ajedrez Belén. Quiero información sobre el nivel ${c.name}.`)} target="_blank" rel="noopener noreferrer" aria-label={`Empezar en ${c.name} por WhatsApp`}>Empezar aquí <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="programme-help"><span>¿No sabes por dónde empezar?</span><a class="text-link" href={wa('Hola, Ajedrez Belén. No sé qué nivel me conviene, ¿me ayudan a encontrarlo?')} target="_blank" rel="noopener noreferrer">Te ayudamos a encontrar tu nivel <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a></div>
          <div class="programme-notes">
            <div class="family-note" data-reveal><span class="discount">25<span>%</span></span><div><p class="family-label">Descuento entre hermanos</p><h3>Una pasión que se comparte.</h3><p>Si inscribes a dos o más hermanos, el descuento se aplica automáticamente en la mensualidad.</p></div><a class="family-cta" href={wa('Hola, Ajedrez Belén. Quiero consultar por el descuento entre hermanos.')} target="_blank" rel="noopener noreferrer">Consultar <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a><span class="checker-mark checker-big" aria-hidden="true"></span></div>
            <details><summary>Sobre el pago mensual <span aria-hidden="true">+</span></summary><p>El pago se realiza dentro de los primeros 8 días del mes. Al realizarlo, identifica al atleta con su nombre y apellido. Las familias inscritas registran la transferencia en el <a href="/portal">Portal de pagos</a> y reciben su comprobante tras la verificación.</p></details>
          </div>
        </div>
      </section>

      <section class="steps frame" aria-labelledby="steps-heading">
        <p class="section-index" data-reveal><span>05</span> Cómo empezar</p>
        <h2 id="steps-heading" class="steps-heading" data-reveal>De la primera duda<br />a la <em>primera jugada.</em></h2>
        <ol class="steps-list">
          <li data-reveal><span class="step-num" aria-hidden="true">1</span><h3>Escríbenos</h3><p>Un mensaje por WhatsApp basta. Cuéntanos quién quiere aprender y te respondemos con los detalles.</p></li>
          <li data-reveal><span class="step-num" aria-hidden="true">2</span><h3>Encuentra tu nivel</h3><p>¿Primera vez frente al tablero o ya juegas? Te ubicamos en el grupo donde más vas a crecer.</p></li>
          <li data-reveal><span class="step-num" aria-hidden="true">3</span><h3>Siéntate a jugar</h3><p>Conoce la sede y los horarios, llega con ganas y mueve tu primera pieza. El resto es historia.</p></li>
        </ol>
      </section>

      <section id="preguntas" class="faq frame" aria-labelledby="faq-heading">
        <p class="section-index" data-reveal><span>06</span> Preguntas frecuentes</p>
        <h2 id="faq-heading" class="faq-heading" data-reveal>Antes de <em>mover,</em> pregunta.</h2>
        <div class="faq-grid">
          <details data-reveal><summary>¿Necesito saber jugar para empezar? <span aria-hidden="true">+</span></summary><p>No. El nivel de Iniciación está hecho para dar los primeros pasos: conocer las piezas, el tablero y disfrutar las primeras partidas desde cero.</p></details>
          <details data-reveal><summary>¿Cuánto cuesta la mensualidad? <span aria-hidden="true">+</span></summary><p>Iniciación cuesta ₡12.000 al mes y los niveles de cadetes, intermedios y avanzados ₡15.000 al mes. Entre hermanos hay un 25 % de descuento, aplicado automáticamente desde el segundo atleta de la familia.</p></details>
          <details data-reveal><summary>¿Dónde y cuándo son las clases? <span aria-hidden="true">+</span></summary><p>Estamos en Belén, Heredia. Escríbenos por WhatsApp y te compartimos la sede y los horarios vigentes de cada nivel.</p></details>
          <details data-reveal><summary>¿Cómo se paga la mensualidad? <span aria-hidden="true">+</span></summary><p>El pago se realiza dentro de los primeros 8 días de cada mes. Al hacerlo, identifica al atleta con su nombre y apellido. Las familias inscritas registran la transferencia en el <a href="/portal">Portal de pagos</a> y reciben su comprobante tras la verificación. Si tienes dudas, te ayudamos por WhatsApp.</p></details>
        </div>
      </section>

      <section id="consultas" class="contact" aria-labelledby="contact-heading">
        <div class="frame">
          <div class="contact-top"><p>Nos vemos en el tablero</p><span class="checker-mark" aria-hidden="true"></span></div>
          <div class="contact-main">
            <h2 id="contact-heading" data-reveal>¿Jugamos?</h2>
            <div class="contact-action" data-reveal><p>La mejor jugada es empezar. Hay un lugar para ti en el tablero: hablemos de cómo dar el primer paso.</p><a class="button button-light" href={contactUrl} target="_blank" rel="noopener noreferrer">Conversemos por WhatsApp <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a></div>
          </div>
          <div id="ubicacion" class="practical-info"><p><span class="location-dot" aria-hidden="true"></span>Belén, Heredia · Costa Rica</p><p>Escríbenos para conocer la sede y los horarios de las clases.</p></div>
        </div>
      </section>
    </main>
    <footer class="frame">
      <a class="footer-brand" href="#inicio">Ajedrez Belén<span>El juego sigue.</span></a>
      <p class="footer-note">Belén, Heredia · Hecho entre partidas</p>
      <div class="footer-links"><a href="/portal">Portal de pagos</a><a href="https://www.facebook.com/ajedrezbelen" target="_blank" rel="noopener noreferrer">Facebook <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a><a href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a></div>
    </footer>
    <a class="mobile-cta" data-mobile-cta href={contactUrl} target="_blank" rel="noopener noreferrer"><span>Quiero aprender ajedrez</span><span class="mobile-cta-price">desde ₡12.000/mes →</span></a>
    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
      document.documentElement.classList.add('is-loaded');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      const header = document.querySelector('[data-header]');
      const cta = document.querySelector('[data-mobile-cta]');
      const contact = document.querySelector('.contact');
      let contactVisible = false;
      if (contact) new IntersectionObserver(([e]) => { contactVisible = e.isIntersecting; }, { threshold: 0.2 }).observe(contact);

      /* Scroll coordinate rail: the page is the e-file, e2 → e8 (coronación). */
      const railFill = document.querySelector<HTMLElement>('[data-rail-fill]');
      const railPawn = document.querySelector<HTMLElement>('[data-rail-pawn]');
      const railCoord = document.querySelector<HTMLElement>('[data-rail-coord]');
      const giant = document.querySelector<HTMLElement>('[data-giant]');
      let ticking = false;
      const onScroll = () => {
        header?.classList.toggle('is-scrolled', scrollY > 24);
        cta?.classList.toggle('is-on', scrollY > 560 && !contactVisible);
        const max = document.documentElement.scrollHeight - innerHeight;
        const p = max > 0 ? Math.min(scrollY / max, 1) : 0;
        if (railFill) railFill.style.transform = `scaleY(${p})`;
        if (railPawn) railPawn.style.top = `${p * 100}%`;
        if (railCoord) railCoord.textContent = 'e' + Math.min(2 + Math.floor(p * 6.999), 8);
        if (!reduce) {
          if (giant) {
            const r = giant.parentElement?.getBoundingClientRect();
            if (r && r.top < innerHeight && r.bottom > 0) {
              const gp = (innerHeight - r.top) / (innerHeight + r.height);
              giant.style.transform = `translateX(${-gp * 16}%)`;
            }
          }
        }
        ticking = false;
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
      onScroll();

      /* Animated counters in the hero facts. */
      const fmt = { format: (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.') };
      const cio = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          cio.unobserve(e.target);
          const el = e.target as HTMLElement;
          const target = Number(el.dataset.count ?? 0);
          if (reduce || target <= 3) { el.textContent = fmt.format(target); return; }
          const t0 = performance.now(), dur = 1100;
          const tick = (t: number) => {
            const k = Math.min((t - t0) / dur, 1);
            el.textContent = fmt.format(Math.round(target * (1 - Math.pow(1 - k, 3))));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.4 });
      document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

      /* Knight scene: 3D cursor tilt with layered depth. */
      const scene = document.querySelector<HTMLElement>('[data-knight-scene]');
      const tiltEl = document.querySelector<HTMLElement>('[data-tilt]');
      if (scene && tiltEl && finePointer && !reduce) {
        const layers = [...tiltEl.querySelectorAll<HTMLElement>('[data-depth]')];
        let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
        const render = () => {
          cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08;
          tiltEl.style.transform = `rotateX(${(-cy * 5).toFixed(2)}deg) rotateY(${(cx * 7).toFixed(2)}deg)`;
          layers.forEach((l) => {
            const d = Number(l.dataset.depth ?? 0);
            l.style.translate = `${(-cx * d).toFixed(1)}px ${(-cy * d * 0.7).toFixed(1)}px`;
          });
          if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(render);
          else raf = 0;
        };
        scene.addEventListener('pointermove', (e) => {
          const r = scene.getBoundingClientRect();
          tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
          ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
          scene.style.setProperty('--glare-x', `${((e.clientX - r.left) / r.width) * 100}%`);
          scene.style.setProperty('--glare-y', `${((e.clientY - r.top) / r.height) * 100}%`);
          if (!raf) raf = requestAnimationFrame(render);
        });
        scene.addEventListener('pointerleave', () => { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(render); });
      }

      /* Magnetic calls to action. */
      if (finePointer && !reduce) {
        document.querySelectorAll<HTMLElement>('.button').forEach((btn) => {
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            btn.style.translate = `${x * 7}px ${y * 7 - 2}px`;
          });
          btn.addEventListener('pointerleave', () => { btn.style.translate = ''; });
        });
      }
    </script>
  </body>
