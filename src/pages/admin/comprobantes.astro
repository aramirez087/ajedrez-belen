---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import ExportLinks from '../../components/portal/ExportLinks.astro';
import { money, dateLabel, emailLabels } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { listReceipts } from '../../lib/portal/domain';
import { listEmailOutbox } from '../../lib/portal/email';
import { minorAmount } from '../../lib/portal/allocation-validation';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const stagingTest = env.STAGING_PORTAL_TEST === 'true';
const [receipts,outbox] = await Promise.all([listReceipts(env.DB,actor),listEmailOutbox(env.DB,actor)]);
const statuses: Record<string,string> = {...emailLabels,queued:'Por enviar',cancelled:'Cancelado',unknown:'Entrega por confirmar'};
const retryAllowed = (item: typeof outbox[number]) => item.nextAttemptAt <= new Date().toISOString() &&
  (item.status === 'dry_run' || (item.status === 'blocked' && ['missing_configuration','invalid_configuration'].includes(item.lastErrorCode ?? '')) || (item.status === 'rejected' && ['provider_auth','provider_limit'].includes(item.lastErrorCode ?? '')));
const heldCount = receipts.filter(receipt => receipt.emailStatus === 'recipient_pending').length;
const queuedCount = outbox.filter(item => item.status === 'queued').length;
const outboxAnchors = new Set(outbox.map(item => `${item.receiptNumber}-${item.kind}`));
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const normalizeSearch = (value: string) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLocaleLowerCase('es');
const query = normalizeSearch(q);
const amountQuery = minorAmount(q);
const rawStatus = Astro.url.searchParams.get('estado') ?? 'todos';
const estado = ['todos', 'emitidos', 'anulados', 'retenidos'].includes(rawStatus) ? rawStatus : 'todos';
const receiptsFiltered = receipts.filter(receipt =>
  (estado === 'todos' || (estado === 'emitidos' && receipt.status !== 'void') || (estado === 'anulados' && receipt.status === 'void') || (estado === 'retenidos' && receipt.emailStatus === 'recipient_pending')) &&
  (!q || normalizeSearch(receipt.number).includes(query) || normalizeSearch(receipt.snapshot.payerName).includes(query) || (amountQuery !== null && receipt.snapshot.amountMinor === amountQuery)));
const PAGE_SIZE = 50;
const pages = Math.max(1, Math.ceil(receiptsFiltered.length / PAGE_SIZE));
const requestedPage = Number(Astro.url.searchParams.get('pagina'));
const page = Number.isFinite(requestedPage) ? Math.min(pages, Math.max(1, Math.floor(requestedPage))) : 1;
const receiptsPage = receiptsFiltered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const pageHref = (target: number) => `/admin/comprobantes?q=${encodeURIComponent(q)}&estado=${encodeURIComponent(estado)}&pagina=${target}#comprobantes`;
---
<PortalLayout title="Comprobantes y correos" actor={actor} active="receipts">
  <PageHeader title="Comprobantes y estado del correo." eyebrow="Documentos y correo" description="Cada comprobante conserva los datos del pago confirmado. El correo se dirige a quien registró el pago desde su cuenta familiar o, en un registro asistido, a la persona adulta seleccionada por administración. Los documentos siguen disponibles en el portal cuando el correo está pendiente.">{!stagingTest && <form action="/api/admin/email" method="post" data-confirm="¿Procesar el lote de correos pendientes? Se intentará el envío a cada destinatario preparado, hasta 5 correos por vez."><input type="hidden" name="action" value="send_batch" /><button class="portal-button" type="submit" disabled={queuedCount === 0}>Procesar correos pendientes{queuedCount > 0 && ` (${queuedCount})`} <span aria-hidden="true">→</span></button>{queuedCount === 0 && <p class="portal-help">No hay correos en cola por enviar.</p>}{queuedCount > 5 && <p class="portal-help">Se procesan hasta 5 por vez; repite hasta vaciar la cola.</p>}</form>}</PageHeader>
  {!stagingTest && <section class="portal-next-step" aria-labelledby="receipts-next-title"><h2 id="receipts-next-title">¿Qué hago ahora?</h2>{heldCount > 0 ? <><p>Hay <strong>{heldCount} {heldCount === 1 ? 'comprobante' : 'comprobantes'} con el correo detenido</strong> porque la cuenta destinataria necesita revisión. El comprobante sigue disponible en el portal; nadie pierde nada. Revisa esa cuenta en <a class="portal-link" href="/admin/familias">Familias</a> y después usa «Preparar correo» en la tabla de abajo.</p>{queuedCount > 0 && <p>Además tienes <strong>{queuedCount} {queuedCount === 1 ? 'correo listo' : 'correos listos'}</strong> para enviar con <strong>«Procesar correos pendientes»</strong> arriba (hasta 5 por vez).</p>}</> : queuedCount > 0 ? <p>Tienes <strong>{queuedCount} {queuedCount === 1 ? 'correo listo' : 'correos listos'}</strong> para enviar. Cuando quieras, toca <strong>«Procesar correos pendientes»</strong> arriba (hasta 5 por vez); el estado de cada uno se actualiza en <a class="portal-link" href="#correos">la lista de correos</a>.</p> : <p>Nada detenido y nada en cola. Al confirmar un pago, su comprobante se emite y el correo se intenta enviar en el momento; desde aquí procesas lo que quede en cola o necesite un reintento.</p>}</section>}
  {stagingTest ? <div class="portal-guidance"><h3>Correo simulado · sin envíos</h3><p>En esta prueba no se envían correos ni se habilitan acciones de envío. Los comprobantes ficticios siguen disponibles en el portal.</p></div> : env.EMAIL_MODE !== 'live' && <div class="portal-guidance"><h3>Correo en modo simulado</h3><p>Los comprobantes se preparan y el envío se registra como simulado. Brevo y el remitente ya están configurados; la entrega real permanece desactivada hasta que la Asociación apruebe activarla. Mientras tanto, los comprobantes quedan disponibles en el portal.</p></div>}
  <details class="portal-guidance portal-guidance-details"><summary>Cómo se elige el destinatario de cada correo <span aria-hidden="true">+</span></summary><p>Cada comprobante tiene un solo destinatario: la cuenta familiar que registró originalmente el pago o, si lo registró administración, la persona adulta responsable seleccionada. Se usa el correo verificado de esa cuenta. Si faltan datos válidos o la cuenta no cumple los requisitos de acceso, el correo se retiene; el comprobante y el saldo se conservan.</p>{!stagingTest && <p>Después de corregir los datos y permisos de una cuenta destinataria, usa <strong>Preparar correo</strong> en su comprobante. Esta acción vuelve a comprobar la cuenta y prepara el primer correo, sin enviarlo. Después, revisa el destinatario en la lista y usa <strong>Procesar correos pendientes</strong> cuando corresponda. Corregir la cuenta por sí solo no inicia ningún envío.</p>}<p>Las respuestas a este correo no se atienden. Las consultas se atienden por <a class="portal-link" href="https://wa.me/50687686102">WhatsApp <span aria-hidden="true">↗</span></a>.</p></details>
  <section class="portal-section" id="comprobantes"><div class="portal-section-heading"><h2>Comprobantes emitidos</h2><ExportLinks kind="receipts" label="comprobantes" /></div><form class="portal-month-form" action="/admin/comprobantes#comprobantes" method="get" role="search" aria-label="Buscar comprobantes"><div class="portal-field"><label for="q">Buscar por número, nombre o monto</label><input id="q" name="q" type="search" value={q} placeholder="AB-2026, María, 15000…" autocomplete="off" /></div><div class="portal-field"><label for="estado">Estado</label><select id="estado" name="estado"><option value="todos" selected={estado === 'todos'}>Todos</option><option value="emitidos" selected={estado === 'emitidos'}>Emitidos</option><option value="anulados" selected={estado === 'anulados'}>Anulados</option><option value="retenidos" selected={estado === 'retenidos'}>Correo retenido</option></select></div><button class="portal-button portal-button-secondary" type="submit">Buscar <span aria-hidden="true">→</span></button>{(q || estado !== 'todos') && <a class="portal-link" href="/admin/comprobantes#comprobantes">Limpiar <span aria-hidden="true">↗</span></a>}</form><p class="portal-section-caption">{receiptsFiltered.length} {receiptsFiltered.length === 1 ? 'comprobante' : 'comprobantes'}{pages > 1 && <> · página {page} de {pages}</>}. La búsqueda consulta hasta los 500 comprobantes más recientes. Exporta el historial completo en CSV o JSON.</p>{receiptsPage.length ? <div class="portal-table-wrap" role="region" aria-label="Comprobantes emitidos" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Comprobantes numerados de la Asociación</caption><thead><tr><th scope="col">Comprobante / emisión</th><th scope="col">Pagado por</th><th scope="col" class="portal-num-head">Monto</th><th scope="col">Estado</th><th scope="col">Correo</th><th scope="col">Documento</th></tr></thead><tbody>{receiptsPage.map(receipt => <tr><th scope="row">{receipt.number}<span class="portal-subtext">{dateLabel(receipt.snapshot.issuedAt)}</span></th><td data-label="Pagado por">{receipt.snapshot.payerName}</td><td class="portal-number" data-label="Monto">{money(receipt.snapshot.amountMinor)}</td><td data-label="Estado"><span class:list={['portal-status',receipt.status==='void'?'portal-status-void':'portal-status-approved']}>{receipt.status==='void'?'Anulado':'Emitido'}</span></td><td data-label="Correo"><span class:list={['portal-status',receipt.emailStatus === 'recipient_pending' ? 'portal-status-blocked' : `portal-status-${receipt.emailStatus ?? 'pending'}`]}>{emailLabels[receipt.emailStatus ?? 'pending'] ?? receipt.emailStatus}</span>{receipt.emailStatus !== 'recipient_pending' && outboxAnchors.has(`${receipt.number}-${receipt.status === 'void' ? 'receipt_void' : 'receipt'}`) && <a class="portal-link" href={`#correo-${receipt.number}-${receipt.status === 'void' ? 'receipt_void' : 'receipt'}`} aria-label={`Ver envío del comprobante ${receipt.number}`}>Ver envío <span aria-hidden="true">↓</span></a>}{receipt.emailStatus === 'recipient_pending' && (stagingTest ? <span class="portal-subtext">Correo simulado. La preparación y el envío no están disponibles en esta prueba.</span> : <><span class="portal-subtext">Revisa los datos, la verificación y los permisos de la cuenta destinataria. El comprobante sigue disponible.</span>{receipt.canPrepareEmail ? <form action="/api/admin/email" method="post"><input type="hidden" name="action" value="prepare" /><input type="hidden" name="receiptId" value={receipt.id} /><button class="portal-link portal-text-button" type="submit" aria-label={`Preparar correo del comprobante ${receipt.number}`}>Preparar correo <span aria-hidden="true">→</span></button><p class="portal-help">Comprueba la cuenta y prepara el primer correo; no lo envía.</p></form> : <span class="portal-subtext">{receipt.status === 'void' ? 'El comprobante está anulado. Su documento sigue disponible; no se prepara ni envía otro correo.' : 'Ya existe un historial de correo. Revisa su estado en la lista; no se prepara otro envío ni se cambia su destinatario.'}</span>}</>)}</td><td data-label="Documento"><a class="portal-link" href={`/portal/comprobantes/${receipt.id}`} aria-label={`Abrir documento del comprobante ${receipt.number}`}>Abrir documento <span aria-hidden="true">↗</span></a><a class="portal-link" href={`/admin/pagos/${receipt.paymentId}`} aria-label={`Ver pago del comprobante ${receipt.number}`}>Ver pago <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>{q || estado !== 'todos' ? 'Sin resultados para esos filtros.' : 'Aún no hay comprobantes.'}</h3><p>{q || estado !== 'todos' ? 'Prueba con otro número, nombre, monto o estado.' : 'Se emiten cuando un administrador confirma una transferencia en la cuenta bancaria.'}</p></div></div>}{pages > 1 && <nav class="portal-copy-row" aria-label="Páginas de comprobantes" style="margin-top:18px">{page > 1 && <a class="portal-link" href={pageHref(page - 1)}>← Anterior</a>}<span class="portal-help">Página {page} de {pages}</span>{page < pages && <a class="portal-link" href={pageHref(page + 1)}>Siguiente →</a>}</nav>}</section>
  <section class="portal-section" id="correos"><div class="portal-section-heading"><h2>Estado de los correos</h2><ExportLinks kind="email" label="correos" /></div><p class="portal-section-caption">Hasta 100 envíos. Se muestran primero los que necesitan una acción; exporta el historial completo en CSV o JSON.</p>{outbox.length ? <div class="portal-table-wrap" role="region" aria-label="Estado de los correos y destinatarios" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Envíos de comprobantes y sus resultados</caption><thead><tr><th scope="col">Comprobante</th><th scope="col">Destinatario</th><th scope="col">Estado</th><th scope="col">Acción</th></tr></thead><tbody>{outbox.map(item => <tr id={`correo-${item.receiptNumber}-${item.kind}`}><th scope="row">{item.receiptNumber}<span class="portal-subtext">{item.kind==='receipt_void'?'Aviso de anulación':'Comprobante de pago'}</span><span class="portal-subtext">{item.attempts} intentos</span></th><td data-label="Destinatario">{item.recipientName}<span class="portal-subtext">{item.recipientEmail}</span></td><td data-label="Estado"><span class:list={['portal-status',`portal-status-${item.status}`]}>{statuses[item.status]??item.status}</span>{item.status==='accepted'&&<span class="portal-subtext">Brevo aceptó el envío. Esto no confirma la entrega.</span>}{['unknown','sending'].includes(item.status)&&<span class="portal-subtext">Consulta el registro de Brevo antes de realizar otra acción.</span>}{item.lastErrorCode==='recipient_or_receipt_changed'&&<span class="portal-subtext">El comprobante o la cuenta destinataria cambiaron. Revisa el estado del documento y los datos y permisos del destinatario.</span>}{item.lastErrorCode&&['blocked','rejected'].includes(item.status)&&<span class="portal-subtext">Revisa la configuración o el límite de envío.</span>}{['queued','blocked','rejected'].includes(item.status)&&item.nextAttemptAt>new Date().toISOString()&&<span class="portal-subtext">Próximo intento: {dateLabel(item.nextAttemptAt)}.</span>}</td><td data-label="Acción">{stagingTest ? <span class="portal-help">Simulación; no se envían correos.</span> : retryAllowed(item) ? <form action="/api/admin/email" method="post"><input type="hidden" name="action" value="retry" /><input type="hidden" name="outboxId" value={item.id} /><button class="portal-link portal-text-button" type="submit" aria-label={`Reintentar envío del comprobante ${item.receiptNumber} a ${item.recipientEmail}`}>Reintentar envío <span aria-hidden="true">↗</span></button></form> : <span class="portal-help">{item.status==='queued'?'Se procesa con el lote pendiente.':item.status==='cancelled'?'Conserva su historial. No se prepara otro envío automáticamente.':'Conserva su estado actual.'}</span>}</td></tr>)}</tbody></table></div> : <p class="portal-section-caption">No hay envíos preparados. Los comprobantes cuya cuenta destinataria requiere revisión conservan el correo retenido y se muestran en la tabla anterior.</p>}</section>
  <section class="portal-section"><h2>Archivos temporales</h2><p class="portal-section-caption">Limpia los borradores vencidos que nunca se enviaron como pago. Los originales de pagos registrados y sus versiones anteriores se conservan.</p><form action="/api/admin/slips/cleanup" method="post"><button class="portal-button portal-button-secondary" type="submit">Limpiar borradores vencidos <span aria-hidden="true">→</span></button></form><p class="portal-help">Cada acción revisa hasta 20 borradores, después del vencimiento y el período de espera. Los archivos vinculados a un pago quedan protegidos.</p></section>
</PortalLayout>
