---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import ExportLinks from '../../components/portal/ExportLinks.astro';
import { money, dateLabel, emailLabels } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { listReceipts } from '../../lib/portal/domain';
import { listEmailOutbox } from '../../lib/portal/email';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const stagingTest = env.STAGING_PORTAL_TEST === 'true';
const [receipts,outbox] = await Promise.all([listReceipts(env.DB,actor),listEmailOutbox(env.DB,actor)]);
const statuses: Record<string,string> = {...emailLabels,queued:'Por enviar',cancelled:'Cancelado',unknown:'Entrega por confirmar'};
const retryAllowed = (item: typeof outbox[number]) => item.nextAttemptAt <= new Date().toISOString() &&
  (item.status === 'dry_run' || (item.status === 'blocked' && ['missing_configuration','invalid_configuration'].includes(item.lastErrorCode ?? '')) || (item.status === 'rejected' && ['provider_auth','provider_limit'].includes(item.lastErrorCode ?? '')));
---
<PortalLayout title="Comprobantes y correos" actor={actor} active="receipts">
  <PageHeader title="Comprobantes y estado del correo." eyebrow="Documentos y correo" description="Cada comprobante conserva los datos del pago confirmado. El correo se dirige a quien registró el pago desde su cuenta familiar o, en un registro asistido, a la persona adulta seleccionada por administración. Los documentos siguen disponibles en el portal cuando el correo está pendiente.">{!stagingTest && <form action="/api/admin/email" method="post" data-confirm="¿Procesar el lote de correos pendientes? Se intentará el envío a cada destinatario preparado."><input type="hidden" name="action" value="send_batch" /><button class="portal-button" type="submit">Procesar correos pendientes <span aria-hidden="true">→</span></button></form>}</PageHeader>
  {stagingTest ? <div class="portal-guidance"><h3>Correo simulado · sin envíos</h3><p>En esta prueba no se envían correos ni se habilitan acciones de envío. Los comprobantes ficticios siguen disponibles en el portal.</p></div> : env.EMAIL_MODE !== 'live' && <div class="portal-guidance"><h3>Correo en modo simulado</h3><p>Los comprobantes se preparan y el envío se registra como simulado. Brevo y el remitente ya están configurados; la entrega real permanece desactivada hasta que la Asociación apruebe activarla. Mientras tanto, los comprobantes quedan disponibles en el portal.</p></div>}
  <details class="portal-guidance portal-guidance-details"><summary>Cómo se elige el destinatario de cada correo <span aria-hidden="true">+</span></summary><p>Cada comprobante tiene un solo destinatario: la cuenta familiar que registró originalmente el pago o, si lo registró administración, la persona adulta responsable seleccionada. Se usa el correo verificado de esa cuenta. Si faltan datos válidos o la cuenta no cumple los requisitos de acceso, el correo se retiene; el comprobante y el saldo se conservan.</p>{!stagingTest && <p>Después de corregir los datos y permisos de una cuenta destinataria, usa <strong>Preparar correo</strong> en su comprobante. Esta acción vuelve a comprobar la cuenta y prepara el primer correo, sin enviarlo. Después, revisa el destinatario en la lista y usa <strong>Procesar correos pendientes</strong> cuando corresponda. Corregir la cuenta por sí solo no inicia ningún envío.</p>}<p>Las respuestas a este correo no se atienden. Las consultas se atienden por <a class="portal-link" href="https://wa.me/50687686102">WhatsApp <span aria-hidden="true">↗</span></a>.</p></details>
  <section class="portal-section"><div class="portal-section-heading"><h2>Comprobantes emitidos</h2><ExportLinks kind="receipts" label="comprobantes" /></div><p class="portal-section-caption">Hasta 500 comprobantes recientes. Exporta el historial completo en CSV o JSON.</p>{receipts.length ? <div class="portal-table-wrap" role="region" aria-label="Comprobantes emitidos" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Comprobantes numerados de la Asociación</caption><thead><tr><th scope="col">Comprobante / emisión</th><th scope="col">Pagado por</th><th scope="col" class="portal-num-head">Monto</th><th scope="col">Estado</th><th scope="col">Correo</th><th scope="col">Documento</th></tr></thead><tbody>{receipts.map(receipt => <tr><th scope="row">{receipt.number}<span class="portal-subtext">{dateLabel(receipt.snapshot.issuedAt)}</span></th><td data-label="Pagado por">{receipt.snapshot.payerName}</td><td class="portal-number" data-label="Monto">{money(receipt.snapshot.amountMinor)}</td><td data-label="Estado"><span class:list={['portal-status',receipt.status==='void'?'portal-status-void':'portal-status-approved']}>{receipt.status==='void'?'Anulado':'Emitido'}</span></td><td data-label="Correo"><span class:list={['portal-status',receipt.emailStatus === 'recipient_pending' ? 'portal-status-blocked' : `portal-status-${receipt.emailStatus ?? 'pending'}`]}>{emailLabels[receipt.emailStatus ?? 'pending'] ?? receipt.emailStatus}</span>{receipt.emailStatus === 'recipient_pending' && (stagingTest ? <span class="portal-subtext">Correo simulado. La preparación y el envío no están disponibles en esta prueba.</span> : <><span class="portal-subtext">Revisa los datos, la verificación y los permisos de la cuenta destinataria. El comprobante sigue disponible.</span>{receipt.canPrepareEmail ? <form action="/api/admin/email" method="post"><input type="hidden" name="action" value="prepare" /><input type="hidden" name="receiptId" value={receipt.id} /><button class="portal-link portal-text-button" type="submit" aria-label={`Preparar correo del comprobante ${receipt.number}`}>Preparar correo <span aria-hidden="true">→</span></button><p class="portal-help">Comprueba la cuenta y prepara el primer correo; no lo envía.</p></form> : <span class="portal-subtext">{receipt.status === 'void' ? 'El comprobante está anulado. Su documento sigue disponible; no se prepara ni envía otro correo.' : 'Ya existe un historial de correo. Revisa su estado en la lista; no se prepara otro envío ni se cambia su destinatario.'}</span>}</>)}</td><td data-label="Documento"><a class="portal-link" href={`/portal/comprobantes/${receipt.id}`} aria-label={`Abrir documento del comprobante ${receipt.number}`}>Abrir documento <span aria-hidden="true">↗</span></a><a class="portal-link" href={`/admin/pagos/${receipt.paymentId}`} aria-label={`Ver pago del comprobante ${receipt.number}`}>Ver pago <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>Aún no hay comprobantes.</h3><p>Se emiten cuando un administrador confirma una transferencia en la cuenta bancaria.</p></div></div>}</section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Estado de los correos</h2><ExportLinks kind="email" label="correos" /></div><p class="portal-section-caption">Hasta 100 envíos. Se muestran primero los que necesitan una acción; exporta el historial completo en CSV o JSON.</p>{outbox.length ? <div class="portal-table-wrap" role="region" aria-label="Estado de los correos y destinatarios" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Envíos de comprobantes y sus resultados</caption><thead><tr><th scope="col">Comprobante</th><th scope="col">Destinatario</th><th scope="col">Estado</th><th scope="col">Acción</th></tr></thead><tbody>{outbox.map(item => <tr><th scope="row">{item.receiptNumber}<span class="portal-subtext">{item.kind==='receipt_void'?'Aviso de anulación':'Comprobante de pago'}</span><span class="portal-subtext">{item.attempts} intentos</span></th><td data-label="Destinatario">{item.recipientName}<span class="portal-subtext">{item.recipientEmail}</span></td><td data-label="Estado"><span class:list={['portal-status',`portal-status-${item.status}`]}>{statuses[item.status]??item.status}</span>{item.status==='accepted'&&<span class="portal-subtext">Brevo aceptó el envío. Esto no confirma la entrega.</span>}{['unknown','sending'].includes(item.status)&&<span class="portal-subtext">Consulta el registro de Brevo antes de realizar otra acción.</span>}{item.lastErrorCode==='recipient_or_receipt_changed'&&<span class="portal-subtext">El comprobante o la cuenta destinataria cambiaron. Revisa el estado del documento y los datos y permisos del destinatario.</span>}{item.lastErrorCode&&['blocked','rejected'].includes(item.status)&&<span class="portal-subtext">Revisa la configuración o el límite de envío.</span>}</td><td data-label="Acción">{stagingTest ? <span class="portal-help">Simulación; no se envían correos.</span> : retryAllowed(item) ? <form action="/api/admin/email" method="post"><input type="hidden" name="action" value="retry" /><input type="hidden" name="outboxId" value={item.id} /><button class="portal-link portal-text-button" type="submit" aria-label={`Reintentar envío del comprobante ${item.receiptNumber} a ${item.recipientEmail}`}>Reintentar envío <span aria-hidden="true">↗</span></button></form> : <span class="portal-help">{item.status==='queued'?'Se procesa con el lote pendiente.':item.status==='cancelled'?'Conserva su historial. No se prepara otro envío automáticamente.':'Conserva su estado actual.'}</span>}</td></tr>)}</tbody></table></div> : <p class="portal-section-caption">No hay envíos preparados. Los comprobantes cuya cuenta destinataria requiere revisión conservan el correo retenido y se muestran en la tabla anterior.</p>}</section>
  <section class="portal-section"><h2>Archivos temporales</h2><p class="portal-section-caption">Limpia los borradores vencidos que nunca se enviaron como pago. Los originales de pagos registrados y sus versiones anteriores se conservan.</p><form action="/api/admin/slips/cleanup" method="post"><button class="portal-button portal-button-secondary" type="submit">Limpiar borradores vencidos <span aria-hidden="true">→</span></button></form><p class="portal-help">Cada acción revisa hasta 20 borradores, después del vencimiento y el período de espera. Los archivos vinculados a un pago quedan protegidos.</p></section>
</PortalLayout>
