---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHeader from '../../../components/portal/PageHeader.astro';
import ChargeAllocator from '../../../components/portal/ChargeAllocator.astro';
import PaymentHistory from '../../../components/portal/PaymentHistory.astro';
import EvidenceViewer from '../../../components/portal/EvidenceViewer.astro';
import OcrReview from '../../../components/portal/OcrReview.astro';
import DateInput from '../../../components/portal/DateInput.astro';
import { money, plainMoney, dateLabel, paymentLabels, emailLabels, referenceLabel } from '../../../components/portal/format';
import { authorizePortal } from '../../../lib/portal/access';
import { getPaymentDetail, getChargesForAdult, getAdminDashboard } from '../../../lib/portal/domain';
import { getPaymentExtractions } from '../../../lib/portal/ocr';
import { portalMessagePage } from '../../../lib/portal/http';
import type { PaymentDetail } from '../../../lib/portal/types';
import { resolveBusinessConfiguration } from '../../../lib/portal/business-config';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const business = resolveBusinessConfiguration(Astro.request, env);
const stagingTest = env.STAGING_PORTAL_TEST === 'true';
let detail: PaymentDetail;
try { detail = await getPaymentDetail(env.DB,actor,Astro.params.id ?? ''); } catch { return portalMessagePage('Pago no disponible.', 'No encontramos ese pago. Puede que el enlace ya no sea válido; el historial completo está en el resumen.', 404, '/admin', 'Volver al resumen'); }
const { payment } = detail;
const extractions = await getPaymentExtractions(env.DB,actor,payment.id);
const allCharges = await getChargesForAdult(env.DB,actor,payment.designatedAdultId);
const requested = Object.fromEntries(detail.requestedAllocations.map(allocation => [allocation.chargeId,allocation.amountMinor]));
const charges = allCharges.filter(charge => charge.balanceMinor>0 || (payment.status !== 'verified' && payment.status !== 'void' && requested[charge.id]));
const reviewable = ['pending','needs_info'].includes(payment.status);
const staffAssisted = payment.submitterId !== payment.designatedAdultId;
const pendingQueue = (await getAdminDashboard(env.DB)).payments.filter(item => item.status === 'pending' || item.status === 'needs_info');
const queue = reviewable ? pendingQueue : [];
// After a decision the payment leaves the queue; the next one is one tap away instead of a trip back to the summary.
const nextPending = reviewable ? null : pendingQueue[0] ?? null;
const queueIndex = queue.findIndex(item => item.id === payment.id);
const prevInQueue = queueIndex > 0 ? queue[queueIndex - 1] : null;
const nextInQueue = queueIndex >= 0 && queueIndex < queue.length - 1 ? queue[queueIndex + 1] : null;
const recipientPending = detail.receipt?.emailStatus === 'recipient_pending';
---
<PortalLayout title="Revisar pago" actor={actor} active="overview">
  <PageHeader backHref="/admin" backLabel="Volver al resumen" title={reviewable ? (stagingTest ? 'Revisa la transferencia ficticia.' : 'Comprueba la transferencia.') : (stagingTest && payment.status === 'verified' ? 'Prueba confirmada' : paymentLabels[payment.status])} eyebrow={stagingTest ? 'Revisión simulada' : 'Revisión bancaria'} description={stagingTest ? 'Esta revisión usa exclusivamente datos ficticios. Simulá la comprobación bancaria; no se recibieron fondos reales.' : reviewable ? 'El archivo adjunto sirve como respaldo. Confirma el ingreso en la cuenta de la Asociación y registra los datos que aparecen en el banco.' : `${money(payment.verifiedAmountMinor ?? payment.amountMinor)} · ${dateLabel(payment.transferDate)} · Ref. ${referenceLabel(payment.bankReference)}${payment.reviewNote ? ` — ${payment.reviewNote}` : ''}`}>{detail.receipt && <a class="portal-button" href={`/portal/comprobantes/${detail.receipt.id}`}>Abrir comprobante <span aria-hidden="true">→</span></a>}</PageHeader>
  {nextPending && <section class="portal-next-step" aria-labelledby="next-review-title"><h2 id="next-review-title">Siguiente transferencia</h2><p>Quedan <strong>{pendingQueue.length} {pendingQueue.length === 1 ? 'transferencia' : 'transferencias'} por revisar</strong>. La siguiente es la de {nextPending.payerName}.</p><div class="portal-copy-row"><a class="portal-button" href={`/admin/pagos/${nextPending.id}`}>Revisar la siguiente <span aria-hidden="true">→</span></a></div></section>}
  {reviewable && queue.length > 1 && <nav class="portal-copy-row" aria-label="Cola de revisión" style="margin-bottom:20px"><span class="portal-help">Pago {queueIndex + 1} de {queue.length} por revisar</span>{prevInQueue && <a class="portal-link" href={`/admin/pagos/${prevInQueue.id}`}>← Anterior</a>}{nextInQueue && <a class="portal-link" href={`/admin/pagos/${nextInQueue.id}`}>Siguiente →</a>}</nav>}
  <div class="portal-two-columns"><section class="portal-panel">
    <h2>Registro de la familia</h2><dl class="portal-detail-list"><div><dt>Pagado por</dt><dd>{payment.payerName}</dd></div><div><dt>Monto declarado</dt><dd>{money(payment.amountMinor)}</dd></div><div><dt>Fecha de transferencia</dt><dd>{dateLabel(payment.transferDate)}</dd></div><div><dt>Referencia declarada</dt><dd>{referenceLabel(payment.bankReference)}{payment.bankReference.trim() && <span data-copy-scope> <button class="portal-link portal-text-button" type="button" data-copy-value={payment.bankReference}>Copiar referencia</button><span class="portal-copy-feedback" data-copy-feedback role="status"></span></span>}</dd></div><div><dt>Registrado</dt><dd>{dateLabel(payment.submittedAt)}</dd></div><div><dt>Estado</dt><dd><span class:list={['portal-status',`portal-status-${payment.status}`]}>{paymentLabels[payment.status]}</span></dd></div></dl>
    {stagingTest && <div class="portal-guidance"><h3>Correo simulado · sin envíos</h3><p>Los comprobantes ficticios se conservan en el portal. En esta prueba no se envían correos ni están disponibles las acciones para prepararlos o reintentarlos.</p></div>}
    {!stagingTest && staffAssisted && reviewable && <div class="portal-guidance"><h3>Registro asistido · correo para la familia</h3><p>Al confirmar, el comprobante va al correo de la persona responsable elegida al registrar. Si esa cuenta no es válida, el correo se retiene; la confirmación, el comprobante y el saldo se conservan.</p></div>}
    {!stagingTest && recipientPending && <div class="portal-guidance"><h3>Comprobante disponible · correo retenido</h3><p>El pago y su comprobante están registrados. La cuenta destinataria requiere revisión: sus datos pueden estar incompletos o ser inválidos, o puede faltar la verificación, la activación o el acceso necesario.</p><p>Revisa la cuenta {staffAssisted ? "de la persona adulta responsable seleccionada para este pago" : "de quien registró originalmente el pago"} antes de preparar el envío. El documento sigue disponible en el portal.</p>{detail.receipt?.canPrepareEmail ? <><p>Cuando la cuenta esté corregida, prepara el correo aquí mismo. Corregir los datos no libera el correo automáticamente; la preparación y el envío del lote son acciones separadas.</p><form action="/api/admin/email" method="post"><input type="hidden" name="action" value="prepare" /><input type="hidden" name="receiptId" value={detail.receipt.id} /><button class="portal-button portal-button-secondary" type="submit">Preparar correo <span aria-hidden="true">→</span></button><p class="portal-help">Comprueba la cuenta y prepara el primer correo; no lo envía. Después se procesa desde Comprobantes.</p></form><a class="portal-link" href="/admin/familias">Revisar la cuenta en Familias <span aria-hidden="true">→</span></a></> : <p>{detail.receipt?.status === 'void' ? 'Este comprobante está anulado. Se conserva para consulta; no se prepara un correo automáticamente.' : 'Este comprobante ya tiene historial de correo. Revisa su estado en la lista; el destinatario no se cambia y no se prepara otro envío.'}</p>}</div>}
    {!stagingTest && detail.receipt && !recipientPending && (payment.status === 'verified' || payment.status === 'void') && <div class="portal-guidance"><h3>Correo del comprobante {detail.receipt.number}</h3><p>Estado: <span class:list={['portal-status',`portal-status-${detail.receipt.emailStatus ?? 'pending'}`]}>{emailLabels[detail.receipt.emailStatus ?? 'pending'] ?? detail.receipt.emailStatus}</span></p>{detail.receipt.emailStatus === 'accepted' || detail.receipt.emailStatus === 'sent' ? <p>El proveedor aceptó el envío (eso no confirma que ya llegó al buzón). Si la familia no lo ve, que revise el spam o abra el comprobante desde su cuenta.</p> : detail.receipt.emailStatus === 'queued' || detail.receipt.emailStatus === 'pending' ? <p>El correo está en cola. Envíalo desde Comprobantes con «Procesar correos pendientes».</p> : detail.receipt.emailStatus === 'dry_run' ? <p>Se registró como simulado (modo de prueba): no salió ningún mensaje real. Puedes reintentarlo desde Comprobantes cuando el correo real esté activo.</p> : ['blocked','rejected','unknown','sending','cancelled'].includes(detail.receipt.emailStatus ?? '') ? <p>Este envío necesita revisión antes de cualquier reintento. El comprobante sigue disponible en el portal.</p> : <p>El comprobante sigue disponible en el portal aunque el correo esté pendiente.</p>}<div class="portal-copy-row"><a class="portal-link" href={`/portal/comprobantes/${detail.receipt.id}`}>Abrir comprobante <span aria-hidden="true">→</span></a><a class="portal-link" href={`/admin/comprobantes#correo-${detail.receipt.number}-${detail.receipt.status === 'void' ? 'receipt_void' : 'receipt'}`}>Ver estado del correo <span aria-hidden="true">→</span></a></div></div>}
    {payment.reviewNote && <div class="portal-notice"><p>{payment.reviewNote}</p></div>}
    {reviewable && !business && <div class="portal-guidance" role="status"><h3>Confirmación de pagos no disponible</h3><p>La Asociación debe confirmar la configuración de cobro antes de emitir nuevos comprobantes. Puedes consultar el historial, solicitar información o rechazar este registro.</p></div>}
    {reviewable && business && !stagingTest && <div class="portal-guidance portal-guidance-strong"><h3>¿Qué sigue? Tres pasos</h3><ol class="portal-steps"><li>{payment.bankReference.trim() ? <>Busca la referencia <strong>{payment.bankReference}</strong> en la cuenta bancaria de la Asociación.</> : <>El comprobante no trae una referencia leída. Búscala en el archivo y en la cuenta del banco, y escríbela abajo.</>}</li><li>Si el monto recibido coincide, déjalo tal cual abajo, marca la casilla de comprobación y toca <strong>«Confirmar pago»</strong>. Si el banco muestra otro monto, fecha o referencia, corrígelos y escribe el motivo.</li><li>¿No aparece el ingreso o falta un dato? No confirmes: usa <strong>«Solicitar información»</strong> en «Solicitar una corrección» y la familia lo corrige desde su cuenta.</li></ol><a class="portal-link" href="#respaldo">Ver el respaldo del banco <span aria-hidden="true">↓</span></a></div>}
    {reviewable && business && <form class="portal-form" action={`/api/admin/payments/${payment.id}/review`} method="post" data-review-form data-unsaved-guard><input type="hidden" name="expectedRevision" value={payment.revision} /><input type="hidden" name="expectedStatus" value={payment.status} /><input type="hidden" name="expectedReviewNote" value={payment.reviewNote ?? ''} /><h2>{stagingTest ? 'Verificar datos ficticios' : 'Confirmar datos del banco'}</h2><input type="hidden" name="action" value="approve" /><div class="portal-form-row"><div class="portal-field"><label for="verified-amount">{stagingTest ? "Monto simulado (₡)" : "Monto recibido (₡)"}</label><input id="verified-amount" name="verifiedAmount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value={plainMoney(payment.amountMinor)} data-original={plainMoney(payment.amountMinor)} data-reconciled required /></div><DateInput id="verified-date" name="verifiedDate" label={stagingTest ? "Fecha simulada" : "Fecha del ingreso"} value={payment.transferDate} minYear={2020} dataOriginal={payment.transferDate} /></div><div class="portal-field"><label for="verified-reference">{stagingTest ? "Referencia ficticia" : "Referencia confirmada en el banco"}</label><input id="verified-reference" name="verifiedReference" type="text" maxlength="128" autocomplete="off" spellcheck="false" value={payment.bankReference} data-original={payment.bankReference} data-reconciled required /></div><div class="portal-form-row"><div class="portal-field"><label for="verified-bank">Banco o medio receptor</label><input id="verified-bank" name="verifiedBankName" type="text" maxlength="80" readonly value={business.bankName} required /></div><div class="portal-field"><label for="verified-account">Cuenta destino</label><input id="verified-account" name="verifiedReceivingAccount" type="text" maxlength="100" readonly value={business.receivingAccount} required /></div></div><ChargeAllocator charges={charges} values={requested} prefix="verified" voice="admin" legend={stagingTest ? "Aplicación simulada del pago" : "Aplicación confirmada del pago"} /><p class="portal-help">La diferencia entre el monto recibido y lo aplicado se conserva como saldo a favor de la cuenta familiar.</p><div class="portal-field"><label for="review-reason">Nota de verificación o motivo de la corrección</label><textarea id="review-reason" name="reason" maxlength="500" data-reconciliation-reason></textarea><p class="portal-help">Obligatoria si corriges el monto, la fecha o la referencia declarados por la familia.</p></div><label class="portal-checkbox"><input type="checkbox" name="bankChecked" value="on" required /><span>{stagingTest ? "Confirmo esta verificación simulada con datos ficticios. No se recibieron fondos reales." : "Comprobé esta transferencia directamente en la cuenta bancaria de la Asociación y confirmé que corresponde a este pago."}</span></label><button class="portal-button portal-button-wide" type="submit" disabled={charges.length === 0}>{stagingTest ? "Confirmar prueba y emitir comprobante ficticio" : "Confirmar pago y emitir comprobante"} <span aria-hidden="true">→</span></button><p class="portal-help">El comprobante conserva los datos de esta verificación. {stagingTest ? "En esta prueba el correo es simulado; no se envían mensajes." : staffAssisted ? "El correo se prepara para la cuenta verificada de la persona adulta responsable seleccionada para este registro asistido." : "El correo se prepara únicamente para la cuenta verificada que cargó originalmente el pago."}</p></form>}
    {payment.status === 'verified' && <><div class="portal-guidance"><h3>{stagingTest ? "Prueba confirmada" : "Pago confirmado"}</h3>{stagingTest && <p>No se recibieron fondos reales. Este comprobante es ficticio.</p>}<p>{stagingTest ? "Monto simulado:" : "Monto confirmado:"} <strong>{money(payment.verifiedAmountMinor ?? payment.amountMinor)}</strong>.</p><p>{stagingTest ? "Saldo ficticio sin aplicar:" : "Saldo a favor sin aplicar:"} <strong>{money(payment.unallocatedMinor)}</strong>.</p></div>{payment.unallocatedMinor > 0 && charges.length === 0 && <p class="portal-help">El saldo a favor se conserva. Podrás aplicarlo cuando se publique una nueva mensualidad pendiente.</p>}{payment.unallocatedMinor > 0 && charges.length > 0 && <form class="portal-form" action={`/api/admin/payments/${payment.id}/review`} method="post"><input type="hidden" name="expectedRevision" value={payment.revision} /><input type="hidden" name="expectedStatus" value={payment.status} /><input type="hidden" name="expectedReviewNote" value={payment.reviewNote ?? ''} /><h2>Aplicar saldo a favor</h2><input type="hidden" name="action" value="apply_credit" /><input type="hidden" name="operationId" value={crypto.randomUUID()} /><ChargeAllocator charges={charges} prefix="credit" voice="admin" legend="Mensualidades que recibirán el saldo" /><div class="portal-field"><label for="credit-reason">Motivo de la aplicación</label><textarea id="credit-reason" name="reason" maxlength="500" required></textarea></div><button class="portal-button" type="submit">Aplicar saldo <span aria-hidden="true">→</span></button><p class="portal-help">El comprobante original conserva la distribución registrada al emitirlo. Este cambio queda en el historial.</p></form>}</>}
  </section><aside class="portal-panel"><section class="portal-section" id="respaldo"><h2>Respaldo de la transferencia</h2><p class="portal-section-caption">{stagingTest ? "Revisa el archivo ficticio para simular la comprobación bancaria. No realices transferencias." : "Revisa el original y comprueba el ingreso directamente en la cuenta bancaria."}</p>{detail.files.length > 0 ? detail.files.map((file,index) => index === 0 ? <EvidenceViewer file={file} title="Archivo actual" /> : <details class="portal-evidence-history"><summary>Archivo anterior · {dateLabel(file.createdAt)}</summary><EvidenceViewer file={file} title="Archivo anterior" /></details>) : <p class="portal-section-caption">No hay archivos disponibles.</p>}</section>
    <OcrReview records={extractions} payment={payment} />
    {reviewable && <section class="portal-section"><h2>Solicitar una corrección</h2><form class="portal-form" action={`/api/admin/payments/${payment.id}/review`} method="post" style="margin-top:18px"><input type="hidden" name="expectedRevision" value={payment.revision} /><input type="hidden" name="expectedStatus" value={payment.status} /><input type="hidden" name="expectedReviewNote" value={payment.reviewNote ?? ''} /><div class="portal-field"><label for="decision-reason">Motivo para la familia</label><textarea id="decision-reason" name="reason" maxlength="500" required></textarea></div><div class="portal-form-actions"><button class="portal-button portal-button-secondary" name="action" value="needs_info" type="submit">Solicitar información</button><button class="portal-button portal-button-danger" name="action" value="reject" type="submit">Rechazar pago</button></div></form></section>}
    {payment.status === 'verified' && <section class="portal-section"><h2>Anular el pago</h2><p class="portal-section-caption">La anulación revierte su aplicación, conserva el comprobante con estado anulado y deja registro del motivo.</p><form class="portal-form" action={`/api/admin/payments/${payment.id}/review`} method="post"><input type="hidden" name="expectedRevision" value={payment.revision} /><input type="hidden" name="expectedStatus" value={payment.status} /><input type="hidden" name="expectedReviewNote" value={payment.reviewNote ?? ''} /><input type="hidden" name="action" value="void" /><div class="portal-field"><label for="void-reason">Motivo de anulación</label><textarea id="void-reason" name="reason" maxlength="500" required></textarea></div><label class="portal-checkbox"><input type="checkbox" required /><span>Confirmo la anulación de este pago y su comprobante.</span></label><button class="portal-button portal-button-danger" type="submit">Anular pago</button></form></section>}
    <PaymentHistory detail={detail} admin /><a class="portal-link" href="/admin"><span aria-hidden="true">←</span> Volver al resumen</a>
  </aside></div>
</PortalLayout>
<script>
  import { minorAmount } from '../../../lib/portal/allocation-validation';
  document.querySelectorAll<HTMLFormElement>('[data-review-form]').forEach(form => {
    const reason = form.querySelector<HTMLTextAreaElement>('[data-reconciliation-reason]');
    form.addEventListener('input', () => {
      if (reason) {
        // 27000, 27.000 and 27000.00 are the same amount, not a correction.
        const changedInputs = Array.from(form.querySelectorAll<HTMLInputElement>('[data-reconciled]')).some(input => {
          if (input.name === 'verifiedAmount') {
            const now = minorAmount(input.value.trim()), before = minorAmount(input.dataset.original ?? '');
            if (now !== null && before !== null) return now !== before;
          }
          return input.value.trim() !== input.dataset.original;
        });
        const changedDates = Array.from(form.querySelectorAll<HTMLElement>('[data-date-group]')).some(group => {
          const get = (suffix: string) => ((group.querySelector(`select[name$="${suffix}"]`) as HTMLSelectElement | null)?.value ?? '').padStart(2, '0');
          return `${get('Year')}-${get('Month')}-${get('Day')}` !== group.dataset.original;
        });
        reason.required = changedInputs || changedDates;
      }
    });
  });
</script>
