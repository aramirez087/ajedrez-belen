---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import ExportLinks from '../../components/portal/ExportLinks.astro';
import { money, monthLabel, dateLabel } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { getMonthlyPreview, getAdminDashboard } from '../../lib/portal/domain';
import { portalResponse } from '../../lib/portal/http';
import type { MonthlyPreview } from '../../lib/portal/types';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const currentMonth = new Intl.DateTimeFormat('en-CA',{timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()).slice(0,7);
const month = Astro.url.searchParams.get('month') ?? currentMonth;
let preview: MonthlyPreview;
try { preview = await getMonthlyPreview(env.DB,month); } catch { return portalResponse('Mes no válido.',400); }
const dashboard = await getAdminDashboard(env.DB);
const charges = dashboard.charges.filter(charge=>charge.period===month);
---
<PortalLayout title="Mensualidades" actor={actor} active="charges">
  <PageHeader title="Prepara el mes." eyebrow="Mensualidades" description="Revisa las cuotas y los descuentos antes de publicar. Cada mensualidad vence el día 8. Publicar de nuevo conserva los cargos existentes y agrega solo los que faltan." />
  <form class="portal-month-form" action="/admin/mensualidades" method="get"><div class="portal-field"><label for="month">Mes de cobro</label><input id="month" name="month" type="month" value={month} required /></div><button class="portal-button portal-button-secondary" type="submit">Revisar mes <span aria-hidden="true">→</span></button></form>
  <dl class="portal-stats"><div class="portal-stat"><dt>Mensualidades nuevas</dt><dd>{preview.newCount}</dd><p>{monthLabel(preview.period)}</p></div><div class="portal-stat"><dt>Total por publicar</dt><dd>{money(preview.totalMinor)}</dd><p>Incluye el descuento de hermanos y los descuentos manuales.</p></div><div class="portal-stat"><dt>Vencimiento</dt><dd style="font-size:27px">{dateLabel(preview.dueDate)}</dd><p>Primeros ocho días del mes.</p></div></dl>
  <section class="portal-section"><div class="portal-section-heading"><h2>Vista previa · {monthLabel(month)}</h2><a class="portal-link" href="/admin/familias">Editar cuotas <span aria-hidden="true">↗</span></a></div><div class="portal-table-wrap" role="region" aria-label="Vista previa de mensualidades" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Cuotas vigentes para este mes</caption><thead><tr><th scope="col">Atleta</th><th scope="col">Cuota base</th><th scope="col">Descuento</th><th scope="col">Total</th><th scope="col">Publicación</th></tr></thead><tbody>{preview.athletes.map(athlete => <tr><th scope="row">{athlete.name}<span class="portal-subtext">{athlete.category}</span></th><td class="portal-number">{money(athlete.feeMinor)}</td><td class="portal-number">{money(athlete.discountMinor + athlete.siblingMinor)}{athlete.discountReason && <span class="portal-subtext">{athlete.discountReason}</span>}{athlete.siblingMinor > 0 && <span class="portal-subtext">Hermanos 25 %: −{money(athlete.siblingMinor)}</span>}</td><td class="portal-number">{money(athlete.totalMinor)}</td><td><span class="portal-status">{athlete.alreadyPublished ? 'Publicado' : 'Por publicar'}</span></td></tr>)}</tbody></table></div><form action="/api/admin/charges" method="post" style="margin-top:23px"><input type="hidden" name="action" value="publish" /><input type="hidden" name="month" value={month} /><input type="hidden" name="expectedSnapshot" value={preview.snapshot} /><button class="portal-button" type="submit" disabled={preview.newCount===0}>Publicar {preview.newCount} {preview.newCount === 1 ? 'mensualidad' : 'mensualidades'} <span aria-hidden="true">→</span></button></form></section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Cargos publicados</h2><ExportLinks kind="charges" label="mensualidades" /></div>{charges.length ? charges.map(charge => <article class="portal-family-card"><header><div><h3>{charge.athleteName}</h3><p class="portal-help">{monthLabel(charge.period)} · total {money(charge.totalMinor)} · confirmado {money(charge.paidMinor)} · saldo {money(charge.balanceMinor)}</p></div></header><details><summary>Registrar ajuste <span aria-hidden="true">+</span></summary><form class="portal-form" action="/api/admin/charges" method="post"><input type="hidden" name="action" value="adjust" /><input type="hidden" name="operationId" value={crypto.randomUUID()} /><input type="hidden" name="chargeId" value={charge.id} /><input type="hidden" name="month" value={month} /><div class="portal-form-row"><div class="portal-field"><label for={`adjust-${charge.id}`}>Ajuste de cuota (₡)</label><input id={`adjust-${charge.id}`} name="adjustmentAmount" type="number" min="-1000000" max="1000000" step="0.01" inputmode="decimal" required /><p class="portal-help">Un monto negativo reduce el cargo; uno positivo lo aumenta.</p></div><div class="portal-field"><label for={`reason-${charge.id}`}>Motivo del ajuste</label><textarea id={`reason-${charge.id}`} name="reason" maxlength="500" required></textarea></div></div><button class="portal-button portal-button-secondary" type="submit">Guardar ajuste</button><p class="portal-help">El total resultante debe cubrir los pagos ya confirmados. El ajuste se conserva en el historial.</p></form></details></article>) : <p class="portal-section-caption">Aún no hay cargos publicados para este mes.</p>}</section>
</PortalLayout>
