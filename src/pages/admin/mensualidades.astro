---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import ExportLinks from '../../components/portal/ExportLinks.astro';
import { money, monthLabel, dateLabel } from '../../components/portal/format';
import MonthInput from '../../components/portal/MonthInput.astro';
import { authorizePortal } from '../../lib/portal/access';
import { getMonthlyPreview, getAdminDashboard } from '../../lib/portal/domain';
import { portalMessagePage } from '../../lib/portal/http';
import type { MonthlyPreview } from '../../lib/portal/types';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const currentMonth = new Intl.DateTimeFormat('en-CA',{timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()).slice(0,7);
const monthParam = Astro.url.searchParams.get('month');
const composedMonth = Astro.url.searchParams.get('monthMonth') && Astro.url.searchParams.get('monthYear') ? `${Astro.url.searchParams.get('monthYear')}-${(Astro.url.searchParams.get('monthMonth') ?? '').padStart(2,'0')}` : null;
const month = monthParam ?? composedMonth ?? currentMonth;
let preview: MonthlyPreview;
try { preview = await getMonthlyPreview(env.DB,month); } catch { return portalMessagePage('Mes no válido.', 'El mes indicado no tiene un formato válido. Elige un mes de cobro para continuar.', 400, '/admin/mensualidades', 'Elegir un mes'); }
const dashboard = await getAdminDashboard(env.DB);
const charges = dashboard.charges.filter(charge=>charge.period===month);
// Long months list every athlete in the club: each list pages on its own, so the page stays readable on a phone.
const PAGE_SIZE = 20;
function pageOf<T>(items: T[], key: string) {
  const pages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
  const requested = Number(Astro.url.searchParams.get(key));
  const page = Number.isFinite(requested) ? Math.min(pages, Math.max(1, Math.floor(requested))) : 1;
  return { items: items.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE), page, pages };
}
const previewView = pageOf(preview.athletes, 'previa');
const chargesView = pageOf(charges, 'pagina');
const pageHref = (key: 'previa' | 'pagina', target: number) => {
  const params = new URLSearchParams({ month, previa: String(key === 'previa' ? target : previewView.page), pagina: String(key === 'pagina' ? target : chargesView.page) });
  return `/admin/mensualidades?${params}#${key === 'previa' ? 'vista-previa' : 'cargos'}`;
};
---
<PortalLayout title="Mensualidades" actor={actor} active="charges">
  <PageHeader title="Mensualidades del mes." eyebrow="Mensualidades" description="El mes en curso se publica solo cada medianoche, hora de Costa Rica. Aquí puedes revisar los montos, publicar de inmediato si falta alguien, o ajustar un cargo. Publicar de nuevo no duplica: solo agrega lo que falte. Cada mensualidad vence el día 8." />
  <form class="portal-month-form" action="/admin/mensualidades" method="get"><MonthInput id="month" name="month" label="Mes de cobro" value={month} /><button class="portal-button portal-button-secondary" type="submit">Revisar mes <span aria-hidden="true">→</span></button></form>
  <dl class="portal-stats"><div class:list={['portal-stat', 'portal-stat-primary', { 'portal-stat-zero': preview.newCount === 0 }]}><dt>Mensualidades nuevas</dt><dd>{preview.newCount}</dd><dd class="portal-stat-note">{monthLabel(preview.period)}</dd></div><div class:list={['portal-stat', { 'portal-stat-zero': preview.totalMinor === 0 }]}><dt>Total por publicar</dt><dd>{money(preview.totalMinor)}</dd><dd class="portal-stat-note">Incluye el descuento de hermanos (25 % con 2 o más atletas por familia).</dd></div><div class="portal-stat"><dt>Vencimiento</dt><dd style="font-size:27px">{dateLabel(preview.dueDate)}</dd><dd class="portal-stat-note">Primeros ocho días del mes.</dd></div></dl>
  <section class="portal-section" id="vista-previa"><div class="portal-section-heading"><h2>Vista previa · {monthLabel(month)}</h2><a class="portal-link" href="/admin/familias#cuotas">Editar categorías <span aria-hidden="true">→</span></a></div><div class="portal-table-wrap" role="region" aria-label="Vista previa de mensualidades" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Cuotas vigentes para este mes</caption><thead><tr><th scope="col">Atleta</th><th scope="col" class="portal-num-head">Cuota base</th><th scope="col" class="portal-num-head">Descuento</th><th scope="col" class="portal-num-head">Total</th><th scope="col">Publicación</th></tr></thead><tbody>{previewView.items.map(athlete => <tr><th scope="row">{athlete.name}<span class="portal-subtext">{athlete.category}</span></th><td class="portal-number" data-label="Cuota base">{money(athlete.feeMinor)}</td><td class="portal-number" data-label="Descuento">{money(athlete.siblingMinor)}{athlete.siblingMinor > 0 && <span class="portal-subtext">Hermanos 25 %</span>}</td><td class="portal-number" data-label="Total">{money(athlete.totalMinor)}</td><td data-label="Publicación"><span class:list={['portal-status', athlete.alreadyPublished ? 'portal-status-approved' : 'portal-status-pending']}>{athlete.alreadyPublished ? 'Publicado' : 'Por publicar'}</span></td></tr>)}</tbody></table></div>{previewView.pages > 1 && <nav class="portal-copy-row" aria-label="Páginas de la vista previa">{previewView.page > 1 && <a class="portal-link" href={pageHref('previa', previewView.page - 1)}>← Anterior</a>}<span class="portal-help">Página {previewView.page} de {previewView.pages}</span>{previewView.page < previewView.pages && <a class="portal-link" href={pageHref('previa', previewView.page + 1)}>Siguiente →</a>}</nav>}<form action="/api/admin/charges" method="post" style="margin-top:23px"><input type="hidden" name="action" value="publish" /><input type="hidden" name="month" value={month} /><input type="hidden" name="expectedSnapshot" value={preview.snapshot} /><button class="portal-button" type="submit" disabled={preview.newCount===0}>Publicar {preview.newCount} {preview.newCount === 1 ? 'mensualidad' : 'mensualidades'} <span aria-hidden="true">→</span></button>{preview.newCount===0 && <p class="portal-help" style="margin-top:12px">Este mes ya está publicado para todos los atletas activos. Publicar de nuevo solo agregaría cargos faltantes.</p>}</form></section>
  <section class="portal-section" id="cargos"><div class="portal-section-heading"><h2>Cargos publicados</h2><ExportLinks kind="charges" label="mensualidades" /></div>{charges.length ? chargesView.items.map(charge => <article class="portal-family-card"><header><div><h3>{charge.athleteName}</h3><p class="portal-help">{monthLabel(charge.period)} · total {money(charge.totalMinor)} · confirmado {money(charge.paidMinor)} · saldo {money(charge.balanceMinor)}</p></div></header><details><summary>Registrar ajuste <span aria-hidden="true">+</span></summary><form class="portal-form" action="/api/admin/charges" method="post"><input type="hidden" name="action" value="adjust" /><input type="hidden" name="operationId" value={crypto.randomUUID()} /><input type="hidden" name="chargeId" value={charge.id} /><input type="hidden" name="month" value={month} /><div class="portal-form-row"><div class="portal-field"><label for={`adjust-${charge.id}`}>Ajuste de cuota (₡)</label><input id={`adjust-${charge.id}`} name="adjustmentAmount" type="number" min="-1000000" max="1000000" step="0.01" inputmode="decimal" required /><p class="portal-help">Ejemplos: -5000 baja el cargo en ₡5.000; 3000 lo sube en ₡3.000.</p></div><div class="portal-field"><label for={`reason-${charge.id}`}>Motivo del ajuste</label><textarea id={`reason-${charge.id}`} name="reason" maxlength="500" required></textarea></div></div><button class="portal-button portal-button-secondary" type="submit">Guardar ajuste</button><p class="portal-help">El total resultante debe cubrir los pagos ya confirmados. El ajuste se conserva en el historial.</p></form></details></article>) : <p class="portal-section-caption">Aún no hay cargos publicados para este mes.</p>}{chargesView.pages > 1 && <nav class="portal-copy-row" aria-label="Páginas de cargos">{chargesView.page > 1 && <a class="portal-link" href={pageHref('pagina', chargesView.page - 1)}>← Anteriores</a>}<span class="portal-help">Página {chargesView.page} de {chargesView.pages}</span>{chargesView.page < chargesView.pages && <a class="portal-link" href={pageHref('pagina', chargesView.page + 1)}>Siguientes →</a>}</nav>}</section>
</PortalLayout>
