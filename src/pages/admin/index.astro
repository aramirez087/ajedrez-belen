---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import ExportLinks from '../../components/portal/ExportLinks.astro';
import PaymentsTable from '../../components/portal/PaymentsTable.astro';
import { money, dueState } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { getAdminDashboard } from '../../lib/portal/domain';
import { minorAmount } from '../../lib/portal/allocation-validation';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const dashboard = await getAdminDashboard(env.DB);
const pending = dashboard.payments.filter(payment => payment.status === 'pending' || payment.status === 'needs_info');
const todayCR = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Costa_Rica', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const overdueCharges = dashboard.charges.filter(charge => charge.balanceMinor > 0 && dueState(charge.dueDate, todayCR).kind === 'overdue');
const historyAll = dashboard.payments.filter(payment => !pending.some(item => item.id === payment.id));
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const normalizeSearch = (value: string) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLocaleLowerCase('es');
const query = normalizeSearch(q);
const amountQuery = minorAmount(q);
const rawStatus = Astro.url.searchParams.get('estado') ?? 'todos';
const estado = ['todos', 'confirmados', 'rechazados', 'anulados'].includes(rawStatus) ? rawStatus : 'todos';
const statusGroups: Record<string, string[]> = { confirmados: ['verified', 'approved'], rechazados: ['rejected'], anulados: ['void', 'voided'] };
const matchesQuery = (payment: { payerName: string; bankReference: string | null; amountMinor: number; verifiedAmountMinor?: number | null }) => !q || normalizeSearch(payment.payerName).includes(query) || normalizeSearch(payment.bankReference ?? '').includes(query) || (amountQuery !== null && (payment.verifiedAmountMinor ?? payment.amountMinor) === amountQuery);
const pendingFiltered = pending.filter(matchesQuery);
const historySearching = q.length > 0 || estado !== 'todos';
const historyFiltered = historyAll.filter(payment =>
  (estado === 'todos' || (statusGroups[estado] ?? []).includes(payment.status)) &&
  matchesQuery(payment));
const PAGE_SIZE = 25;
const pages = Math.max(1, Math.ceil(historyFiltered.length / PAGE_SIZE));
const pendingPages = Math.max(1, Math.ceil(pendingFiltered.length / PAGE_SIZE));
const pageNumber = (key: string, total: number) => {
  const requested = Number(Astro.url.searchParams.get(key));
  return Number.isFinite(requested) ? Math.min(total, Math.max(1, Math.floor(requested))) : 1;
};
const page = pageNumber('pagina', pages);
const pendingPage = pageNumber('revisionPagina', pendingPages);
const pendingVisible = pendingFiltered.slice((pendingPage - 1) * PAGE_SIZE, pendingPage * PAGE_SIZE);
const history = historyFiltered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const pageHref = (target: number, reviewing = false) => {
  const params = new URLSearchParams({ q, estado, pagina: String(reviewing ? page : target), revisionPagina: String(reviewing ? target : pendingPage) });
  return `/admin?${params}#${reviewing ? 'por-revisar' : 'historial'}`;
};

---
<PortalLayout title="Administración" actor={actor} active="overview">
  <PageHeader title="Los pagos, bajo control." eyebrow="Administración" description="Confirma cada ingreso en la cuenta bancaria antes de aplicarlo a las mensualidades. Las transferencias pendientes conservan su estado de revisión."><a class="portal-button" href="/admin/pagos/nuevo">Registrar para una familia <span aria-hidden="true">→</span></a></PageHeader>
  <section class="portal-next-step" aria-labelledby="admin-next-title"><h2 id="admin-next-title">¿Qué hago ahora?</h2>{pending.length > 0 ? <><p>Hay <strong>{pending.length} {pending.length === 1 ? 'transferencia esperando' : 'transferencias esperando'}</strong> revisión. Abre la primera, busca su referencia en la cuenta del banco y confírmala (o pide el dato que falta). Una por una, en ese orden.</p><div class="portal-copy-row"><a class="portal-button" href={`/admin/pagos/${pending[0].id}`}>Revisar la primera <span aria-hidden="true">→</span></a></div></> : dashboard.emailPendingCount > 0 ? <><p>No hay pagos por revisar, pero quedan <strong>{dashboard.emailPendingCount} correos de comprobantes</strong> sin procesar o detenidos. Revísalos y envía el lote.</p><div class="portal-copy-row"><a class="portal-button" href="/admin/comprobantes">Revisar correos <span aria-hidden="true">→</span></a></div></> : <><p>Todo está al día: nada por revisar y ningún correo detenido. Las mensualidades del mes se publican solas cada medianoche, hora de Costa Rica. Si inscribiste a alguien hoy, puedes publicar ese cargo de inmediato.</p><div class="portal-copy-row"><a class="portal-button portal-button-secondary" href="/admin/mensualidades">Ver mensualidades <span aria-hidden="true">→</span></a></div></>}</section>
  <dl class="portal-stats"><div class:list={['portal-stat', 'portal-stat-primary', { 'portal-stat-zero': dashboard.pendingCount === 0 }]}><dt>Pagos por revisar</dt><dd>{dashboard.pendingCount}</dd><p>{dashboard.pendingCount > 0 ? <>Incluye solicitudes de información. <a class="portal-link" href="#por-revisar">Ir a la lista <span aria-hidden="true">↓</span></a></> : 'Nada pendiente de revisión.'}</p></div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.balanceMinor === 0 }]}><dt>Saldo de mensualidades</dt><dd>{money(dashboard.balanceMinor)}</dd><p>Saldo de todos los atletas inscritos.{overdueCharges.length > 0 && <> <strong>{overdueCharges.length} {overdueCharges.length === 1 ? 'mensualidad vencida' : 'mensualidades vencidas'}</strong> por {money(overdueCharges.reduce((total, charge) => total + charge.balanceMinor, 0))}.</>}</p></div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.emailPendingCount === 0 }]}><dt>Correos pendientes</dt><dd>{dashboard.emailPendingCount}</dd><p><a class="portal-link" href="/admin/comprobantes">Revisar correos <span aria-hidden="true">→</span></a></p></div></dl>
  <form class="portal-month-form" action="/admin#por-revisar" method="get" role="search" aria-label="Buscar pagos"><div class="portal-field"><label for="q">Buscar por nombre, referencia o monto</label><input id="q" name="q" type="search" value={q} placeholder="María, referencia, 15000…" autocomplete="off" /></div><div class="portal-field"><label for="estado">Estado del historial</label><select id="estado" name="estado"><option value="todos" selected={estado === 'todos'}>Todos</option><option value="confirmados" selected={estado === 'confirmados'}>Confirmados</option><option value="rechazados" selected={estado === 'rechazados'}>Rechazados</option><option value="anulados" selected={estado === 'anulados'}>Anulados</option></select></div><button class="portal-button portal-button-secondary" type="submit">Buscar <span aria-hidden="true">→</span></button>{(q || estado !== 'todos') && <a class="portal-link" href="/admin#historial">Limpiar <span aria-hidden="true">→</span></a>}</form>
  <p class="portal-help">Busca en las dos listas por nombre, referencia o monto exacto. El filtro de estado se aplica al historial. Se consultan hasta 500 pagos, con prioridad para los pendientes; los archivos de exportación incluyen todo el historial.</p>
  <section class="portal-section" id="por-revisar"><div class="portal-section-heading"><h2>Transferencias por revisar</h2><p>{q ? <>{pendingFiltered.length} de {pending.length} {pending.length === 1 ? 'coincide' : 'coinciden'} con la búsqueda</> : <>{pending.length} {pending.length === 1 ? 'registro pendiente' : 'registros pendientes'}</>}</p></div><PaymentsTable payments={pendingVisible} admin emptyTitle={q ? 'Nada en revisión coincide con esa búsqueda.' : 'Nada por revisar.'} emptyDescription={q ? 'Prueba con otro nombre, referencia o monto. El historial de abajo tiene los pagos ya resueltos.' : 'No hay transferencias pendientes ni solicitudes de información. Los pagos nuevos aparecerán aquí para su revisión bancaria.'} />{pendingPages > 1 && <nav class="portal-copy-row" aria-label="Páginas de pagos por revisar">{pendingPage > 1 && <a class="portal-link" href={pageHref(pendingPage - 1, true)}>← Anterior</a>}<span class="portal-help">Página {pendingPage} de {pendingPages}</span>{pendingPage < pendingPages && <a class="portal-link" href={pageHref(pendingPage + 1, true)}>Siguiente →</a>}</nav>}</section>
  <section class="portal-section" id="historial"><div class="portal-section-heading"><h2>Historial de pagos</h2><ExportLinks kind="payments" label="pagos" /></div><p class="portal-section-caption">{historyFiltered.length} {historyFiltered.length === 1 ? 'registro' : 'registros'}{pages > 1 && <> · página {page} de {pages}</>}. Exporta el historial completo en CSV o JSON.</p><PaymentsTable payments={history} admin emptyTitle={historySearching ? 'Sin resultados para esa búsqueda.' : 'Aún no hay pagos en el historial.'} emptyDescription={historySearching ? 'Prueba con otro nombre, referencia o estado. Los pagos pendientes se muestran arriba, fuera del historial.' : 'Los pagos confirmados, rechazados o anulados aparecen aquí. Lo que sigue en revisión está arriba.'} />{pages > 1 && <nav class="portal-copy-row" aria-label="Páginas del historial" style="margin-top:18px">{page > 1 && <a class="portal-link" href={pageHref(page - 1)}>← Anterior</a>}<span class="portal-help">Página {page} de {pages}</span>{page < pages && <a class="portal-link" href={pageHref(page + 1)}>Siguiente →</a>}</nav>}</section>
  <div class="portal-two-columns"><section class="portal-panel"><div class="portal-guidance"><h3>Las mensualidades se publican solas.</h3><p>Cada medianoche, hora de Costa Rica, se publican los cargos del mes en curso. No se duplica lo que ya existe: solo entran los atletas que faltaban. Cada uno conserva la cuota y el descuento vigentes en ese momento. Desde Mensualidades puedes revisar los montos, publicar de inmediato o ajustar un cargo.</p><a class="portal-link" href="/admin/mensualidades">Revisar mensualidades <span aria-hidden="true">→</span></a></div></section><section class="portal-panel"><h2>Familias y permisos</h2><p class="portal-section-caption">Inscribe atletas y vincula los correos de sus encargados. El descuento de hermanos (25 % para cada atleta cuando hay 2 o más en la familia) se aplica al publicarse el mes.</p><div class="portal-copy-row"><a class="portal-link" href="/admin/familias">Administrar familias <span aria-hidden="true">→</span></a><a class="portal-link" href="/admin/administradores">Invitar a un administrador <span aria-hidden="true">→</span></a></div></section></div>
</PortalLayout>
