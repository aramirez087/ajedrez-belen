---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import AthleteForm from '../../components/portal/AthleteForm.astro';
import { money } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { listFamilies, getAdminDashboard, listAthleteProfiles, ageOn, costaRicaToday, getFeeSchedule, ATHLETE_CATEGORIES } from '../../lib/portal/domain';
import { inputMoney } from '../../components/portal/format';
import { invitationWhatsAppMessage, invitationWhatsAppUrl } from '../../lib/portal/invitation-entry';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const stagingTest = env.STAGING_PORTAL_TEST === 'true';
const [families,dashboard,profiles,fees] = await Promise.all([listFamilies(env.DB),getAdminDashboard(env.DB),listAthleteProfiles(env.DB).catch(() => new Map()),getFeeSchedule(env.DB)]);
const todayCR = costaRicaToday(new Date().toISOString());
const myAthleteIds = new Set((families.find(family => family.adultId === actor.id)?.athletes ?? []).map(athlete => athlete.id));
const month = new Intl.DateTimeFormat('en-CA',{timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()).slice(0,7);
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const normalizeSearch = (value: string) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLocaleLowerCase('es');
const query = normalizeSearch(q);
const matchingAdults = families.filter(family => normalizeSearch(`${family.adultName} ${family.email}`).includes(query));
const relatedAthleteIds = new Set(matchingAdults.flatMap(family => family.athletes.map(athlete => athlete.id)));
const athletesFiltered = q ? dashboard.athletes.filter(athlete => normalizeSearch(athlete.name).includes(query) || relatedAthleteIds.has(athlete.id)) : dashboard.athletes;
const familiesFiltered = q ? families.filter(family => normalizeSearch(`${family.adultName} ${family.email}`).includes(query) || family.athletes.some(athlete => normalizeSearch(athlete.name).includes(query))) : families;
const PAGE_SIZE = 20;
const athletePages = Math.max(1, Math.ceil(athletesFiltered.length / PAGE_SIZE));
const familyPages = Math.max(1, Math.ceil(familiesFiltered.length / PAGE_SIZE));
const pageNumber = (key: string, pages: number) => {
  const requested = Number(Astro.url.searchParams.get(key));
  return Number.isFinite(requested) ? Math.max(1, Math.min(pages, Math.floor(requested))) : 1;
};
const athletePage = pageNumber('atletaPagina', athletePages);
const familyPage = pageNumber('familiaPagina', familyPages);
const athletesShown = athletesFiltered.slice((athletePage - 1) * PAGE_SIZE, athletePage * PAGE_SIZE);
const familiesShown = familiesFiltered.slice((familyPage - 1) * PAGE_SIZE, familyPage * PAGE_SIZE);
const pageHref = (kind: 'atleta' | 'familia', page: number) => {
  const params = new URLSearchParams({ q, atletaPagina: String(kind === 'atleta' ? page : athletePage), familiaPagina: String(kind === 'familia' ? page : familyPage) });
  return `/admin/familias?${params}#${kind === 'atleta' ? 'atletas' : 'cuentas'}`;
};
const inviteLink = Astro.cookies.get('portal-invite-link')?.value;
if (inviteLink) Astro.cookies.delete('portal-invite-link',{path:'/admin/familias'});
// Each view is a section of one page. A finished action returns to the view it changed (its notice says which).
const noticeViews: Record<string, string> = { links_updated: 'cuentas', fees_updated: 'cuotas', invitation_created: 'invitar' };
const defaultView = noticeViews[Astro.url.searchParams.get('notice') ?? ''] ?? 'atletas';
---
<PortalLayout title="Familias y atletas" actor={actor} active="families">
  <PageHeader title="Familias y atletas." eyebrow="Inscripción y permisos" description="Inscribe atletas, define sus cuotas y vincula a cada encargado por correo. El descuento de hermanos (25 %) se aplica al publicar cada mes." />
  <nav class="portal-subnav" aria-label="Secciones de familias"><a href="#atletas" aria-current={defaultView === 'atletas' ? 'page' : undefined}>Atletas inscritos</a><a href="#cuentas" aria-current={defaultView === 'cuentas' ? 'page' : undefined}>Cuentas familiares</a><a href="#inscribir" aria-current={defaultView === 'inscribir' ? 'page' : undefined}>Inscribir atleta</a><a href="#invitar" aria-current={defaultView === 'invitar' ? 'page' : undefined}>Invitar a un padre</a><a href="#cuotas" aria-current={defaultView === 'cuotas' ? 'page' : undefined}>Montos por categoría</a></nav>
  {!stagingTest && inviteLink && <section class="portal-guidance" aria-labelledby="invite-link-heading" data-copy-scope><h3 id="invite-link-heading">Enlace listo</h3><p>Envíalo por WhatsApp o cópialo. Vence en siete días y solo abre con ese correo.</p><div class="portal-copy-row" style="margin-top:15px"><a class="portal-button" href={invitationWhatsAppUrl(inviteLink)} target="_blank" rel="noopener">Enviar por WhatsApp <span aria-hidden="true">↗</span></a><span class="portal-help" data-copy-feedback role="status"></span></div><label class="visually-hidden" for="invite-link">Enlace de invitación</label><input class="portal-invitation-link" id="invite-link" type="text" value={inviteLink} readonly style="margin-top:15px" /><div class="portal-copy-row"><button class="portal-link portal-text-button" type="button" data-copy-invite>Copiar enlace <span aria-hidden="true">→</span></button><button class="portal-link portal-text-button" type="button" data-copy-value={invitationWhatsAppMessage(inviteLink)}>Copiar mensaje <span aria-hidden="true">↗</span></button></div><p class="portal-help">Cópialo o envíalo antes de salir: no vuelve a mostrarse.</p></section>}
  <form class="portal-month-form" action="/admin/familias" method="get" role="search" aria-label="Buscar familias y atletas"><div class="portal-field"><label for="q">Buscar atleta, encargado o correo</label><input id="q" name="q" type="search" value={q} placeholder="Nombre o correo…" autocomplete="off" /></div><button class="portal-button portal-button-secondary" type="submit">Buscar <span aria-hidden="true">→</span></button>{q && <a class="portal-link" href="/admin/familias">Limpiar <span aria-hidden="true">→</span></a>}</form>
  <div class:list={['admin-views', { 'is-searching': q !== '' }]} data-view={defaultView}><section class="portal-section admin-view" data-admin-view="atletas" id="atletas" tabindex="-1"><div class="portal-section-heading"><h2>Atletas inscritos</h2><p>{athletesFiltered.length} {athletesFiltered.length === 1 ? 'atleta' : 'atletas'}{q && <> para «{q}»</>}{athletePages > 1 && <> · página {athletePage} de {athletePages}</>}</p></div>{athletesFiltered.length === 0 && <p class="portal-section-caption">{q ? 'No hay atletas para esa búsqueda. Prueba con otro nombre o correo.' : 'Todavía no hay atletas inscritos.'}</p>}{athletesShown.map(athlete => { const profile = profiles.get(athlete.id); const paused = profile?.paused ?? false; return <article class="portal-family-card"><header><div><h3>{athlete.name}</h3><p class="portal-help">{athlete.category} · {money(athlete.feeMinor)} al mes</p>{(profile?.birthDate || profile?.school || profile?.nationalId) && <p class="portal-help">{[profile?.birthDate && `${ageOn(profile.birthDate, todayCR)} años`, profile?.school, profile?.nationalId && `cédula ${profile.nationalId}`].filter(Boolean).join(' · ')}</p>}</div><span class:list={['portal-status', !athlete.active ? 'portal-status-cancelled' : paused ? 'portal-status-pending' : 'portal-status-approved']}>{!athlete.active ? 'Inactivo' : paused ? 'En pausa' : 'Activo'}</span></header>{paused && <p class="portal-help">Membresía en pausa: no se generan mensualidades nuevas hasta reactivarla. Los cargos ya publicados no cambian; para corregirlos use un ajuste en Mensualidades.</p>}<div class="portal-copy-row" style="margin-top:12px"><form action={`/api/admin/athletes/${athlete.id}/pause`} method="post" data-confirm={paused ? undefined : '¿Pausar esta membresía? No se generarán mensualidades nuevas hasta reactivarla.'}><input type="hidden" name="action" value={paused ? 'resume' : 'pause'} /><button class="portal-link portal-text-button" type="submit">{paused ? 'Reactivar membresía' : 'Pausar membresía'}</button></form>{!myAthleteIds.has(athlete.id) && <form action="/api/admin/links" method="post"><input type="hidden" name="action" value="link" /><input type="hidden" name="userId" value={actor.id} /><input type="hidden" name="athleteId" value={athlete.id} /><button class="portal-link portal-text-button" type="submit">Vincularme como encargado</button></form>}{myAthleteIds.has(athlete.id) && <span class="portal-help">Eres encargado de este atleta · <a class="portal-link" href="/portal/inscribir">Ver en Mi familia</a></span>}</div><details><summary>Editar datos <span aria-hidden="true">+</span></summary><AthleteForm athlete={athlete} month={month} fees={fees} /></details></article>; })}{athletePages > 1 && <nav class="portal-copy-row" aria-label="Páginas de atletas">{athletePage > 1 && <a class="portal-link" href={pageHref('atleta', athletePage - 1)}>← Anteriores</a>}<span class="portal-help">Página {athletePage} de {athletePages}</span>{athletePage < athletePages && <a class="portal-link" href={pageHref('atleta', athletePage + 1)}>Siguientes →</a>}</nav>}</section>
  <section class="portal-section admin-view" data-admin-view="cuentas" id="cuentas" tabindex="-1"><div class="portal-section-heading"><h2>Cuentas familiares</h2><p>{familiesFiltered.length} {familiesFiltered.length === 1 ? 'cuenta' : 'cuentas'}{familyPages > 1 && <> · página {familyPage} de {familyPages}</>}</p></div><p class="portal-section-caption">El comprobante por correo llega solo a quien registró el pago, o a la persona que elegiste si lo registraste tú desde administración. Vincular un atleta no añade destinatarios. «Acceso a comprobantes anteriores» deja ver en el portal los comprobantes ya emitidos de ese atleta; no suscribe a la cuenta a correos nuevos.</p>{familiesShown.length ? familiesShown.map(family => <article class="portal-family-card"><header><div><h3>{family.adultName}</h3><p class="portal-help">{family.email}</p></div><span class:list={['portal-status', family.active ? 'portal-status-approved' : 'portal-status-cancelled']}>{family.active ? 'Activa' : 'Inactiva'}</span></header>{family.athletes.length ? <div class="portal-table-wrap" role="region" aria-label={`Atletas de ${family.adultName}`} tabindex="0"><table class="portal-table"><caption class="visually-hidden">Atletas vinculados y acceso a comprobantes compartidos anteriormente</caption><thead><tr><th scope="col">Atleta</th><th scope="col">Acceso a comprobantes anteriores</th><th scope="col">Vínculo</th></tr></thead><tbody>{family.athletes.map(athlete => <tr><th scope="row">{athlete.name}</th><td data-label="Acceso a comprobantes anteriores"><form action="/api/admin/links" method="post"><input type="hidden" name="action" value="consent" /><input type="hidden" name="userId" value={family.adultId} /><input type="hidden" name="athleteId" value={athlete.id} /><label class="portal-checkbox"><input type="checkbox" name="receiptOptIn" value="on" checked={athlete.receiptOptIn} /><span>Acceso a comprobantes compartidos anteriormente</span></label><button class="portal-link portal-text-button" type="submit">Guardar acceso</button></form></td><td data-label="Vínculo"><form action="/api/admin/links" method="post" data-confirm="¿Revocar este vínculo? La cuenta dejará de ver a este atleta; el historial de pagos se conserva."><input type="hidden" name="action" value="revoke" /><input type="hidden" name="userId" value={family.adultId} /><input type="hidden" name="athleteId" value={athlete.id} /><button class="portal-link portal-text-button" type="submit" aria-label={`Revocar vínculo de ${family.adultName} con ${athlete.name}`}>Revocar vínculo</button></form></td></tr>)}</tbody></table></div> : <p class="portal-help">Sin atletas vinculados.</p>}<details><summary>Vincular otro atleta <span aria-hidden="true">+</span></summary><form class="portal-form" action="/api/admin/links" method="post"><input type="hidden" name="action" value="link" /><input type="hidden" name="userId" value={family.adultId} /><div class="portal-field"><label for={`link-${family.adultId}`}>Atleta</label><select id={`link-${family.adultId}`} name="athleteId" required><option value="">Seleccionar atleta</option>{dashboard.athletes.filter(athlete=>!family.athletes.some(linked=>linked.id===athlete.id)).map(athlete => <option value={athlete.id}>{athlete.name}</option>)}</select></div><p class="portal-help">Este vínculo no añade destinatarios al correo de futuros comprobantes.</p><button class="portal-button portal-button-secondary" type="submit">Vincular atleta</button></form></details></article>) : <p class="portal-section-caption">{q ? 'Sin cuentas para esa búsqueda.' : 'Las cuentas aparecen cuando las personas ingresan al portal.'}</p>}{familyPages > 1 && <nav class="portal-copy-row" aria-label="Páginas de cuentas familiares">{familyPage > 1 && <a class="portal-link" href={pageHref('familia', familyPage - 1)}>← Anteriores</a>}<span class="portal-help">Página {familyPage} de {familyPages}</span>{familyPage < familyPages && <a class="portal-link" href={pageHref('familia', familyPage + 1)}>Siguientes →</a>}</nav>}</section>
  <section class="portal-panel admin-view" data-admin-view="inscribir" id="inscribir" tabindex="-1"><h2>Inscribir un atleta</h2><p class="portal-section-caption">Inscribe al atleta con su categoría. Después vincula a su encargado desde Cuentas familiares, o invítalo desde Invitar a un padre.</p><AthleteForm month={month} fees={fees} /></section><section class="portal-panel admin-view" data-admin-view="invitar" id="invitar" tabindex="-1"><h2>Invitar a un padre</h2>{stagingTest ? <p class="portal-section-caption">Las invitaciones no están disponibles en esta prueba con una sola cuenta autorizada. Puedes gestionar los vínculos ficticios existentes.</p> : <><p class="portal-section-caption">Escribe su correo. Marca los atletas que ya están inscritos. Si no marcas ninguno, los inscribe al entrar. Después envías el enlace por WhatsApp.</p><form class="portal-form" id="invite-form" action="/api/admin/invitations" method="post"><div class="portal-field"><label for="invite-email">Correo</label><input id="invite-email" name="email" type="email" maxlength="254" autocomplete="off" spellcheck="false" placeholder="encargado@ejemplo.com…" required /></div>{dashboard.athletes.length>0 && <fieldset class="portal-fieldset" id="invite-athletes"><legend>Atletas ya inscritos (opcional)</legend>{dashboard.athletes.map(athlete => <label class="portal-checkbox" style="margin-bottom:11px"><input type="checkbox" name="athleteId[]" value={athlete.id} /><span>{athlete.name}</span></label>)}</fieldset>}<button class="portal-button" id="invite-submit" type="submit" disabled>Crear enlace <span aria-hidden="true">→</span></button><p class="portal-help" id="invite-hint" role="status">Falta el correo.</p></form></>}</section>
  <section class="portal-section admin-view" data-admin-view="cuotas" id="cuotas" tabindex="-1"><div class="portal-section-heading"><h2>Montos por categoría</h2><p>La cuota de cada atleta se infiere de su categoría.</p></div><p class="portal-section-caption">Si la Asociación aprueba un aumento, cambia el monto aquí: se aplica a todos los atletas de la categoría en los meses que aún no se han publicado. Los cargos ya publicados no cambian.</p><form class="portal-form" action="/api/admin/fees" method="post"><div class="portal-form-row">{ATHLETE_CATEGORIES.map(category => <div class="portal-field"><label for={`fee-${category}`}>{category} (₡ / mes)</label><input id={`fee-${category}`} name={`fee-${category}`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value={inputMoney(fees[category])} required /></div>)}</div><button class="portal-button portal-button-secondary" type="submit">Guardar montos</button></form></section></div>
</PortalLayout>
<script>
  const inviteForm = document.querySelector<HTMLFormElement>('#invite-form');
  if (inviteForm) {
    const email = inviteForm.querySelector<HTMLInputElement>('#invite-email');
    const submit = inviteForm.querySelector<HTMLButtonElement>('#invite-submit');
    const hint = inviteForm.querySelector<HTMLElement>('#invite-hint');
    const refreshInvite = () => {
      const emailOk = !!email && email.value.trim() !== '' && email.checkValidity();
      const picked = inviteForm.querySelectorAll('input[name="athleteId[]"]:checked').length;
      if (submit) submit.disabled = !emailOk;
      if (hint) hint.textContent = !emailOk ? 'Falta el correo.' : picked > 0 ? 'Al abrir el enlace verá a esos atletas.' : 'Al entrar podrá inscribir a sus atletas.';
    };
    inviteForm.addEventListener('input', refreshInvite);
    inviteForm.addEventListener('change', refreshInvite);
    refreshInvite();
  }
  const inviteInput = document.querySelector<HTMLInputElement>('#invite-link');
  document.querySelector<HTMLButtonElement>('[data-copy-invite]')?.addEventListener('click', async () => {
    const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
    if (!inviteInput) return;
    try { await navigator.clipboard.writeText(inviteInput.value); if(feedback) feedback.textContent = 'Enlace copiado.'; }
    catch { inviteInput.select(); if(feedback) feedback.textContent = 'Selecciona y copia el enlace.'; }
  });
  // The bar shows which view is open; opening one moves focus there for keyboard and screen-reader users.
  const views = document.querySelector<HTMLElement>('.admin-views');
  const bar = Array.from(document.querySelectorAll<HTMLAnchorElement>('.portal-subnav a[href^="#"]'));
  const syncView = () => {
    const hash = decodeURIComponent(location.hash.slice(1));
    const open = hash && document.querySelector(`[data-admin-view="${CSS.escape(hash)}"]`) ? hash : views?.dataset.view ?? 'atletas';
    bar.forEach(link => { if (link.getAttribute('href') === `#${open}`) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current'); });
  };
  syncView();
  window.addEventListener('hashchange', () => {
    syncView();
    const hash = decodeURIComponent(location.hash.slice(1));
    document.querySelector<HTMLElement>(`[data-admin-view="${CSS.escape(hash)}"]`)?.focus({ preventScroll: true });
  });
</script>
