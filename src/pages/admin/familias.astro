---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import AthleteForm from '../../components/portal/AthleteForm.astro';
import { money } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { listFamilies, getAdminDashboard } from '../../lib/portal/domain';
export const prerender = false;
const access = await authorizePortal(Astro,env,{admin:true});
if (!access.ok) return access.response;
const { actor } = access;
const stagingTest = env.STAGING_PORTAL_TEST === 'true';
const [families,dashboard] = await Promise.all([listFamilies(env.DB),getAdminDashboard(env.DB)]);
const month = new Intl.DateTimeFormat('en-CA',{timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()).slice(0,7);
const inviteLink = Astro.cookies.get('portal-invite-link')?.value;
if (inviteLink) Astro.cookies.delete('portal-invite-link',{path:'/admin/familias'});
---
<PortalLayout title="Familias y atletas" actor={actor} active="families">
  <PageHeader title="Una familia, varias cuentas." eyebrow="Inscripción y permisos" description="Inscribe a los atletas, define su cuota y vincula cada encargado por su correo. Los hermanos y sus descuentos se gestionan manualmente." />
  <datalist id="athlete-categories"><option value="Iniciación" /><option value="Cadetes" /><option value="Intermedios" /><option value="Avanzados" /></datalist>
  {!stagingTest && inviteLink && <section class="portal-guidance" aria-labelledby="invite-link-heading"><h3 id="invite-link-heading">Invitación lista para compartir</h3><p>Este enlace permite vincular la cuenta que usa el correo indicado. Compártelo directamente con esa persona.</p><label class="visually-hidden" for="invite-link">Enlace de invitación</label><input class="portal-invitation-link" id="invite-link" type="text" value={inviteLink} readonly style="margin-top:15px" /><p class="portal-help">Vence en siete días. Copia el enlace antes de salir de esta página.</p><button class="portal-link portal-text-button" type="button" data-copy-invite>Copiar enlace <span aria-hidden="true">↗</span></button><span class="portal-help" data-copy-feedback role="status"></span></section>}
  <div class="portal-two-columns"><section class="portal-panel"><h2>Inscribir un atleta</h2><p class="portal-section-caption">La inscripción y el vínculo de los encargados se registran por separado.</p><AthleteForm month={month} /></section><section class="portal-panel"><h2>Invitar a un encargado</h2>{stagingTest ? <p class="portal-section-caption">Las invitaciones no están disponibles en esta prueba con una sola cuenta autorizada. Podés gestionar los vínculos ficticios existentes.</p> : <><p class="portal-section-caption">Puede vincularse a varios atletas con una sola invitación. Para dos encargados, crea un enlace para cada correo.</p><form class="portal-form" action="/api/admin/invitations" method="post"><div class="portal-field"><label for="invite-email">Correo del encargado</label><input id="invite-email" name="email" type="email" maxlength="254" autocomplete="off" required /></div><fieldset class="portal-fieldset"><legend>Atletas de esta persona</legend>{dashboard.athletes.map(athlete => <label class="portal-checkbox" style="margin-bottom:11px"><input type="checkbox" name="athleteId[]" value={athlete.id} /><span>{athlete.name}</span></label>)}</fieldset><button class="portal-button" type="submit" disabled={dashboard.athletes.length===0}>Crear enlace de invitación <span aria-hidden="true">→</span></button><p class="portal-help">El enlace se muestra aquí para compartirlo. La persona debe iniciar sesión con el correo de la invitación.</p></form></>}</section></div>
  <section class="portal-section"><div class="portal-section-heading"><h2>Atletas inscritos</h2><p>{dashboard.athletes.length} {dashboard.athletes.length === 1 ? 'atleta' : 'atletas'}</p></div>{dashboard.athletes.map(athlete => <article class="portal-family-card"><header><div><h3>{athlete.name}</h3><p class="portal-help">{athlete.category} · cuota {money(athlete.feeMinor)} · descuento {money(athlete.discountMinor)}</p></div><span class="portal-status">{athlete.active ? 'Activo' : 'Inactivo'}</span></header><details><summary>Editar datos y cuota <span aria-hidden="true">+</span></summary><AthleteForm athlete={athlete} month={month} /></details></article>)}</section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Cuentas familiares</h2><p>Revocar un vínculo conserva el historial de pagos.</p></div><p class="portal-section-caption">El correo del comprobante se dirige a la cuenta familiar verificada que registró originalmente el pago. En un registro asistido por administración, se dirige a la persona adulta responsable seleccionada para ese pago. El permiso de acceso de esta tabla conserva la consulta de comprobantes compartidos anteriormente; no suscribe a correos nuevos.</p>{families.length ? families.map(family => <article class="portal-family-card"><header><div><h3>{family.adultName}</h3><p class="portal-help">{family.email}</p></div><span class="portal-status">{family.active ? 'Activa' : 'Inactiva'}</span></header>{family.athletes.length ? <div class="portal-table-wrap" role="region" aria-label={`Atletas de ${family.adultName}`} tabindex="0"><table class="portal-table"><caption class="visually-hidden">Atletas vinculados y acceso a comprobantes compartidos anteriormente</caption><thead><tr><th scope="col">Atleta</th><th scope="col">Acceso a comprobantes anteriores</th><th scope="col">Vínculo</th></tr></thead><tbody>{family.athletes.map(athlete => <tr><th scope="row">{athlete.name}</th><td><form action="/api/admin/links" method="post"><input type="hidden" name="action" value="consent" /><input type="hidden" name="userId" value={family.adultId} /><input type="hidden" name="athleteId" value={athlete.id} /><label class="portal-checkbox"><input type="checkbox" name="receiptOptIn" value="on" checked={athlete.receiptOptIn} /><span>Acceso a comprobantes compartidos anteriormente</span></label><button class="portal-link portal-text-button" type="submit">Guardar acceso</button></form></td><td><form action="/api/admin/links" method="post"><input type="hidden" name="action" value="revoke" /><input type="hidden" name="userId" value={family.adultId} /><input type="hidden" name="athleteId" value={athlete.id} /><button class="portal-link portal-text-button" type="submit" aria-label={`Revocar vínculo de ${family.adultName} con ${athlete.name}`}>Revocar vínculo</button></form></td></tr>)}</tbody></table></div> : <p class="portal-help">Sin atletas vinculados.</p>}<details><summary>Vincular otro atleta <span aria-hidden="true">+</span></summary><form class="portal-form" action="/api/admin/links" method="post"><input type="hidden" name="action" value="link" /><input type="hidden" name="userId" value={family.adultId} /><div class="portal-field"><label for={`link-${family.adultId}`}>Atleta</label><select id={`link-${family.adultId}`} name="athleteId" required><option value="">Seleccionar atleta</option>{dashboard.athletes.filter(athlete=>!family.athletes.some(linked=>linked.id===athlete.id)).map(athlete => <option value={athlete.id}>{athlete.name}</option>)}</select></div><p class="portal-help">Este vínculo no añade destinatarios al correo de futuros comprobantes.</p><button class="portal-button portal-button-secondary" type="submit">Vincular atleta</button></form></details></article>) : <p class="portal-section-caption">Las cuentas aparecen cuando las personas ingresan al portal.</p>}</section>
</PortalLayout>
<script>
  const inviteInput = document.querySelector<HTMLInputElement>('#invite-link');
  document.querySelector<HTMLButtonElement>('[data-copy-invite]')?.addEventListener('click', async () => {
    const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
    if (!inviteInput) return;
    try { await navigator.clipboard.writeText(inviteInput.value); if(feedback) feedback.textContent = 'Enlace copiado.'; }
    catch { inviteInput.select(); if(feedback) feedback.textContent = 'Selecciona y copia el enlace.'; }
  });
</script>
