---
import { env } from 'cloudflare:workers';
import AuthShell from '../../components/portal/AuthShell.astro';
import PasswordField from '../../components/portal/PasswordField.astro';
import { authUnavailableResponse } from '../../lib/auth';
import { completePasswordReset } from '../../lib/auth-actions';
import { workosClient } from '../../lib/auth-pages';
import { safePortalReturnPath } from '../../lib/portal/invitation-entry';
import { portalResponse, readPortalForm } from '../../lib/portal/http';
export const prerender = false;
if (env.PORTAL_ENABLED !== 'true') return portalResponse('No encontrado.', 404);

const TOKEN_PATTERN = /^[A-Za-z0-9_\-.]{10,1024}$/;
let token = Astro.url.searchParams.get('token') ?? '';
let next = safePortalReturnPath(Astro.url.searchParams.get('next'));
let error = '';
let errorField = '';
if (Astro.request.method === 'POST') {
  const auth = workosClient();
  if (!auth) return authUnavailableResponse();
  try {
    const form = await readPortalForm(Astro.request);
    token = String(form.get('token') ?? '');
    next = safePortalReturnPath(String(form.get('next') ?? ''));
    const password = String(form.get('password') ?? '');
    const confirmation = String(form.get('confirmation') ?? '');
    if (!TOKEN_PATTERN.test(token)) {
      error = 'Este enlace no es válido. Pide un enlace nuevo desde «¿Olvidaste tu contraseña?».';
    } else if (password.length < 10) {
      error = 'La contraseña debe tener al menos 10 caracteres, mezclando letras y números.';
      errorField = 'password';
    } else if (password.length > 256) {
      error = 'La contraseña es demasiado larga. Usa hasta 256 caracteres.';
      errorField = 'password';
    } else if (password !== confirmation) {
      error = 'Las contraseñas no coinciden. Escríbelas de nuevo.';
      errorField = 'confirmation';
    } else {
      const result = await completePasswordReset(auth.client, token, password);
      if (result.ok) return Astro.redirect(`/auth/entrar?notice=contrasena_actualizada${next ? `&next=${encodeURIComponent(next)}` : ''}`, 303);
      error = result.message;
    }
  } catch {
    error = 'No pudimos leer el formulario. Vuelve a intentarlo.';
  }
}
const validLink = TOKEN_PATTERN.test(token);
const recuperarHref = `/auth/recuperar${next ? `?next=${encodeURIComponent(next)}` : ''}`;
const entrarHref = `/auth/entrar${next ? `?next=${encodeURIComponent(next)}` : ''}`;
---
<AuthShell title="Contraseña nueva" heading="Elige tu contraseña nueva." description="Escribe una contraseña que no uses en otro sitio. Al guardarla se cierran tus sesiones en otros equipos, por seguridad." error={error} errorFields={errorField ? [{ id: errorField, label: errorField === 'confirmation' ? 'Revisar confirmación de contraseña' : 'Revisar contraseña nueva' }] : []}>
  {validLink ? <>
    <form class="portal-form" method="post" action="/auth/restablecer">
      <input type="hidden" name="token" value={token} />
      <input type="hidden" name="next" value={next ?? ''} />
      <PasswordField id="password" name="password" label="Contraseña nueva" autocomplete="new-password" minlength={10} toggle help="Al menos 10 caracteres, mezclando letras y números." error={errorField === 'password' ? error : undefined} />
      <PasswordField id="confirmation" name="confirmation" label="Repite tu contraseña" visibilityLabel="contraseña repetida" autocomplete="new-password" minlength={10} toggle error={errorField === 'confirmation' ? error : undefined} />
      <button class="portal-button portal-button-wide" type="submit">Guardar contraseña nueva <span aria-hidden="true">→</span></button>
    </form>
  </> : <>
    <div class="portal-guidance">
      <h2>Necesitas un enlace nuevo</h2>
      <p>Venció, ya se usó o llegó incompleto. Pide un enlace nuevo y úsalo apenas llegue a tu correo.</p>
    </div>
  </>}
  <div class="portal-auth-links">
    <a class="portal-link" href={recuperarHref}>Pedir un enlace nuevo <span aria-hidden="true">→</span></a>
    <a class="portal-link" href={entrarHref}><span aria-hidden="true">←</span> Volver a iniciar sesión</a>
  </div>
</AuthShell>
<script>
  const password = document.querySelector<HTMLInputElement>('#password');
  const confirmation = document.querySelector<HTMLInputElement>('#confirmation');
  const validateConfirmation = () => {
    confirmation?.setCustomValidity(confirmation.value && password?.value !== confirmation.value
      ? 'Las contraseñas no coinciden. Revisa la contraseña repetida.' : '');
    if (confirmation?.validity.valid) {
      confirmation.removeAttribute('aria-invalid');
      const error = document.getElementById('confirmation-error');
      if (error) error.hidden = true;
    }
  };
  password?.addEventListener('input', validateConfirmation);
  confirmation?.addEventListener('input', validateConfirmation);
  window.addEventListener('pageshow', validateConfirmation);
</script>
