---
import { env } from 'cloudflare:workers';
import AuthShell from '../../components/portal/AuthShell.astro';
import PasswordField from '../../components/portal/PasswordField.astro';
import GoogleButton from '../../components/portal/GoogleButton.astro';
import { authUnavailableResponse } from '../../lib/auth';
import { signInWithPassword } from '../../lib/auth-actions';
import {
  afterLoginPath, clientMeta, parseDestino, validAuthEmail,
} from '../../lib/auth-flow';
import { applyAuthOutcome, pendingInvitationEmail, workosClient } from '../../lib/auth-pages';
import { getPortalIdentity } from '../../lib/portal/access';
import { safePortalReturnPath } from '../../lib/portal/invitation-entry';
import { portalResponse, readPortalForm } from '../../lib/portal/http';
export const prerender = false;
if (env.PORTAL_ENABLED !== 'true') return portalResponse('No encontrado.', 404);

const destino = parseDestino(Astro.url.searchParams.get('destino'));
const next = safePortalReturnPath(Astro.url.searchParams.get('next'));
const hasInvitation = Astro.cookies.has('pending-invitation');
const identity = getPortalIdentity(Astro, env);
const hasAdminInvitation = Astro.cookies.has('pending-admin-invitation');
if (identity) return Astro.redirect(afterLoginPath(destino, next, hasInvitation, hasAdminInvitation), 302);

// Arriving from an invitation link: we already know the correo. Prefill it,
// and when that correo has no account yet skip this form entirely and go
// straight to the one-screen account creation.
const invitedEmail = destino === 'familia' ? await pendingInvitationEmail(Astro.cookies) : null;
if (Astro.request.method === 'GET' && invitedEmail) {
  const auth = workosClient();
  if (auth) {
    const known = await auth.client.userManagement.listUsers({ email: invitedEmail, limit: 1 })
      .then((users) => users.data.length > 0)
      .catch(() => true);
    if (!known) return Astro.redirect(`/auth/registro?destino=familia${next ? `&next=${encodeURIComponent(next)}` : ''}`, 302);
  }
}

let error = '';
let email = invitedEmail ?? '';
// ?error= and ?notice= are rendered by the layout's Notice component.

if (Astro.request.method === 'POST') {
  const auth = workosClient();
  if (!auth) return authUnavailableResponse();
  try {
    const form = await readPortalForm(Astro.request);
    email = String(form.get('email') ?? '').trim().toLowerCase();
    const password = String(form.get('password') ?? '');
    if (!validAuthEmail(email) || password.length === 0) {
      error = 'Escribe tu correo completo y tu contraseña.';
    } else if (password.length > 256) {
      error = 'El correo o la contraseña no son correctos. Revisa los datos e inténtalo de nuevo.';
    } else {
      const outcome = await signInWithPassword(auth.client, env, {
        email, password, destino, next, meta: clientMeta(Astro.request),
      });
      const applied = await applyAuthOutcome(Astro, outcome, { destino, next });
      if ('response' in applied) return applied.response;
      error = applied.error;
    }
  } catch {
    error = 'No pudimos leer el formulario. Vuelve a intentarlo.';
  }
}

const googleHref = `/auth/google?destino=${destino}${next ? `&next=${encodeURIComponent(next)}` : ''}`;
const registroHref = `/auth/registro?destino=${destino}${next ? `&next=${encodeURIComponent(next)}` : ''}`;
const recuperarHref = `/auth/recuperar?destino=${destino}${next ? `&next=${encodeURIComponent(next)}` : ''}`;
const familiaHref = `/auth/entrar${next ? `?next=${encodeURIComponent(next)}` : ''}`;
const adminHref = `/auth/entrar?destino=admin${next ? `&next=${encodeURIComponent(next)}` : ''}`;
---
<AuthShell
  title={destino === 'admin' ? 'Ingreso de administración' : 'Iniciar sesión'}
  heading={destino === 'admin' ? 'Ingreso de administración.' : invitedEmail ? 'Inicia sesión.' : 'Te damos la bienvenida.'}
  description={destino === 'admin'
    ? 'Ingreso reservado para el personal autorizado de la Asociación. Si eres encargado de un atleta, usa el ingreso de familias.'
    : invitedEmail
      ? `Esta invitación es para ${invitedEmail}. Escribe tu contraseña.`
      : 'Entra con el correo que la Asociación vinculó a tus atletas para consultar mensualidades, registrar pagos y ver tus comprobantes.'}
  error={error}
  notice={Astro.url.searchParams.get('notice') === 'admin_ready' ? 'Ya quedaste como administrador. Entra con el mismo correo. La primera vez, la Asociación pide el código de tu aplicación de autenticación.' : undefined}
>
  <GoogleButton href={googleHref} />
  <p class="portal-help" style="text-align:center">{destino === 'admin' ? 'Con Google entras al ingreso de la Asociación.' : 'Con Google entras con tu cuenta familiar.'}</p>
  {!invitedEmail && <div class="portal-role-switch portal-auth-switch" role="navigation" aria-label="Tipo de ingreso">
    <a href={familiaHref} aria-current={destino === 'familia' ? 'page' : undefined}>Soy encargado de un atleta</a>
    <a href={adminHref} aria-current={destino === 'admin' ? 'page' : undefined}>Soy de la Asociación</a>
  </div>}
  {!invitedEmail && <p class="portal-help">{destino === 'admin' ? '¿Eres encargado de un atleta? Usa «Soy encargado de un atleta»: con la misma cuenta ves a tu familia.' : '¿También ayudas con la administración? Entra por aquí y cambia a Administración adentro.'}</p>}
  <form class="portal-form" method="post" action={Astro.url.pathname + Astro.url.search}>
    <div class="portal-field">
      <label for="email">Correo electrónico</label>
      <input id="email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" maxlength="254" value={email} placeholder="tucorreo@ejemplo.com" required />
    </div>
    <PasswordField id="password" name="password" label="Contraseña" autocomplete="current-password" toggle />
    <button class="portal-button portal-button-wide" type="submit">{invitedEmail ? 'Entrar' : 'Iniciar sesión'} <span aria-hidden="true">→</span></button>
  </form>
  <div class="portal-auth-links">
    <a class="portal-link" href={recuperarHref}>¿Olvidaste tu contraseña? <span aria-hidden="true">↗</span></a>
    <a class="portal-link" href={registroHref}>{invitedEmail ? '¿Primera vez? Crea tu cuenta' : '¿No tienes cuenta? Regístrate'} <span aria-hidden="true">↗</span></a>
  </div>
</AuthShell>
