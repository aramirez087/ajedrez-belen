---
import { env } from 'cloudflare:workers';
import AuthShell from '../../components/portal/AuthShell.astro';
import { authUnavailableResponse } from '../../lib/auth';
import { completeWithCode, resendVerificationCode } from '../../lib/auth-actions';
import { clientMeta } from '../../lib/auth-flow';
import { applyAuthOutcome, clearPendingAuth, readPendingAuth, workosClient } from '../../lib/auth-pages';
import { portalResponse, readPortalForm } from '../../lib/portal/http';
export const prerender = false;
if (env.PORTAL_ENABLED !== 'true') return portalResponse('No encontrado.', 404);

const pending = await readPendingAuth(Astro.cookies);
if (!pending) return Astro.redirect('/auth/entrar', 302);
if (pending.kind === 'organization') return Astro.redirect('/auth/organizacion', 302);

let error = '';
let notice = '';
if (Astro.request.method === 'POST') {
  const auth = workosClient();
  if (!auth) return authUnavailableResponse();
  try {
    const form = await readPortalForm(Astro.request);
    const accion = String(form.get('accion') ?? '');
    if (accion === 'cancelar') {
      clearPendingAuth(Astro.cookies);
      return Astro.redirect('/auth/entrar', 303);
    }
    if (accion === 'reenviar') {
      if (pending.kind === 'email_verification' && await resendVerificationCode(auth.client, pending)) {
        notice = `Te enviamos un código nuevo a ${pending.email}. Revisa también la carpeta de spam.`;
      } else {
        error = 'No pudimos enviar otro código en este momento. Espera un minuto y vuelve a intentarlo.';
      }
    } else {
      const code = String(form.get('code') ?? '').replace(/[\s-]/g, '');
      if (!/^\d{6}$/.test(code)) {
        error = 'Escribe el código de 6 números tal como llegó a tu correo.';
      } else {
        const outcome = await completeWithCode(auth.client, env, pending, code, clientMeta(Astro.request));
        const applied = await applyAuthOutcome(Astro, outcome, { destino: pending.destino, next: pending.next });
        if ('response' in applied) return applied.response;
        error = applied.error;
      }
    }
  } catch {
    error = 'No pudimos leer el formulario. Vuelve a intentarlo.';
  }
}

const copy = {
  email_verification: {
    heading: 'Revisa tu correo.',
    description: `Te enviamos un código de 6 números a ${pending.email}. Escríbelo aquí para confirmar que el correo es tuyo y terminar de entrar. Vence en unos 10 minutos.`,
    label: 'Código de verificación',
    hint: '¿No llegó? Revisa la carpeta de spam o correo no deseado.',
  },
  radar_email: {
    heading: 'Confirmemos que eres tú.',
    description: `Por seguridad, te enviamos un código de 6 números a ${pending.email}. Escríbelo aquí para terminar de entrar.`,
    label: 'Código de seguridad',
    hint: '¿No llegó? Revisa la carpeta de spam o correo no deseado.',
  },
  mfa_totp: {
    heading: 'Tu código de verificación.',
    description: 'Abre tu aplicación de autenticación y escribe el código de 6 números de Ajedrez Belén. Cambia cada 30 segundos.',
    label: 'Código de la aplicación',
    hint: 'Si el código no sirve, espera a que la aplicación muestre el siguiente y vuelve a intentarlo.',
  },
  organization: { heading: '', description: '', label: '', hint: '' },
}[pending.kind];
---
<AuthShell title="Código de verificación" heading={copy.heading} description={copy.description} error={error} notice={notice}>
  <form class="portal-form" method="post">
    <div class="portal-field">
      <label for="code">{copy.label}</label>
      <input class="portal-code-input" id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="8" placeholder="123456" required />
      <p class="portal-help">{copy.hint}</p>
    </div>
    <button class="portal-button portal-button-wide" type="submit">Continuar <span aria-hidden="true">→</span></button>
  </form>
  <div class="portal-auth-links">
    {pending.kind === 'email_verification'
      ? <form method="post"><input type="hidden" name="accion" value="reenviar" /><button class="portal-link portal-text-button" type="submit">Enviarme un código nuevo <span aria-hidden="true">↗</span></button></form>
      : <span></span>}
    <form method="post"><input type="hidden" name="accion" value="cancelar" /><button class="portal-link portal-text-button" type="submit">Cancelar y volver <span aria-hidden="true">↗</span></button></form>
  </div>
</AuthShell>
