---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import { dateLabel } from '../../components/portal/format';
import { workosClient } from '../../lib/auth-pages';
import { authorizePortal } from '../../lib/portal/access';
import { completeAdminInvite, getAdminInvitationPreview } from '../../lib/portal/admin-access';
import { getAuthService } from '../../lib/workos-runtime';
import { ADMIN_INVITATION_COOKIE, INVITATION_TOKEN_PATTERN } from '../../lib/portal/invitation-entry';
import { hashInvitationToken } from '../../lib/portal/routes';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const closed = env.STAGING_PORTAL_TEST === 'true' || env.STAGING_AUTH_SETUP === 'true';
const savedToken = Astro.cookies.get(ADMIN_INVITATION_COOKIE)?.value;
const token = !closed && savedToken && INVITATION_TOKEN_PATTERN.test(savedToken) ? savedToken : null;
const tokenHash = token ? await hashInvitationToken(token) : null;
let preview = tokenHash ? await getAdminInvitationPreview(env.DB, tokenHash).catch(() => null) : null;
let emailMatches = preview?.email ? preview.email.toLowerCase() === actor.email.toLowerCase() : false;
let autoRedeemFailed = false;
if (preview?.status === 'ready' && emailMatches && tokenHash) {
  try {
    const auth = workosClient();
    const outcome = await completeAdminInvite(env.DB, actor, tokenHash, auth?.client.userManagement ?? null, env.WORKOS_ORGANIZATION_ID ?? '');
    Astro.cookies.delete(ADMIN_INVITATION_COOKIE, { path: '/' });
    if (outcome === 'refresh') {
      const service = getAuthService(env);
      if (service) await service.clearSession(Astro.cookies);
      return Astro.redirect('/auth/entrar?destino=admin&notice=admin_ready', 302);
    }
    return Astro.redirect('/admin?notice=admin_joined', 302);
  } catch {
    preview = await getAdminInvitationPreview(env.DB, tokenHash).catch(() => preview);
    emailMatches = preview?.email ? preview.email.toLowerCase() === actor.email.toLowerCase() : false;
    autoRedeemFailed = preview?.status === 'ready' && emailMatches;
  }
}
if (preview?.status === 'used' && emailMatches) {
  Astro.cookies.delete(ADMIN_INVITATION_COOKIE, { path: '/' });
  if (actor.isAdmin) return Astro.redirect('/admin?notice=admin_joined', 302);
  const service = getAuthService(env);
  if (service) await service.clearSession(Astro.cookies);
  return Astro.redirect('/auth/entrar?destino=admin&notice=admin_ready', 302);
}
if (preview && preview.status !== 'ready') Astro.cookies.delete(ADMIN_INVITATION_COOKIE, { path: '/' });
const whatsapp = 'https://wa.me/50687686102';
---
<PortalLayout title="Invitación de administración" actor={actor} hideNav>
  <PageHeader title="Invitación de administración." eyebrow="Administración" />
  <section class="portal-panel"><div class="portal-guidance portal-guidance-strong">
    {closed && <>
      <h2>Esta invitación no está disponible.</h2>
      <p>En esta prueba no se agregan administradores. La cuenta autorizada sigue entrando por administración.</p>
    </>}
    {!closed && autoRedeemFailed && <>
      <h2>Confirma el acceso de administración.</h2>
      <p>Entraste con <strong>{actor.email}</strong>. Toca el botón para continuar.</p>
      <form action="/api/portal/admin-invitations/redeem" method="post"><input type="hidden" name="token" value={token} /><button class="portal-button" type="submit" style="margin-top:20px">Continuar <span aria-hidden="true">→</span></button></form>
    </>}
    {!closed && preview?.status === 'ready' && !emailMatches && <>
      <h2>Esta invitación es para {preview.email}.</h2>
      <p>Entraste con <strong>{actor.email}</strong>. Sal de esta cuenta y entra con <strong>{preview.email}</strong>. Después vuelve a abrir el enlace.</p>
      <form action="/auth/logout" method="post" style="margin-top:18px"><button class="portal-button" type="submit">Salir y entrar con otro correo <span aria-hidden="true">→</span></button></form>
    </>}
    {!closed && preview?.status === 'used' && !emailMatches && <>
      <h2>Este enlace ya se usó.</h2>
      <p>Cada enlace de administración sirve una sola vez. Pide uno nuevo a quien administra el portal.</p>
    </>}
    {!closed && preview?.status === 'expired' && <>
      <h2>Este enlace venció.</h2>
      <p>Duran siete días{preview.expiresAt ? <> y este venció el <strong>{dateLabel(preview.expiresAt)}</strong></> : ''}. Pide uno nuevo.</p>
      <a class="portal-button" href={whatsapp} style="margin-top:20px">Pedir un enlace nuevo por WhatsApp <span aria-hidden="true">↗</span></a>
    </>}
    {!closed && (!preview || preview.status === 'not_found') && <>
      <h2>Pega tu enlace.</h2>
      <p>Si el enlace de WhatsApp no abrió, pégalo aquí. Tiene que ser para <strong>{actor.email}</strong>.</p>
      <form class="portal-form" action="/api/portal/admin-invitations/redeem" method="post" style="margin-top:18px"><div class="portal-field"><label for="pasted-admin-invite">Tu enlace de invitación</label><input id="pasted-admin-invite" name="token" type="text" maxlength="2000" autocomplete="off" spellcheck="false" placeholder="Pega aquí el enlace completo…" required /></div><button class="portal-button" type="submit">Continuar <span aria-hidden="true">→</span></button></form>
    </>}
  </div></section>
</PortalLayout>
