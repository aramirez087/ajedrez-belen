---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import DateInput from '../../components/portal/DateInput.astro';
import { authorizePortal } from '../../lib/portal/access';
import { ageOn, costaRicaToday, getFeeSchedule, getParentDashboard, getRegistrationWindow, listAthleteProfiles } from '../../lib/portal/domain';
import { money } from '../../components/portal/format';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const dashboard = await getParentDashboard(env.DB, actor).catch(() => null);
const window = await getRegistrationWindow(env.DB, actor);
const profiles = await listAthleteProfiles(env.DB).catch(() => new Map());
const fees = await getFeeSchedule(env.DB).catch(() => null);
const today = costaRicaToday(new Date().toISOString());
const groups = ['Iniciación', 'Cadetes', 'Intermedios', 'Avanzados'];
const inviteLink = Astro.cookies.get('portal-invite-link')?.value;
if (inviteLink) Astro.cookies.delete('portal-invite-link', { path: '/portal/inscribir' });
---
<PortalLayout title="Mis atletas" actor={actor} active="my-athletes">
  <PageHeader title="Mis atletas, sin formularios externos." eyebrow="Inscripción" description="Inscriba a sus atletas aquí mismo: quedan vinculados a su cuenta y la mensualidad se genera automáticamente según el grupo. La edad se calcula de la fecha de nacimiento; no hace falta escribirla." />
  {inviteLink && <section class="portal-guidance" aria-labelledby="guardian-invite-heading" style="margin-bottom:22px"><h3 id="guardian-invite-heading">Invitación para el otro encargado, lista para compartir</h3><p>Comparta este enlace con esa persona: al entrar con el correo indicado, sus atletas también aparecerán en su cuenta. Vence en siete días y solo sirve con ese correo.</p><label class="visually-hidden" for="guardian-invite-link">Enlace de invitación</label><input class="portal-invitation-link" id="guardian-invite-link" type="text" value={inviteLink} readonly style="margin-top:15px" /><div class="portal-copy-row" style="margin-top:12px"><button class="portal-link portal-text-button" type="button" data-copy-guardian-invite>Copiar enlace <span aria-hidden="true">↗</span></button><span class="portal-help" data-copy-feedback role="status"></span></div></section>}
  {actor.isAdmin && !window && !(dashboard?.athletes.length) ? <section class="portal-panel"><div class="portal-guidance"><h2>Tu cuenta de administración todavía no es una cuenta familiar</h2><p>Para operar como encargado (inscribir y pagar por tu familia) primero vincula tu cuenta a tus atletas: en <a class="portal-link" href="/admin/familias">Familias</a> usa «Vincularme como encargado» en el atleta, o acepta una invitación enviada a tu correo. La administración de todos los atletas sigue en Familias.</p></div></section> : <>
  {dashboard && dashboard.athletes.length > 0 && <section class="portal-section"><div class="portal-section-heading"><h2>Atletas en mi cuenta</h2><p>{dashboard.athletes.length} {dashboard.athletes.length === 1 ? 'atleta' : 'atletas'}</p></div>{dashboard.athletes.map(athlete => { const profile = profiles.get(athlete.id); const paused = profile?.paused ?? false; return <article class="portal-family-card"><header><div><h3>{athlete.name}</h3><p class="portal-help">{athlete.category}{profile?.birthDate ? ` · ${ageOn(profile.birthDate, today)} años` : ''}{profile?.school ? ` · ${profile.school}` : ''}</p></div><span class:list={['portal-status', !athlete.active ? 'portal-status-cancelled' : paused ? 'portal-status-pending' : 'portal-status-approved']}>{!athlete.active ? 'Dado de baja' : paused ? 'Membresía en pausa' : 'Activo'}</span></header>{paused && athlete.active && <p class="portal-help">La administración pausó esta membresía: no se generan mensualidades nuevas hasta que se reactive. Los cargos anteriores se mantienen.</p>}<form action={`/api/portal/athletes/${athlete.id}`} method="post" data-confirm={athlete.active ? '¿Dar de baja a este atleta? Dejará de generar mensualidades nuevas; el historial y los cargos anteriores se conservan.' : undefined} style="margin-top:12px"><input type="hidden" name="action" value={athlete.active ? 'deactivate' : 'reactivate'} /><button class="portal-link portal-text-button" type="submit">{athlete.active ? 'Dar de baja' : 'Reactivar atleta'}</button></form></article>; })}</section>}
  {dashboard && dashboard.athletes.length > 0 && <section class="portal-panel" style="margin-bottom:22px"><h2>Invitar a otro encargado</h2><p class="portal-section-caption">El otro padre, madre o encargado puede tener su propia cuenta con acceso a los mismos atletas: ve saldos, registra pagos y recibe los comprobantes de sus propios registros. Usted crea el enlace y se lo comparte; no se envía ningún correo automáticamente.</p><form class="portal-form" action="/api/portal/invitations" method="post"><div class="portal-field"><label for="co-guardian-invite-email">Correo del otro encargado</label><input id="co-guardian-invite-email" name="email" type="email" maxlength="254" autocomplete="off" spellcheck="false" placeholder="otro@encargado.com…" required /></div><fieldset class="portal-fieldset"><legend>Atletas que podrá ver</legend>{dashboard.athletes.map(athlete => <label class="portal-checkbox" style="margin-bottom:11px"><input type="checkbox" name="athleteId[]" value={athlete.id} checked /><span>{athlete.name}</span></label>)}</fieldset><button class="portal-button" type="submit">Crear enlace para el otro encargado <span aria-hidden="true">→</span></button><p class="portal-help">El enlace aparece aquí arriba para compartirlo y vence en siete días. Solo funciona con ese correo.</p></form></section>}
  {window ? <section class="portal-panel"><h2>Inscribir un atleta</h2><p class="portal-section-caption">{fees ? `Cuota automática según el grupo: Iniciación ${money(fees['Iniciación'])}; Cadetes, Intermedios y Avanzados ${money(fees['Cadetes'])}. Si inscribe hermanos, el descuento del 25 % se aplica solo al publicar el mes.` : 'Cuota automática según el grupo. Si inscribe hermanos, el descuento del 25 % se aplica solo al publicar el mes.'}</p>
    <form class="portal-form" id="self-register-form" action="/api/portal/athletes" method="post">
      <div id="athlete-blocks">
        {[0].map(i => <fieldset class="portal-fieldset athlete-block" data-block={i}><legend>Atleta {i + 1}</legend>
          <div class="portal-field"><label for={`name-${i}`}>Nombre y apellidos del atleta</label><input id={`name-${i}`} name={`name-${i}`} type="text" maxlength="160" autocomplete="off" placeholder="Nombre y apellidos…" required /></div>
          <div class="portal-form-row"><DateInput id={`birthDate-${i}`} name={`birthDate-${i}`} label="Fecha de nacimiento" /><div class="portal-field"><label for={`category-${i}`}>Grupo</label><select id={`category-${i}`} name={`category-${i}`} required><option value="">Seleccionar grupo…</option>{groups.map(group => <option value={group}>{group}{group === 'Iniciación' ? ' (principiantes)' : ''}</option>)}</select></div></div>
          <div class="portal-form-row"><div class="portal-field"><label for={`nationalId-${i}`}>Número de cédula</label><input id={`nationalId-${i}`} name={`nationalId-${i}`} type="text" maxlength="30" autocomplete="off" spellcheck="false" placeholder="Solo si tiene 12 años o más…" /><p class="portal-help" data-cedula-hint>Obligatoria desde los 12 años; antes no hace falta.</p></div><div class="portal-field"><label for={`school-${i}`}>Centro educativo</label><input id={`school-${i}`} name={`school-${i}`} type="text" maxlength="160" autocomplete="off" placeholder="Escuela o colegio…" required /></div></div>
        </fieldset>)}
      </div>
      <div class="portal-copy-row"><button class="portal-button portal-button-secondary" type="button" id="add-athlete">Agregar otro atleta <span aria-hidden="true">+</span></button><span class="portal-help" id="add-athlete-note">Puede inscribir hermanos en el mismo envío.</span></div>
      <div class="portal-field" style="margin-top:20px"><label for="co-guardian-email">Correo del otro encargado (opcional)</label><input id="co-guardian-email" name="coGuardianEmail" type="email" maxlength="254" autocomplete="off" spellcheck="false" placeholder="otro@encargado.com…" /><p class="portal-help">Si lo indica, al terminar le mostramos un enlace para que esa persona también tenga acceso a estos atletas con su propia cuenta.</p></div>
      <button class="portal-button portal-button-wide" type="submit" style="margin-top:18px">Inscribir <span aria-hidden="true">→</span></button>
      <p class="portal-help">Al inscribir, el atleta queda activo y vinculado a su cuenta. La primera mensualidad se genera automáticamente; si algo cambia, puede darlo de baja aquí mismo.</p>
    </form>
  </section> : <section class="portal-panel"><div class="portal-guidance"><h2>Necesita una invitación de inscripción</h2><p>Para inscribir atletas por su cuenta, la Asociación debe enviarle una invitación de inscripción a su correo <strong>{actor.email}</strong>. Cuando la reciba, abra el enlace y esta página se habilita.</p><p style="margin-top:14px"><a class="portal-link" href="https://wa.me/50687686102">Solicitarla por WhatsApp <span aria-hidden="true">↗</span></a></p></div></section>}
  </>}
</PortalLayout>
<script>
  const guardianInviteInput = document.querySelector<HTMLInputElement>('#guardian-invite-link');
  document.querySelector<HTMLButtonElement>('[data-copy-guardian-invite]')?.addEventListener('click', async () => {
    const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
    if (!guardianInviteInput) return;
    try { await navigator.clipboard.writeText(guardianInviteInput.value); if (feedback) feedback.textContent = 'Enlace copiado.'; }
    catch { guardianInviteInput.select(); if (feedback) feedback.textContent = 'Selecciona y copia el enlace.'; }
  });
  const form = document.querySelector<HTMLFormElement>('#self-register-form');
  if (form) {
    const container = form.querySelector<HTMLElement>('#athlete-blocks');
    const addButton = form.querySelector<HTMLButtonElement>('#add-athlete');
    const note = form.querySelector<HTMLElement>('#add-athlete-note');
    const MAX = 6;
    const refreshCedula = (block: HTMLElement) => {
      const part = (suffix: string) => (block.querySelector(`select[name^="birthDate-"][name$="${suffix}"]`) as HTMLSelectElement | null)?.value ?? '';
      const birthValue = part('Year') && part('Month') && part('Day') ? `${part('Year')}-${part('Month')}-${part('Day')}` : '';
      const cedula = block.querySelector<HTMLInputElement>('input[name^="nationalId-"]');
      const hint = block.querySelector<HTMLElement>('[data-cedula-hint]');
      if (!cedula || !hint) return;
      let required = false;
      if (birthValue) {
        const [y, m, d] = birthValue.split('-').map(Number);
        const now = new Date();
        let age = now.getFullYear() - y;
        if (now.getMonth() + 1 < m || (now.getMonth() + 1 === m && now.getDate() < d)) age--;
        required = age >= 12;
        hint.textContent = required ? `Tiene ${age} años: la cédula es obligatoria.` : `Tiene ${age} años: la cédula no hace falta todavía.`;
      } else hint.textContent = 'Obligatoria desde los 12 años; antes no hace falta.';
      cedula.required = required;
    };
    container?.addEventListener('input', (event) => {
      const block = (event.target as HTMLElement).closest<HTMLElement>('.athlete-block');
      if (block) refreshCedula(block);
    });
    addButton?.addEventListener('click', () => {
      if (!container) return;
      const blocks = container.querySelectorAll('.athlete-block');
      if (blocks.length >= MAX) { if (note) note.textContent = 'Máximo seis atletas por envío; puede agregar más después.'; return; }
      const next = blocks.length;
      const clone = blocks[0].cloneNode(true) as HTMLElement;
      clone.dataset.block = String(next);
      const legend = clone.querySelector('legend'); if (legend) legend.textContent = `Atleta ${next + 1}`;
      clone.querySelectorAll('input, select').forEach(node => {
        const field = node as HTMLInputElement;
        field.name = field.name.replace(/-\d+(Day|Month|Year)?$/, (_match, part) => `-${next}${part ?? ''}`);
        field.id = field.id.replace(/-\d+(-day|-month|-year)?$/, (_match, part) => `-${next}${part ?? ''}`);
        field.value = '';
      });
      clone.querySelectorAll<HTMLLabelElement>('label').forEach(label => {
        label.htmlFor = label.htmlFor.replace(/-\d+(-day|-month|-year)?$/, (_match, part) => `-${next}${part ?? ''}`);
      });
      container.appendChild(clone);
      refreshCedula(clone);
      if (next + 1 >= MAX && note) note.textContent = 'Máximo seis atletas por envío; puede agregar más después.';
    });
  }
</script>
