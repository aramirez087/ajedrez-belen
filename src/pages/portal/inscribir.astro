---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import DateInput from '../../components/portal/DateInput.astro';
import { authorizePortal } from '../../lib/portal/access';
import { ageOn, costaRicaToday, getFeeSchedule, getParentDashboard, getRegistrationWindow, listOwnAthleteProfiles } from '../../lib/portal/domain';
import { money } from '../../components/portal/format';
import { invitationWhatsAppUrl } from '../../lib/portal/invitation-entry';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const dashboard = await getParentDashboard(env.DB, actor).catch(() => null);
const window = await getRegistrationWindow(env.DB, actor);
const profiles = await listOwnAthleteProfiles(env.DB, actor).catch(() => new Map());
const fees = await getFeeSchedule(env.DB).catch(() => null);
const today = costaRicaToday(new Date().toISOString());
const groups = ['Iniciación', 'Cadetes', 'Intermedios', 'Avanzados'];
const inviteLink = Astro.cookies.get('portal-invite-link')?.value;
if (inviteLink) Astro.cookies.delete('portal-invite-link', { path: '/portal/inscribir' });
const mustRegister = window?.via === 'invitation' && !(dashboard?.athletes.length);
---
<PortalLayout title={mustRegister ? 'Inscribe a tu atleta' : 'Mis atletas'} actor={actor} active="my-athletes" hideNav={mustRegister} homeHref={mustRegister ? '/portal/inscribir' : undefined}>
  {mustRegister
    ? <PageHeader title="Inscribe a tu atleta." eyebrow="Paso necesario" description="Tu cuenta ya está creada. Completa este formulario para terminar. Sin un atleta inscrito no hay mensualidades y no puedes registrar un pago." />
    : <PageHeader title="Mis atletas." eyebrow="Inscripción" description="Inscribe a tus atletas aquí. La mensualidad depende del grupo. El otro padre se agrega desde esta misma página." />}
  {inviteLink && <section class="portal-guidance" aria-labelledby="guardian-invite-heading" style="margin-bottom:22px"><h3 id="guardian-invite-heading">Enlace listo</h3><p>Envíalo por WhatsApp o cópialo. Vence en siete días y solo abre con ese correo.</p><div class="portal-copy-row" style="margin-top:15px"><a class="portal-button" href={invitationWhatsAppUrl(inviteLink)} target="_blank" rel="noopener">Enviar por WhatsApp <span aria-hidden="true">↗</span></a></div><label class="visually-hidden" for="guardian-invite-link">Enlace de invitación</label><input class="portal-invitation-link" id="guardian-invite-link" type="text" value={inviteLink} readonly style="margin-top:15px" /><div class="portal-copy-row" style="margin-top:12px"><button class="portal-link portal-text-button" type="button" data-copy-guardian-invite>Copiar enlace <span aria-hidden="true">→</span></button><span class="portal-help" data-copy-feedback role="status"></span></div></section>}
  {actor.isAdmin && !window && !(dashboard?.athletes.length) ? <section class="portal-panel"><div class="portal-guidance"><h2>Tu cuenta de administración todavía no es una cuenta familiar</h2><p>Para operar como encargado (inscribir y pagar por tu familia) primero vincula tu cuenta a tus atletas: en <a class="portal-link" href="/admin/familias">Familias</a> usa «Vincularme como encargado» en el atleta, o acepta una invitación enviada a tu correo. La administración de todos los atletas sigue en Familias.</p></div></section> : <>
  {dashboard && dashboard.athletes.length > 0 && <section class="portal-section"><div class="portal-section-heading"><h2>Atletas en mi cuenta</h2><p>{dashboard.athletes.length} {dashboard.athletes.length === 1 ? 'atleta' : 'atletas'}</p></div>{dashboard.athletes.map(athlete => { const profile = profiles.get(athlete.id); const paused = profile?.paused ?? false; return <article class="portal-family-card"><header><div><h3>{athlete.name}</h3><p class="portal-help">{athlete.category}{profile?.birthDate ? ` · ${ageOn(profile.birthDate, today)} años` : ''}{profile?.school ? ` · ${profile.school}` : ''}</p></div><span class:list={['portal-status', !athlete.active ? 'portal-status-cancelled' : paused ? 'portal-status-pending' : 'portal-status-approved']}>{!athlete.active ? 'Dado de baja' : paused ? 'Membresía en pausa' : 'Activo'}</span></header>{paused && athlete.active && <p class="portal-help">La administración pausó esta membresía: no se generan mensualidades nuevas hasta que se reactive. Los cargos anteriores se mantienen.</p>}<form action={`/api/portal/athletes/${athlete.id}`} method="post" data-confirm={athlete.active ? '¿Dar de baja a este atleta? Dejará de generar mensualidades nuevas; el historial y los cargos anteriores se conservan.' : undefined} style="margin-top:12px"><input type="hidden" name="action" value={athlete.active ? 'deactivate' : 'reactivate'} /><button class="portal-link portal-text-button" type="submit">{athlete.active ? 'Dar de baja' : 'Reactivar atleta'}</button></form></article>; })}</section>}
  {window ? <section class="portal-panel"><h2>{mustRegister ? 'Datos del atleta' : 'Inscribir un atleta'}</h2><p class="portal-section-caption">{fees ? `La mensualidad sale sola según el grupo: Iniciación ${money(fees['Iniciación'])} al mes; Cadetes, Intermedios y Avanzados ${money(fees['Cadetes'])} al mes. Si inscribes hermanos, el descuento del 25 % se ve reflejado cuando se publique el mes.` : 'La mensualidad sale sola según el grupo. Si inscribes hermanos, el descuento del 25 % se ve reflejado cuando se publique el mes.'}</p>
    <form class="portal-form" id="self-register-form" action="/api/portal/athletes" method="post" data-unsaved-guard data-draft-key="inscribir-atleta" data-draft-success="athletes_registered">
      <div id="athlete-blocks">
        {[0].map(i => <fieldset class="portal-fieldset athlete-block" data-block={i}><legend>Atleta {i + 1}</legend>
          <div class="portal-field"><label for={`name-${i}`}>Nombre y apellidos del atleta</label><input id={`name-${i}`} name={`name-${i}`} type="text" maxlength="160" autocomplete="off" placeholder="Nombre y apellidos…" required /></div>
          <div class="portal-form-row"><DateInput id={`birthDate-${i}`} name={`birthDate-${i}`} label="Fecha de nacimiento" /><div class="portal-field"><label for={`category-${i}`}>Grupo</label><select id={`category-${i}`} name={`category-${i}`} required><option value="">Seleccionar grupo…</option>{groups.map(group => <option value={group}>{group}{group === 'Iniciación' ? ' (principiantes)' : ''}</option>)}</select></div></div>
          <div class="portal-form-row"><div class="portal-field"><label for={`nationalId-${i}`}>Número de cédula</label><input id={`nationalId-${i}`} name={`nationalId-${i}`} type="text" maxlength="30" autocomplete="off" spellcheck="false" placeholder="Solo si tiene 12 años o más…" /><p class="portal-help" data-cedula-hint>Obligatoria desde los 12 años; antes no hace falta.</p></div><div class="portal-field"><label for={`school-${i}`}>Centro educativo</label><input id={`school-${i}`} name={`school-${i}`} type="text" maxlength="160" autocomplete="off" placeholder="Escuela o colegio…" required /></div></div>
        </fieldset>)}
      </div>
      <div class="portal-copy-row"><button class="portal-button portal-button-secondary" type="button" id="add-athlete" aria-controls="athlete-blocks">Agregar otro atleta <span aria-hidden="true">+</span></button><span class="portal-help" id="add-athlete-note" role="status">Puedes inscribir hermanos en el mismo envío.</span></div>
      <div class="portal-field" style="margin-top:20px"><label for="co-guardian-email">Correo del otro padre (opcional)</label><input id="co-guardian-email" name="coGuardianEmail" type="email" maxlength="254" autocomplete="off" spellcheck="false" placeholder="otro@ejemplo.com" /><p class="portal-help">Si lo dejas vacío, lo agregas después en «Dar acceso al otro padre», en esta misma página.</p></div>
      <button class="portal-button portal-button-wide" type="submit" style="margin-top:18px">{mustRegister ? 'Inscribir a mi atleta' : 'Inscribir'} <span aria-hidden="true">→</span></button>
      <p class="portal-help">Al inscribir, el atleta queda activo y su mensualidad se cobra sola. Si inscribes del 1 al 8, la primera es la de este mes; desde el 9, es la del mes siguiente y lo que resta de este mes no se cobra. Si algo cambia, puedes darlo de baja aquí mismo.</p>
    </form>
    {mustRegister && <p class="portal-help" style="margin-top:18px">¿El atleta ya está en la cuenta del otro padre? Pídele un enlace desde «Dar acceso al otro padre» en su cuenta, o <a class="portal-link" href="https://wa.me/50687686102">escríbenos por WhatsApp <span aria-hidden="true">↗</span></a>.</p>}
  </section> : <section class="portal-panel"><div class="portal-guidance"><h2>Necesitas una invitación para inscribir</h2><p>La Asociación te envía un enlace a tu correo <strong>{actor.email}</strong>. Tócalo en este teléfono y esta página se activa sola.</p><p style="margin-top:14px"><a class="portal-button" href="/portal/invitacion">Ya tengo mi enlace <span aria-hidden="true">→</span></a></p><p style="margin-top:10px"><a class="portal-link" href="https://wa.me/50687686102">Pedirla por WhatsApp <span aria-hidden="true">↗</span></a></p></div></section>}
  {dashboard && dashboard.athletes.length > 0 && <section class="portal-panel" id="compartir" style="margin-top:36px"><h2>Dar acceso al otro padre</h2><p class="portal-section-caption">Escribe su correo y crea el enlace. Lo envías por WhatsApp y entra con su propia cuenta. Si no lo haces al inscribir, puedes hacerlo aquí cuando quieras.</p><form class="portal-form" action="/api/portal/invitations" method="post"><div class="portal-field"><label for="co-guardian-invite-email">Correo</label><input id="co-guardian-invite-email" name="email" type="email" maxlength="254" autocomplete="off" spellcheck="false" placeholder="otro@ejemplo.com" required /></div><fieldset class="portal-fieldset"><legend>Atletas</legend>{dashboard.athletes.map(athlete => <label class="portal-checkbox" style="margin-bottom:11px"><input type="checkbox" name="athleteId[]" value={athlete.id} checked /><span>{athlete.name}</span></label>)}</fieldset><button class="portal-button" type="submit">Crear enlace <span aria-hidden="true">→</span></button><p class="portal-help">El enlace aparece arriba. Vence en siete días y solo abre con ese correo.</p></form></section>}
  </>}
</PortalLayout>
<script>
  const guardianInviteInput = document.querySelector<HTMLInputElement>('#guardian-invite-link');
  document.querySelector<HTMLButtonElement>('[data-copy-guardian-invite]')?.addEventListener('click', async () => {
    const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
    if (!guardianInviteInput) return;
    try { await navigator.clipboard.writeText(guardianInviteInput.value); if (feedback) feedback.textContent = 'Enlace copiado.'; }
    catch { guardianInviteInput.select(); if (feedback) feedback.textContent = 'Selecciona y copia el enlace.'; }
  });
  const form = document.querySelector<HTMLFormElement>('#self-register-form');
  if (form) {
    const container = form.querySelector<HTMLElement>('#athlete-blocks');
    const addButton = form.querySelector<HTMLButtonElement>('#add-athlete');
    const note = form.querySelector<HTMLElement>('#add-athlete-note');
    const MAX = 6;
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Costa_Rica', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
    const refreshCedula = (block: HTMLElement) => {
      const part = (suffix: string) => (block.querySelector(`select[name^="birthDate-"][name$="${suffix}"]`) as HTMLSelectElement | null)?.value ?? '';
      const birthValue = part('Year') && part('Month') && part('Day') ? `${part('Year')}-${part('Month')}-${part('Day')}` : '';
      const cedula = block.querySelector<HTMLInputElement>('input[name^="nationalId-"]');
      const hint = block.querySelector<HTMLElement>('[data-cedula-hint]');
      if (!cedula || !hint) return;
      let required = false;
      if (birthValue) {
        const [y, m, d] = birthValue.split('-').map(Number);
        const [nowYear, nowMonth, nowDay] = today.split('-').map(Number);
        let age = nowYear - y;
        if (nowMonth < m || (nowMonth === m && nowDay < d)) age--;
        required = age >= 12;
        hint.textContent = required ? `Tiene ${age} años: la cédula es obligatoria.` : `Tiene ${age} años: la cédula no hace falta todavía.`;
      } else hint.textContent = 'Obligatoria desde los 12 años; antes no hace falta.';
      cedula.required = required;
    };
    const refreshBlock = (event: Event) => {
      const block = (event.target as HTMLElement).closest<HTMLElement>('.athlete-block');
      if (block) refreshCedula(block);
    };
    container?.addEventListener('input', refreshBlock);
    container?.addEventListener('change', refreshBlock);
    const renameBlock = (block: HTMLElement, index: number) => {
      block.dataset.block = String(index);
      const legend = block.querySelector('legend'); if (legend) legend.textContent = `Atleta ${index + 1}`;
      // Update labels, date-group names and described-by references together.
      // Renaming only inputs leaves sibling date groups pointing to athlete 1.
      block.querySelectorAll<HTMLElement>('*').forEach(element => {
        for (const attribute of ['id', 'name', 'for', 'aria-labelledby', 'aria-describedby']) {
          const value = element.getAttribute(attribute);
          if (value) element.setAttribute(attribute, value.replace(/(name|birthDate|category|nationalId|school)-\d+/g, `$1-${index}`));
        }
      });
      const remove = block.querySelector<HTMLButtonElement>('[data-remove-athlete]');
      if (remove) { remove.hidden = index === 0; remove.setAttribute('aria-label', `Quitar atleta ${index + 1} de este formulario`); }
    };
    const refreshCount = () => {
      const blocks = Array.from(container?.querySelectorAll<HTMLElement>('.athlete-block') ?? []);
      blocks.forEach(renameBlock);
      if (addButton) addButton.disabled = blocks.length >= MAX;
      if (note) note.textContent = blocks.length >= MAX ? 'Máximo seis atletas por envío; puedes agregar más después.' : blocks.length > 1 ? `${blocks.length} atletas en este envío. Puedes quitar los que agregaste por error.` : 'Puedes inscribir hermanos en el mismo envío.';
    };
    const addBlock = (focus = false) => {
      if (!container) return;
      const blocks = container.querySelectorAll<HTMLElement>('.athlete-block');
      if (blocks.length >= MAX || !blocks[0]) return;
      const clone = blocks[0].cloneNode(true) as HTMLElement;
      clone.querySelectorAll('input, select').forEach(element => {
        const field = element as unknown as HTMLInputElement | HTMLSelectElement;
        field.value = ''; field.setCustomValidity(''); field.removeAttribute('aria-invalid');
      });
      clone.querySelectorAll<HTMLElement>('[data-date-error]').forEach(error => { error.hidden = true; error.textContent = ''; });
      const remove = document.createElement('button');
      remove.type = 'button'; remove.className = 'portal-link portal-text-button'; remove.dataset.removeAthlete = ''; remove.textContent = 'Quitar este atleta';
      clone.appendChild(remove);
      container.appendChild(clone);
      refreshCount();
      refreshCedula(clone);
      clone.dispatchEvent(new CustomEvent('portal:fields-added', { bubbles: true }));
      if (focus) clone.querySelector<HTMLInputElement>('input')?.focus();
    };
    addButton?.addEventListener('click', () => {
      addBlock(true);
      form.dispatchEvent(new Event('input', { bubbles: true }));
    });
    container?.addEventListener('click', event => {
      const remove = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-athlete]');
      if (!remove) return;
      remove.closest('.athlete-block')?.remove();
      refreshCount();
      addButton?.focus();
      form.dispatchEvent(new Event('input', { bubbles: true }));
    });
    form.addEventListener('portal:before-draft-restore', event => {
      const data = (event as CustomEvent<Record<string, unknown>>).detail;
      const indexes = Object.keys(data ?? {}).flatMap(key => { const match = key.match(/^name-(\d+)#0$/); return match ? [Number(match[1])] : []; });
      const count = Math.min(MAX, Math.max(1, ...indexes.map(index => index + 1)));
      while (container && container.querySelectorAll('.athlete-block').length < count) addBlock();
    });
    form.addEventListener('portal:draft-restored', () => {
      container?.querySelectorAll<HTMLElement>('.athlete-block').forEach(refreshCedula);
      refreshCount();
    });
  }
</script>
