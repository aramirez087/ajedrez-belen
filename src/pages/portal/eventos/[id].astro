---
import { env } from "cloudflare:workers";
import PortalLayout from "../../../layouts/PortalLayout.astro";
import PageHeader from "../../../components/portal/PageHeader.astro";
import EventCard from "../../../components/portal/EventCard.astro";
import { authorizePortal } from "../../../lib/portal/access";
import { crDateTimeLabel, crRangeLabel, expandOccurrences, getEvent, getEventAnyStatus, googleCalendarUrl, mapsUrl, nextOccurrence, occurrenceState, recurrenceLabel, resolveOccurrence, whatsAppShareUrl } from "../../../lib/portal/events";
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const nowIso = new Date().toISOString();
const rawEvent = await getEventAnyStatus(env.DB, Astro.params.id!).catch(() => null);
// Drafts never leak to families; cancelled events get a tombstone so a
// bookmarked/shared link explains itself instead of a bare 404.
const tombstone = rawEvent && rawEvent.status === "cancelled" && !actor.isAdmin ? rawEvent : null;
const event = !rawEvent || tombstone ? null : await getEvent(env.DB, Astro.params.id!, actor).catch(() => null);
const resolved = event ? resolveOccurrence(event, Astro.url.searchParams.get("occurrence"), nowIso) : null;
const occurrence = resolved?.occurrence ?? null;
const state = occurrence ? occurrenceState(occurrence, nowIso) : null;
const maps = event ? mapsUrl(event) : null;
const locBadge = event ? (event.locationType === "online" ? "En línea" : event.locationType === "hybrid" ? "Híbrido" : "Presencial") : "";
const isZoom = /zoom\.us/i.test(event?.locationUrl ?? "");
const pageUrl = new URL(Astro.url.pathname + (occurrence ? `?occurrence=${encodeURIComponent(occurrence.startsAt)}` : ""), Astro.url.origin).toString();
const nextDates = event && occurrence ? expandOccurrences(event, occurrence.startsAt, new Date(new Date(occurrence.startsAt).getTime() + 120 * 86_400_000).toISOString())
  .filter((o) => o.startsAt > occurrence.startsAt && o.endsAt > nowIso).slice(0, 4) : [];
const firstUpcoming = event ? (occurrence && resolved?.requestedCancelled ? nextOccurrence(event, nowIso) : null) : null;
if (!event && !tombstone) Astro.response.status = 404;
---
{event && occurrence ? (
<PortalLayout title={event.title} actor={actor} active="events">
  <PageHeader title={event.title} eyebrow="Evento" description={crDateTimeLabel(occurrence.startsAt)} backHref="/portal/eventos" backLabel="Volver a eventos" />
  {resolved?.substituted && <div class="portal-notice" role="status"><p><strong>Te mostramos la próxima fecha.</strong> El enlace que abriste no traía una fecha válida de este evento.</p></div>}
  {resolved?.requestedCancelled ? (
    <section class="portal-section portal-event-tombstone" aria-labelledby="cancelled-title">
      <h2 id="cancelled-title">Esta fecha fue cancelada.</h2>
      <p>La fecha del <s>{crDateTimeLabel(occurrence.startsAt)}</s> no se va a realizar. El resto de la serie sigue igual.</p>
      {firstUpcoming && <p>La próxima fecha es el <strong>{crDateTimeLabel(firstUpcoming.startsAt)}</strong>.</p>}
      <p class="portal-form-actions">{firstUpcoming && <a class="portal-button" href={`/portal/eventos/${event.id}?occurrence=${encodeURIComponent(firstUpcoming.startsAt)}`}>Ver la próxima fecha <span aria-hidden="true">→</span></a>}<a class="portal-link" href="/portal/eventos">Volver a eventos</a></p>
    </section>
  ) : (<>
  {event.image && <div class="portal-event-hero-wrap"><img class="portal-event-hero" src={`/api/portal/events/${event.id}/image`} alt={event.imageAlt ?? ""} /></div>}
  <section class="portal-section portal-event-detail">
    <p><span class="portal-event-badge portal-event-badge-plain">{locBadge}</span>{state === "live" && <span class="portal-event-badge portal-event-badge-live">En vivo ahora</span>}{state === "past" && <span class="portal-event-badge portal-event-badge-muted">Ya pasó</span>}{recurrenceLabel(event) && <span class="portal-event-recurrence"> {recurrenceLabel(event)}</span>}</p>
    {event.locationUrl && state === "live" && <p class="portal-event-live-note" role="status"><strong>Ya empezó.</strong> Todavía puedes entrar.</p>}
    {event.locationUrl && state === "today" && <p class="portal-event-live-note" role="status">Es <strong>hoy</strong>. El botón de abajo abre {isZoom ? "Zoom" : "la reunión"} en una pestaña nueva.</p>}
    <dl class="portal-event-facts">
      <div><dt>Cuándo</dt><dd><time datetime={occurrence.startsAt}>{crDateTimeLabel(occurrence.startsAt)}</time>{event.allDay ? " · Todo el día" : ` · ${crRangeLabel(occurrence.startsAt, occurrence.endsAt, false)}`} <span class="portal-event-tz">(hora de Costa Rica)</span></dd></div>
      {event.locationLabel && <div><dt>Lugar</dt><dd>{event.locationLabel}</dd></div>}
      {event.locationAddress && <div><dt>Dirección</dt><dd>{event.locationAddress}{maps && <> · <a class="portal-link" href={maps} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span><span class="visually-hidden">(se abre en una pestaña nueva)</span></a></>}</dd></div>}
    </dl>
    {event.locationUrl && state !== "past" && <p class="portal-event-join"><a class="portal-button" href={event.locationUrl} target="_blank" rel="noopener noreferrer">{state === "live" ? (isZoom ? "Entrar ahora por Zoom" : "Entrar ahora") : (isZoom ? "Entrar por Zoom" : "Entrar al evento")} <span aria-hidden="true">↗</span><span class="visually-hidden">(se abre en una pestaña nueva)</span></a></p>}
    {event.locationUrl && state === "past" && <p class="portal-event-past-note">Este evento ya terminó, por eso el enlace ya no se muestra.{nextDates[0] && <> La próxima fecha es el <a class="portal-link" href={`/portal/eventos/${event.id}?occurrence=${encodeURIComponent(nextDates[0].startsAt)}`}>{crDateTimeLabel(nextDates[0].startsAt)} <span aria-hidden="true">→</span></a>.</>}</p>}
    {state !== "past" && (
      <div class="portal-event-actions" data-copy-scope>
        <a class="portal-button portal-button-secondary" href={`/api/portal/events/${event.id}/ics?occurrence=${encodeURIComponent(occurrence.startsAt)}`}>Agregar a mi calendario (.ics) <span aria-hidden="true">↓</span></a>
        {event.recurrenceFreq !== "none" && <a class="portal-button portal-button-secondary" href={`/api/portal/events/${event.id}/ics?serie=1`}>Toda la serie (.ics) <span aria-hidden="true">↓</span></a>}
        <a class="portal-button portal-button-secondary" href={googleCalendarUrl(event, occurrence)} target="_blank" rel="noopener noreferrer">Google Calendar <span aria-hidden="true">↗</span><span class="visually-hidden">(se abre en una pestaña nueva)</span></a>
        <a class="portal-button portal-button-secondary" href={whatsAppShareUrl(event, occurrence, pageUrl)} target="_blank" rel="noopener noreferrer">Compartir por WhatsApp <span aria-hidden="true">↗</span><span class="visually-hidden">(se abre en una pestaña nueva)</span></a>
        <button class="portal-link portal-text-button" type="button" data-copy-value={event.locationUrl ?? pageUrl}>Copiar {event.locationUrl ? "enlace del evento" : "enlace de esta página"}</button>
        <span class="portal-help" data-copy-feedback role="status"></span>
      </div>
    )}
    {event.description && <div class="portal-event-description"><h2>Detalles</h2><p>{event.description}</p></div>}
    {nextDates.length > 0 && (
      <div class="portal-event-next-dates"><h2>Próximas fechas</h2><div class="portal-event-list">{nextDates.map((o) => <EventCard occurrence={o} nowIso={nowIso} />)}</div></div>
    )}
    {actor.isAdmin && <p><a class="portal-link" href={`/admin/eventos/${event.id}`}>Editar este evento (administración) <span aria-hidden="true">→</span></a></p>}
  </section>
  </>)}
</PortalLayout>
) : tombstone ? (
<PortalLayout title="Evento cancelado" actor={actor} active="events">
  <PageHeader title="Este evento fue cancelado." eyebrow="Evento" backHref="/portal/eventos" backLabel="Volver a eventos" />
  <section class="portal-section portal-event-tombstone" aria-labelledby="tombstone-title">
    <h2 id="tombstone-title"><s>{tombstone.title}</s></h2>
    <p>Estaba programado para el <s>{crDateTimeLabel(tombstone.startsAt)}</s> (hora de Costa Rica), pero la Asociación lo canceló. <strong>No hace falta que vengas ni que te conectes.</strong></p>
    <p>Si tenías una duda sobre este evento, <a class="portal-link" href="https://wa.me/50687686102" target="_blank" rel="noopener noreferrer">escríbenos por WhatsApp <span aria-hidden="true">↗</span></a>.</p>
    <p><a class="portal-button" href="/portal/eventos">Ver los demás eventos <span aria-hidden="true">→</span></a></p>
  </section>
</PortalLayout>
) : (
<PortalLayout title="Evento no encontrado" actor={actor} active="events">
  <PageHeader title="No encontramos ese evento." eyebrow="Evento" backHref="/portal/eventos" backLabel="Volver a eventos" />
  <section class="portal-section portal-event-tombstone">
    <p>Puede que el enlace esté incompleto o que el evento ya no exista. Revisa la lista de eventos: ahí están todas las actividades vigentes.</p>
    <p><a class="portal-button" href="/portal/eventos">Ir a eventos <span aria-hidden="true">→</span></a></p>
  </section>
</PortalLayout>
)}
