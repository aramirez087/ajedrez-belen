---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import PaymentsTable from '../../components/portal/PaymentsTable.astro';
import { money, monthLabel, dateLabel, familyEmailLabels, dueLabel, dueState } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { getParentDashboard } from '../../lib/portal/domain';
import { listEmailDrafts } from '../../lib/portal/slip-upload';
import { upcomingOccurrences } from '../../lib/portal/events';
import EventCard from '../../components/portal/EventCard.astro';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const dashboard = await getParentDashboard(env.DB, actor);
const emailDrafts = await listEmailDrafts(env, actor).catch(() => []);
const earliestDraftExpiry = emailDrafts.reduce<string | null>((earliest, draft) => earliest === null || draft.expiresAt < earliest ? draft.expiresAt : earliest, null);
const upcomingEvents = await upcomingOccurrences(env.DB, actor, 3).catch(() => []);
const actionNeeded = dashboard.payments.filter(payment => payment.status === 'needs_info');
const openCharges = dashboard.charges.filter(charge => charge.balanceMinor > 0);
const nextDue = openCharges.reduce<string | null>((earliest, charge) => earliest === null || charge.dueDate < earliest ? charge.dueDate : earliest, null);
const athleteBalance = (athleteId: string) => dashboard.charges.filter(charge => charge.athleteId === athleteId).reduce((total, charge) => total + charge.balanceMinor, 0);
const todayCR = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Costa_Rica', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const currentPeriod = todayCR.slice(0, 7);
const dueNowMinor = openCharges.filter(charge => charge.period <= currentPeriod).reduce((total, charge) => total + charge.balanceMinor, 0);
const futureMinor = openCharges.filter(charge => charge.period > currentPeriod).reduce((total, charge) => total + charge.balanceMinor, 0);
const overdueCount = openCharges.filter(charge => dueState(charge.dueDate, todayCR).kind === 'overdue').length;
const athleteOverdue = (athleteId: string) => openCharges.some(charge => charge.athleteId === athleteId && dueState(charge.dueDate, todayCR).kind === 'overdue');
---
<PortalLayout title="Mi cuenta" actor={actor} active="overview">
  <PageHeader title="Un vistazo a tu cuenta." eyebrow="Cuenta familiar" description="Las mensualidades se pagan durante los primeros ocho días del mes. El saldo se actualiza después de la verificación bancaria."><a class="portal-button" href="/portal/pagos/nuevo">Registrar un pago <span aria-hidden="true">→</span></a></PageHeader>
  {actionNeeded.length > 0 && <div class="portal-alert" role="alert"><span class="checker-mark" aria-hidden="true"></span><div class="portal-alert-text"><strong>{actionNeeded.length === 1 ? 'Un pago necesita tu atención.' : `${actionNeeded.length} pagos necesitan tu atención.`}</strong><p>La Asociación pidió información adicional{actionNeeded[0]?.reviewNote ? `: ${actionNeeded[0].reviewNote}` : ' para completar la revisión.'}</p></div>{actionNeeded[0]?.canOpenDetail && <a class="portal-button portal-button-secondary" href={`/portal/pagos/${actionNeeded[0].id}`}>Completar información <span aria-hidden="true">→</span></a>}</div>}
  {actionNeeded.length === 0 && dashboard.athletes.length === 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">¿Qué hago ahora?</h2><p>Tu cuenta ya existe, pero todavía no vemos atletas en ella. Toca en este teléfono el <strong>enlace de invitación</strong> que envía la Asociación y aparecen al instante.</p><div class="portal-copy-row"><a class="portal-button" href="/portal/invitacion">Ya tengo mi enlace <span aria-hidden="true">→</span></a><a class="portal-button portal-button-secondary" href="https://wa.me/50687686102">Pedirlo por WhatsApp <span aria-hidden="true">↗</span></a></div></section>}
  {actionNeeded.length === 0 && dashboard.athletes.length > 0 && dashboard.balanceMinor > 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">¿Qué hago ahora?</h2>{dueNowMinor > 0 ? <p>Debes <strong>{money(dueNowMinor)}</strong>{nextDue ? <> · <strong>{dueLabel(nextDue, todayCR).toLowerCase()}</strong></> : ''}.{futureMinor > 0 && <> Además ya puedes adelantar <strong>{money(futureMinor)}</strong> del próximo mes, solo si quieres.</>} Haz la transferencia por SINPE y después regístrala aquí con la foto o el PDF de tu banco; te guiamos paso a paso.</p> : <p>Ya puedes adelantar <strong>{money(futureMinor)}</strong> del próximo mes, solo si quieres. Haz la transferencia por SINPE y después regístrala aquí con la foto o el PDF de tu banco.</p>}<div class="portal-copy-row"><a class="portal-button" href="/portal/pagos/nuevo">Registrar mi pago <span aria-hidden="true">→</span></a></div></section>}
  {actionNeeded.length === 0 && dashboard.athletes.length > 0 && dashboard.balanceMinor === 0 && dashboard.pendingMinor > 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">¿Qué hago ahora?</h2><p>Nada por el momento: la Asociación está comprobando tu pago de <strong>{money(dashboard.pendingMinor)}</strong> en el banco. Cuando se confirme, el comprobante aparecerá en esta página.</p></section>}
  {actionNeeded.length === 0 && dashboard.athletes.length > 0 && dashboard.balanceMinor === 0 && dashboard.pendingMinor === 0 && dashboard.charges.length > 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">Estás al día.</h2><p>No debes nada y no hay pagos en revisión. Tus comprobantes están abajo, en esta misma página.</p></section>}
  {emailDrafts.length > 0 && <section class="portal-next-step" aria-labelledby="email-drafts-title"><h2 id="email-drafts-title">{emailDrafts.length === 1 ? 'Tienes un comprobante recibido por correo sin usar.' : `Tienes ${emailDrafts.length} comprobantes recibidos por correo sin usar.`}</h2><p>El correo solo guardó el archivo.{earliestDraftExpiry ? <> {emailDrafts.length === 1 ? 'Vence' : 'El primero vence'} el <strong>{dateLabel(earliestDraftExpiry)}</strong>.</> : ''}{openCharges.length > 0 ? ' Para que cuente como pago, regístralo con el monto y las mensualidades. La referencia se lee del comprobante.' : ''}{actionNeeded.length > 0 ? ' Si es la corrección de un pago, ábrelo desde ese pago.' : ''}{openCharges.length === 0 && actionNeeded.length === 0 ? ' Ahora no hay mensualidad pendiente donde registrarlo. Conserva también el original, por si se vence antes de que se publique.' : ''}</p>{(openCharges.length > 0 || actionNeeded[0]?.canOpenDetail) && <div class="portal-copy-row">{openCharges.length > 0 && <a class="portal-button" href="/portal/pagos/nuevo">Registrarlo ahora <span aria-hidden="true">→</span></a>}{actionNeeded[0]?.canOpenDetail && <a class={openCharges.length > 0 ? 'portal-button portal-button-secondary' : 'portal-button'} href={`/portal/pagos/${actionNeeded[0].id}`}>Completar ese pago <span aria-hidden="true">→</span></a>}</div>}</section>}
  <nav class="portal-subnav" aria-label="Secciones de mi cuenta"><a href="#atletas">Tus atletas</a><a href="#mensualidades">Mensualidades</a><a href="#pagos">Pagos</a><a href="#comprobantes">Comprobantes</a></nav>
  <dl class="portal-stats"><div class:list={['portal-stat', 'portal-stat-primary', { 'portal-stat-zero': dashboard.balanceMinor === 0 }]}><dt>Saldo pendiente</dt><dd>{money(dashboard.balanceMinor)}</dd>{dashboard.balanceMinor > 0 && nextDue ? <p><strong>{dueLabel(nextDue, todayCR)}</strong>. Se actualiza tras la verificación bancaria.{overdueCount > 0 && <> Tienes {overdueCount} {overdueCount === 1 ? 'mensualidad vencida' : 'mensualidades vencidas'}.</>}</p> : dashboard.charges.length > 0 ? <p>No tienes saldo pendiente. Estás al día.</p> : <p>Mensualidades pendientes de confirmación.</p>}</div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.pendingMinor === 0 }]}><dt>Pagos en revisión</dt><dd>{money(dashboard.pendingMinor)}</dd><p>La Asociación los está comprobando en el banco; todavía no bajan tu saldo.</p></div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.creditMinor === 0 }]}><dt>Saldo a favor</dt><dd>{money(dashboard.creditMinor)}</dd><p>Pagaste de más: queda guardado y se aplica a tus próximas mensualidades. No se pierde.</p></div></dl>
  <section class="portal-section" id="atletas"><div class="portal-section-heading"><h2>Tus atletas</h2>{dashboard.athletes.length ? <a class="portal-link" href="/portal/inscribir#compartir">Dar acceso al otro padre <span aria-hidden="true">→</span></a> : <p>Los atletas que ves con tu cuenta.</p>}</div>{dashboard.athletes.length ? <div class="portal-athletes">{dashboard.athletes.map(athlete => { const balance = athleteBalance(athlete.id); return <article class="portal-athlete"><div><h3>{athlete.name}</h3><p>{athlete.category} · {athlete.active ? 'Inscripción activa' : 'Inscripción inactiva'}</p></div><div class:list={['portal-athlete-balance', balance === 0 ? 'is-clear' : athleteOverdue(athlete.id) ? 'is-due' : undefined]}><strong>{money(balance)}</strong><span>{balance === 0 ? 'Al día' : athleteOverdue(athlete.id) ? 'Saldo vencido' : 'Saldo pendiente'}</span>{balance > 0 && <a class="portal-link" href="/portal/pagos/nuevo">Pagar <span aria-hidden="true">→</span></a>}</div></article>; })}</div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>Tu cuenta aún no tiene atletas.</h3><p>Toca tu enlace de invitación en este teléfono y aparecen aquí. <a class="portal-link" href="/portal/invitacion">Pegarlo manualmente <span aria-hidden="true">→</span></a> o <a class="portal-link" href="https://wa.me/50687686102">pedirlo por WhatsApp <span aria-hidden="true">↗</span></a>.</p></div></div>}</section>
  {upcomingEvents.length > 0 && <section class="portal-section"><div class="portal-section-heading"><h2>Próximos eventos</h2><a class="portal-link" href="/portal/eventos">Ver el calendario <span aria-hidden="true">→</span></a></div><div class="portal-event-list">{upcomingEvents.map((o) => <EventCard occurrence={o} />)}</div></section>}
  <section class="portal-section" id="mensualidades"><div class="portal-section-heading"><h2>Mensualidades</h2><p>Lo que debes cada mes. «Confirmado» es lo que ya se comprobó en el banco.</p></div>{dashboard.charges.length ? <div class="portal-table-wrap" role="region" aria-label="Mensualidades; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Mensualidades, pagos confirmados y saldo</caption><thead><tr><th scope="col">Atleta / mes</th><th scope="col" class="portal-num-head">Mensualidad</th><th scope="col" class="portal-num-head">Confirmado</th><th scope="col" class="portal-num-head">Saldo</th></tr></thead><tbody>{dashboard.charges.map(charge => <tr><th scope="row">{charge.athleteName}<span class="portal-subtext">{monthLabel(charge.period)} · {dueLabel(charge.dueDate, todayCR).toLowerCase()}</span></th><td class="portal-number" data-label="Mensualidad">{money(charge.totalMinor)}{charge.discountMinor > 0 && <span class="portal-subtext">Descuento {money(charge.discountMinor)} · {charge.discountReason}</span>}</td><td class="portal-number" data-label="Confirmado">{money(charge.paidMinor)}</td><td class="portal-number" data-label="Saldo">{money(charge.balanceMinor)}{charge.balanceMinor > 0 && dueState(charge.dueDate, todayCR).kind === 'overdue' && <span class="portal-status portal-status-needs_info" style="margin-left:8px">Vencida</span>}{charge.balanceMinor > 0 && dueState(charge.dueDate, todayCR).kind === 'today' && <span class="portal-status portal-status-pending" style="margin-left:8px">Vence hoy</span>}</td></tr>)}</tbody></table></div> : <p class="portal-section-caption">Todavía no hay mensualidades publicadas para tus atletas. Aparecen aquí al inicio de cada mes.</p>}</section>
  <section class="portal-section" id="pagos"><div class="portal-section-heading"><h2>Pagos registrados</h2><a class="portal-link" href="/portal/pagos/nuevo">Registrar pago <span aria-hidden="true">→</span></a></div><PaymentsTable payments={dashboard.payments} allowedReceiptIds={new Set(dashboard.receipts.map(receipt => receipt.id))} /></section>
  <section class="portal-section" id="comprobantes"><div class="portal-section-heading"><h2>Comprobantes</h2><p>El comprobante oficial aparece aquí cuando se confirma el pago en el banco.</p></div>{dashboard.athletes.length > 0 && <p class="portal-section-caption">¿Prefieres enviar el archivo de tu banco por correo? Puedes hacerlo: <a class="portal-link" href="/portal/pagos/nuevo#enviar-por-correo">ver cómo enviarlo por correo <span aria-hidden="true">→</span></a>. El correo solo guarda el archivo; el pago se registra en esa misma página.</p>}{dashboard.receipts.length ? <div class="portal-table-wrap" role="region" aria-label="Comprobantes; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Comprobantes emitidos y estado del correo</caption><thead><tr><th scope="col">Comprobante</th><th scope="col" class="portal-num-head">Total</th><th scope="col">Correo</th><th scope="col">Documento</th></tr></thead><tbody>{dashboard.receipts.map(receipt => <tr><th scope="row">{receipt.number}<span class="portal-subtext">{dateLabel(receipt.snapshot.issuedAt)}{receipt.status === 'void' ? ' · Anulado' : ''}</span></th><td class="portal-number" data-label="Total">{money(receipt.snapshot.amountMinor)}</td><td data-label="Correo">{receipt.status === 'void' ? 'Sin correo: comprobante anulado' : familyEmailLabels[receipt.emailStatus ?? 'pending'] ?? 'Aún no enviado'}{receipt.status !== 'void' && receipt.emailStatus !== 'accepted' && receipt.emailStatus !== 'sent' && <span class="portal-subtext">Tu comprobante sigue disponible aquí.</span>}</td><td data-label="Documento"><a class="portal-link" href={`/portal/comprobantes/${receipt.id}`} aria-label={`Abrir comprobante ${receipt.number}`}>Abrir comprobante <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div> : <p class="portal-section-caption">Tus comprobantes aparecerán aquí cuando se confirme un pago.</p>}</section>
</PortalLayout>
