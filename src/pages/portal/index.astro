---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import PaymentsTable from '../../components/portal/PaymentsTable.astro';
import { money, monthLabel, dateLabel, emailLabels } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { getParentDashboard } from '../../lib/portal/domain';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const dashboard = await getParentDashboard(env.DB, actor);
---
<PortalLayout title="Mi cuenta" actor={actor} active="overview">
  <PageHeader title="Un vistazo a tu cuenta." eyebrow="Cuenta familiar" description="Las mensualidades se pagan durante los primeros ocho días del mes. El saldo se actualiza después de la verificación bancaria."><a class="portal-button" href="/portal/pagos/nuevo">Registrar un pago <span aria-hidden="true">→</span></a></PageHeader>
  <dl class="portal-stats"><div class="portal-stat"><dt>Saldo pendiente</dt><dd>{money(dashboard.balanceMinor)}</dd><p>Mensualidades pendientes de confirmación.</p></div><div class="portal-stat"><dt>Pagos en revisión</dt><dd>{money(dashboard.pendingMinor)}</dd><p>Aún no se descuentan del saldo.</p></div><div class="portal-stat"><dt>Saldo a favor</dt><dd>{money(dashboard.creditMinor)}</dd><p>Monto confirmado pendiente de aplicar.</p></div></dl>
  <section class="portal-section"><div class="portal-section-heading"><h2>Tus atletas</h2><p>Una cuenta puede estar vinculada a varios atletas.</p></div>{dashboard.athletes.length ? <div class="portal-athletes">{dashboard.athletes.map(athlete => <article class="portal-athlete"><div><h3>{athlete.name}</h3><p>{athlete.category} · {athlete.active ? 'Inscripción activa' : 'Inscripción inactiva'}</p></div><span aria-hidden="true">♞</span></article>)}</div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>Tu cuenta aún no tiene atletas.</h3><p>Solicita a la Asociación una invitación para vincularte. Cada encargado usa su propio correo y su propia cuenta.</p></div></div>}</section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Mensualidades</h2><p>Los descuentos confirmados se reflejan en cada cargo.</p></div>{dashboard.charges.length ? <div class="portal-table-wrap" role="region" aria-label="Mensualidades; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Mensualidades, pagos confirmados y saldo</caption><thead><tr><th scope="col">Atleta / mes</th><th scope="col">Cuota</th><th scope="col">Confirmado</th><th scope="col">Saldo</th></tr></thead><tbody>{dashboard.charges.map(charge => <tr><th scope="row">{charge.athleteName}<span class="portal-subtext">{monthLabel(charge.period)} · vence {dateLabel(charge.dueDate)}</span></th><td class="portal-number">{money(charge.totalMinor)}{charge.discountMinor > 0 && <span class="portal-subtext">Descuento {money(charge.discountMinor)} · {charge.discountReason}</span>}</td><td class="portal-number">{money(charge.paidMinor)}</td><td class="portal-number">{money(charge.balanceMinor)}</td></tr>)}</tbody></table></div> : <p class="portal-section-caption">La Asociación todavía no ha publicado mensualidades para tus atletas.</p>}</section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Pagos registrados</h2><a class="portal-link" href="/portal/pagos/nuevo">Registrar pago <span aria-hidden="true">→</span></a></div><PaymentsTable payments={dashboard.payments} /></section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Comprobantes</h2><p>Disponibles después de verificar el ingreso en el banco.</p></div>{dashboard.receipts.length ? <div class="portal-table-wrap" role="region" aria-label="Comprobantes; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Comprobantes emitidos y estado del correo</caption><thead><tr><th scope="col">Comprobante</th><th scope="col">Total</th><th scope="col">Correo</th><th scope="col">Documento</th></tr></thead><tbody>{dashboard.receipts.map(receipt => <tr><th scope="row">{receipt.number}<span class="portal-subtext">{dateLabel(receipt.snapshot.issuedAt)}{receipt.status === 'void' ? ' · Anulado' : ''}</span></th><td class="portal-number">{money(receipt.snapshot.amountMinor)}</td><td>{emailLabels[receipt.emailStatus ?? 'pending'] ?? 'Pendiente'}</td><td><a class="portal-link" href={`/portal/comprobantes/${receipt.id}`}>Abrir comprobante <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div> : <p class="portal-section-caption">Tus comprobantes aparecerán aquí cuando se confirme un pago.</p>}</section>
</PortalLayout>
