---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import PaymentsTable from '../../components/portal/PaymentsTable.astro';
import { money, monthLabel, dateLabel, familyEmailLabels } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { getParentDashboard } from '../../lib/portal/domain';
import { upcomingOccurrences } from '../../lib/portal/events';
import EventCard from '../../components/portal/EventCard.astro';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const dashboard = await getParentDashboard(env.DB, actor);
const upcomingEvents = await upcomingOccurrences(env.DB, actor, 3).catch(() => []);
const actionNeeded = dashboard.payments.filter(payment => payment.status === 'needs_info');
const openCharges = dashboard.charges.filter(charge => charge.balanceMinor > 0);
const nextDue = openCharges.reduce<string | null>((earliest, charge) => earliest === null || charge.dueDate < earliest ? charge.dueDate : earliest, null);
const athleteBalance = (athleteId: string) => dashboard.charges.filter(charge => charge.athleteId === athleteId).reduce((total, charge) => total + charge.balanceMinor, 0);
---
<PortalLayout title="Mi cuenta" actor={actor} active="overview">
  <PageHeader title="Un vistazo a tu cuenta." eyebrow="Cuenta familiar" description="Las mensualidades se pagan durante los primeros ocho días del mes. El saldo se actualiza después de la verificación bancaria."><a class="portal-button" href="/portal/pagos/nuevo">Registrar un pago <span aria-hidden="true">→</span></a></PageHeader>
  {actionNeeded.length > 0 && <div class="portal-alert" role="alert"><span class="checker-mark" aria-hidden="true"></span><div class="portal-alert-text"><strong>{actionNeeded.length === 1 ? 'Un pago necesita tu atención.' : `${actionNeeded.length} pagos necesitan tu atención.`}</strong><p>La Asociación pidió información adicional{actionNeeded[0]?.reviewNote ? `: ${actionNeeded[0].reviewNote}` : ' para completar la revisión.'}</p></div>{actionNeeded[0]?.canOpenDetail && <a class="portal-button portal-button-secondary" href={`/portal/pagos/${actionNeeded[0].id}`}>Completar información <span aria-hidden="true">→</span></a>}</div>}
  {actionNeeded.length === 0 && dashboard.athletes.length === 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">¿Qué hago ahora?</h2><p>Tu cuenta ya existe, pero todavía no vemos atletas en ella. Toca en este teléfono el <strong>enlace de invitación</strong> que envía la Asociación y aparecen al instante.</p><div class="portal-copy-row"><a class="portal-button" href="/portal/invitacion">Ya tengo mi enlace <span aria-hidden="true">→</span></a><a class="portal-button portal-button-secondary" href="https://wa.me/50687686102">Pedirlo por WhatsApp <span aria-hidden="true">↗</span></a></div></section>}
  {actionNeeded.length === 0 && dashboard.athletes.length > 0 && dashboard.balanceMinor > 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">¿Qué hago ahora?</h2><p>Debes <strong>{money(dashboard.balanceMinor)}</strong>{nextDue ? <> y vence el <strong>{dateLabel(nextDue)}</strong></> : ''}. Haz la transferencia por SINPE y después regístrala aquí con la foto o el PDF de tu banco; te guiamos paso a paso.</p><div class="portal-copy-row"><a class="portal-button" href="/portal/pagos/nuevo">Registrar mi pago <span aria-hidden="true">→</span></a></div></section>}
  {actionNeeded.length === 0 && dashboard.athletes.length > 0 && dashboard.balanceMinor === 0 && dashboard.pendingMinor > 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">¿Qué hago ahora?</h2><p>Nada por el momento: la Asociación está comprobando tu pago de <strong>{money(dashboard.pendingMinor)}</strong> en el banco. Cuando se confirme, el comprobante aparecerá en esta página.</p></section>}
  {actionNeeded.length === 0 && dashboard.athletes.length > 0 && dashboard.balanceMinor === 0 && dashboard.pendingMinor === 0 && dashboard.charges.length > 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">Estás al día.</h2><p>No debes nada y no hay pagos en revisión. Tus comprobantes están abajo, en esta misma página.</p></section>}
  <dl class="portal-stats"><div class:list={['portal-stat', 'portal-stat-primary', { 'portal-stat-zero': dashboard.balanceMinor === 0 }]}><dt>Saldo pendiente</dt><dd>{money(dashboard.balanceMinor)}</dd>{dashboard.balanceMinor > 0 && nextDue ? <p>Vence el <strong>{dateLabel(nextDue)}</strong>. Se actualiza tras la verificación bancaria.</p> : dashboard.charges.length > 0 ? <p>No tienes saldo pendiente. Estás al día.</p> : <p>Mensualidades pendientes de confirmación.</p>}</div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.pendingMinor === 0 }]}><dt>Pagos en revisión</dt><dd>{money(dashboard.pendingMinor)}</dd><p>La Asociación los está comprobando en el banco; todavía no bajan tu saldo.</p></div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.creditMinor === 0 }]}><dt>Saldo a favor</dt><dd>{money(dashboard.creditMinor)}</dd><p>Pagaste de más: queda guardado y se aplica a tus próximas mensualidades. No se pierde.</p></div></dl>
  <section class="portal-section"><div class="portal-section-heading"><h2>Tus atletas</h2><p>Los atletas que ves con tu cuenta.</p></div>{dashboard.athletes.length ? <div class="portal-athletes">{dashboard.athletes.map(athlete => { const balance = athleteBalance(athlete.id); return <article class="portal-athlete"><div><h3>{athlete.name}</h3><p>{athlete.category} · {athlete.active ? 'Inscripción activa' : 'Inscripción inactiva'}</p></div><div class:list={['portal-athlete-balance', balance > 0 ? 'is-due' : 'is-clear']}><strong>{money(balance)}</strong><span>{balance > 0 ? 'Saldo pendiente' : 'Al día'}</span></div></article>; })}</div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>Tu cuenta aún no tiene atletas.</h3><p>Toca tu enlace de invitación en este teléfono y aparecen aquí. <a class="portal-link" href="/portal/invitacion">Pegarlo manualmente <span aria-hidden="true">→</span></a> o <a class="portal-link" href="https://wa.me/50687686102">pedirlo por WhatsApp <span aria-hidden="true">↗</span></a>.</p></div></div>}</section>
  {upcomingEvents.length > 0 && <section class="portal-section"><div class="portal-section-heading"><h2>Próximos eventos</h2><a class="portal-link" href="/portal/eventos">Ver el calendario <span aria-hidden="true">→</span></a></div><div class="portal-event-list">{upcomingEvents.map((o) => <EventCard occurrence={o} />)}</div></section>}
  <section class="portal-section"><div class="portal-section-heading"><h2>Mensualidades</h2><p>Lo que debes cada mes. «Confirmado» es lo que ya se comprobó en el banco.</p></div>{dashboard.charges.length ? <div class="portal-table-wrap" role="region" aria-label="Mensualidades; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Mensualidades, pagos confirmados y saldo</caption><thead><tr><th scope="col">Atleta / mes</th><th scope="col" class="portal-num-head">Mensualidad</th><th scope="col" class="portal-num-head">Confirmado</th><th scope="col" class="portal-num-head">Saldo</th></tr></thead><tbody>{dashboard.charges.map(charge => <tr><th scope="row">{charge.athleteName}<span class="portal-subtext">{monthLabel(charge.period)} · vence {dateLabel(charge.dueDate)}</span></th><td class="portal-number" data-label="Mensualidad">{money(charge.totalMinor)}{charge.discountMinor > 0 && <span class="portal-subtext">Descuento {money(charge.discountMinor)} · {charge.discountReason}</span>}</td><td class="portal-number" data-label="Confirmado">{money(charge.paidMinor)}</td><td class="portal-number" data-label="Saldo">{money(charge.balanceMinor)}</td></tr>)}</tbody></table></div> : <p class="portal-section-caption">Todavía no hay mensualidades publicadas para tus atletas. Aparecen aquí al inicio de cada mes.</p>}</section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Pagos registrados</h2><a class="portal-link" href="/portal/pagos/nuevo">Registrar pago <span aria-hidden="true">→</span></a></div><PaymentsTable payments={dashboard.payments} allowedReceiptIds={new Set(dashboard.receipts.map(receipt => receipt.id))} /></section>
  <section class="portal-section"><div class="portal-section-heading"><h2>Comprobantes</h2><p>Disponibles después de verificar el ingreso en el banco.</p></div>{dashboard.receipts.length ? <div class="portal-table-wrap" role="region" aria-label="Comprobantes; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Comprobantes emitidos y estado del correo</caption><thead><tr><th scope="col">Comprobante</th><th scope="col" class="portal-num-head">Total</th><th scope="col">Correo</th><th scope="col">Documento</th></tr></thead><tbody>{dashboard.receipts.map(receipt => <tr><th scope="row">{receipt.number}<span class="portal-subtext">{dateLabel(receipt.snapshot.issuedAt)}{receipt.status === 'void' ? ' · Anulado' : ''}</span></th><td class="portal-number" data-label="Total">{money(receipt.snapshot.amountMinor)}</td><td data-label="Correo">{receipt.status === 'void' ? '—' : familyEmailLabels[receipt.emailStatus ?? 'pending'] ?? 'Aún no enviado'}{receipt.status !== 'void' && receipt.emailStatus !== 'accepted' && receipt.emailStatus !== 'sent' && <span class="portal-subtext">Tu comprobante sigue disponible aquí.</span>}</td><td data-label="Documento"><a class="portal-link" href={`/portal/comprobantes/${receipt.id}`} aria-label={`Abrir comprobante ${receipt.number}`}>Abrir comprobante <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div> : <p class="portal-section-caption">Tus comprobantes aparecerán aquí cuando se confirme un pago.</p>}</section>
</PortalLayout>
