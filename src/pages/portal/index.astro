---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHeader from '../../components/portal/PageHeader.astro';
import PaymentsTable from '../../components/portal/PaymentsTable.astro';
import FamilyReceipts from '../../components/portal/FamilyReceipts.astro';
import { money, dateTimeLabel, dayLabel, fileKindLabel, dueLabel, dueState, monthLabel } from '../../components/portal/format';
import { authorizePortal } from '../../lib/portal/access';
import { resolveBusinessConfiguration } from '../../lib/portal/business-config';
import { getParentDashboard, getPaymentDetail } from '../../lib/portal/domain';
import { listEmailDrafts } from '../../lib/portal/slip-upload';
import { upcomingOccurrences } from '../../lib/portal/events';
import EventAgenda from '../../components/portal/EventAgenda.astro';
import ChargesTable from '../../components/portal/ChargesTable.astro';
import DiscardDraft from '../../components/portal/DiscardDraft.astro';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const business = resolveBusinessConfiguration(Astro.request, env);
const dashboard = await getParentDashboard(env.DB, actor);
const emailDrafts = await listEmailDrafts(env, actor).catch(() => []);
const earliestDraftExpiry = emailDrafts.reduce<string | null>((earliest, draft) => earliest === null || draft.expiresAt < earliest ? draft.expiresAt : earliest, null);
const upcomingEvents = await upcomingOccurrences(env.DB, actor, 3).catch(() => []);
const actionNeeded = dashboard.payments.filter(payment => payment.status === 'needs_info');
const openCharges = dashboard.charges.filter(charge => charge.balanceMinor > 0);
const settledCharges = dashboard.charges.filter(charge => charge.balanceMinor <= 0);
const nextDue = openCharges.reduce<string | null>((earliest, charge) => earliest === null || charge.dueDate < earliest ? charge.dueDate : earliest, null);
const athleteBalance = (athleteId: string) => dashboard.charges.filter(charge => charge.athleteId === athleteId).reduce((total, charge) => total + charge.balanceMinor, 0);
const todayCR = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Costa_Rica', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const currentPeriod = todayCR.slice(0, 7);
const dueNowMinor = openCharges.filter(charge => charge.period <= currentPeriod).reduce((total, charge) => total + charge.balanceMinor, 0);
const futureMinor = openCharges.filter(charge => charge.period > currentPeriod).reduce((total, charge) => total + charge.balanceMinor, 0);
const overdueCount = openCharges.filter(charge => dueState(charge.dueDate, todayCR).kind === 'overdue').length;
// Months already paid by a transfer in review are not shown as overdue (coveredIds is set below, before render).
const athleteOverdue = (athleteId: string) => openCharges.filter(charge => charge.athleteId === athleteId && dueState(charge.dueDate, todayCR).kind === 'overdue' && !coveredIds.has(charge.id)).reduce((total, charge) => total + charge.balanceMinor, 0);
const importantPayments = dashboard.payments.filter(payment => ['pending', 'needs_info', 'rejected'].includes(payment.status) || (payment.status === 'verified' && payment.unallocatedMinor > 0));
const settledPayments = dashboard.payments.filter(payment => !importantPayments.includes(payment));
const visiblePayments = [...importantPayments, ...settledPayments.slice(0, 3)];
const olderPayments = settledPayments.slice(3);
const receiptIds = new Set(dashboard.receipts.map(receipt => receipt.id));
// What is still owed today once the months named by payments in review are set
// aside, so the panel never asks for money already sent, nor hides what is not.
// Unknown coverage (too many payments, or one this account cannot open) keeps
// the cautious answer: wait for the review.
const inReview = dashboard.payments.filter(payment => payment.status === 'pending' || payment.status === 'needs_info');
const reviewCoverage = new Map<string, number>();
let coverageKnown = inReview.length <= 6;
if (coverageKnown && inReview.length > 0) {
  const details = await Promise.all(inReview.map(payment => getPaymentDetail(env.DB, actor, payment.id).catch(() => null)));
  for (const detail of details) {
    if (!detail) { coverageKnown = false; break; }
    detail.requestedAllocations.forEach(allocation => reviewCoverage.set(allocation.chargeId, (reviewCoverage.get(allocation.chargeId) ?? 0) + allocation.amountMinor));
  }
}
const uncovered = (charge: { id: string; balanceMinor: number }) => Math.max(0, charge.balanceMinor - (reviewCoverage.get(charge.id) ?? 0));
const stillDueCharges = coverageKnown ? openCharges.filter(charge => charge.period <= currentPeriod && uncovered(charge) > 0) : dashboard.pendingMinor > 0 ? [] : openCharges.filter(charge => charge.period <= currentPeriod);
const stillDueMinor = stillDueCharges.reduce((total, charge) => total + (coverageKnown ? uncovered(charge) : charge.balanceMinor), 0);
const stillDueDate = stillDueCharges.reduce<string | null>((earliest, charge) => earliest === null || charge.dueDate < earliest ? charge.dueDate : earliest, null);
const nextFutureDue = openCharges.filter(charge => charge.period > currentPeriod).reduce<string | null>((earliest, charge) => earliest === null || charge.dueDate < earliest ? charge.dueDate : earliest, null);
const firstName = (actor.name ?? '').trim().split(/\s+/)[0] ?? '';
const greeting = firstName && !firstName.includes('@') ? `Hola, ${firstName}.` : 'Tu cuenta.';
const nextStepReady = actionNeeded.length === 0 && dashboard.athletes.length > 0;
// Files the family emailed that could not become a payment by themselves. Soonest to expire first.
// With no month owed there is nowhere to register them: that is not a task, so it must not read like one.
const draftsByExpiry = [...emailDrafts].sort((a, b) => a.expiresAt.localeCompare(b.expiresAt));
const draftCount = emailDrafts.length;
const canFinishDrafts = openCharges.length > 0;
const canCorrectPayment = Boolean(actionNeeded[0]?.canOpenDetail);
const draftsActionable = draftCount > 0 && (canFinishDrafts || canCorrectPayment);
const coveredIds = new Set(coverageKnown ? openCharges.filter(charge => (reviewCoverage.get(charge.id) ?? 0) >= charge.balanceMinor).map(charge => charge.id) : []);
const overdueUncovered = openCharges.filter(charge => dueState(charge.dueDate, todayCR).kind === 'overdue' && !coveredIds.has(charge.id)).length;
const stillDueMonths = [...new Set(stillDueCharges.map(charge => charge.period))].sort().map(monthLabel);
---
<PortalLayout title="Mi cuenta" actor={actor} active="overview">
  <PageHeader title={greeting} eyebrow="Cuenta familiar" />
  {actionNeeded.length > 0 && <div class="portal-alert" role="alert"><span class="checker-mark" aria-hidden="true"></span><div class="portal-alert-text"><strong>{actionNeeded.length === 1 ? 'Un pago necesita tu atención.' : `${actionNeeded.length} pagos necesitan tu atención.`}</strong><p>La Asociación pidió información adicional{actionNeeded[0]?.reviewNote ? `: ${actionNeeded[0].reviewNote}` : ' para completar la revisión.'}</p></div>{actionNeeded[0]?.canOpenDetail && <a class="portal-button portal-button-secondary" href={`/portal/pagos/${actionNeeded[0].id}`}>Completar información <span aria-hidden="true">→</span></a>}</div>}
  {actionNeeded.length === 0 && dashboard.athletes.length === 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">¿Qué hago ahora?</h2><p>Tu cuenta ya existe, pero todavía no vemos atletas en ella. Toca en este teléfono el <strong>enlace de invitación</strong> que envía la Asociación y aparecen al instante.</p><div class="portal-copy-row"><a class="portal-button" href="/portal/invitacion">Ya tengo mi enlace <span aria-hidden="true">→</span></a><a class="portal-button portal-button-secondary" href="https://wa.me/50687686102">Pedirlo por WhatsApp <span aria-hidden="true">↗</span></a></div></section>}
  {draftsActionable && <section class="portal-next-step is-calm" aria-labelledby="email-drafts-title"><h2 id="email-drafts-title">{draftCount === 1 ? 'Falta terminar un comprobante.' : `Faltan por terminar ${draftCount} comprobantes.`}</h2><p>{draftCount === 1 ? 'Lo enviaste por correo y no pudimos registrarlo solo: todavía no cuenta como pago.' : 'Los enviaste por correo y no pudimos registrarlos solos: todavía no cuentan como pago.'}{canFinishDrafts ? (draftCount === 1 ? ' Si ya transferiste, termínalo en vez de pagar otra vez.' : ' Si ya transferiste, termínalos en vez de pagar otra vez.') : ''}</p>{canFinishDrafts && (draftCount === 1 ? <div class="portal-copy-row"><a class="portal-button" href={`/portal/pagos/nuevo?correo=${encodeURIComponent(emailDrafts[0].id)}`}>Terminarlo ahora <span aria-hidden="true">→</span></a><DiscardDraft id={emailDrafts[0].id} label="Descartarlo" /></div> : <ul class="portal-draft-list">{draftsByExpiry.map(draft => <li><div><strong>Recibido el {dateTimeLabel(draft.createdAt)}</strong><span>{fileKindLabel(draft.type)} · vence el {dayLabel(draft.expiresAt)}</span></div><div class="portal-draft-actions"><a class="portal-link" href={`/portal/pagos/nuevo?correo=${encodeURIComponent(draft.id)}`} aria-label={`Terminar el comprobante recibido el ${dateTimeLabel(draft.createdAt)}`}>Terminar <span aria-hidden="true">→</span></a><DiscardDraft id={draft.id} /></div></li>)}</ul>)}{canFinishDrafts && draftCount === 1 && earliestDraftExpiry && <p class="portal-next-aside">Vence el {dayLabel(earliestDraftExpiry)}.</p>}{canCorrectPayment && <><p class="portal-next-aside">Si es la corrección de un pago, ábrelo desde ese pago.</p><div class="portal-copy-row"><a class={canFinishDrafts ? 'portal-button portal-button-secondary' : 'portal-button'} href={`/portal/pagos/${actionNeeded[0].id}?correo=${encodeURIComponent(emailDrafts[0].id)}`}>Completar ese pago <span aria-hidden="true">→</span></a></div></>}</section>}
  {nextStepReady && stillDueMinor > 0 && <section class="portal-next-step" aria-labelledby="next-step-title"><h2 id="next-step-title">{dashboard.pendingMinor > 0 ? 'Te falta pagar' : 'Te toca pagar'} <strong class="portal-next-figure">{money(stillDueMinor)}</strong></h2><p>{stillDueMonths.length > 1 ? 'Mensualidades de ' : 'Mensualidad de '}{stillDueMonths.join(' y ')}{stillDueDate ? <> · <strong>{dueLabel(stillDueDate, todayCR).toLowerCase()}</strong></> : ''}.</p>{dashboard.pendingMinor > 0 && <p class="portal-next-aside">Ya tienes {money(dashboard.pendingMinor)} en revisión: eso no lo vuelvas a transferir.</p>}{business && <div class="portal-pay-to" data-copy-scope><div class="portal-pay-to-body"><p class="portal-pay-to-label">1 · Transfiere a</p><p class="portal-pay-to-value">{business.paymentDestination}</p><p class="portal-pay-to-note">En el detalle de SINPE escribe el <strong>nombre completo del atleta</strong>.</p></div><div class="portal-pay-to-action"><button class="portal-button portal-button-secondary" type="button" data-copy-value={business.paymentDestination}>Copiar destino</button><span class="portal-copy-feedback" data-copy-feedback role="status"></span></div></div>}<div class="portal-copy-row"><a class="portal-button" href="/portal/pagos/nuevo">{business ? '2 · ' : ''}Registrar mi pago <span aria-hidden="true">→</span></a></div></section>}
  {nextStepReady && stillDueMinor === 0 && dashboard.pendingMinor > 0 && <section class="portal-next-step is-calm" aria-labelledby="next-step-title"><h2 id="next-step-title">{inReview.length === 1 ? 'Tu pago está en revisión.' : 'Tus pagos están en revisión.'}</h2><p>{coverageKnown ? 'Cubre lo que vence ahora. ' : ''}No lo transfieras otra vez: tu saldo y tu comprobante se actualizan aquí cuando el banco lo confirme.</p><div class="portal-copy-row"><a class="portal-button portal-button-secondary" href={inReview.length === 1 && inReview[0].canOpenDetail ? `/portal/pagos/${inReview[0].id}` : '#pagos'}>{inReview.length === 1 ? 'Ver mi pago' : 'Ver mis pagos'} <span aria-hidden="true">→</span></a></div></section>}
  {nextStepReady && stillDueMinor === 0 && dashboard.pendingMinor === 0 && dashboard.balanceMinor > 0 && <section class="portal-next-step is-done" aria-labelledby="next-step-title"><h2 id="next-step-title">Estás al día.</h2><p>Lo próximo: <strong>{money(futureMinor)}</strong>{nextFutureDue ? <>, {dueLabel(nextFutureDue, todayCR).toLowerCase()}</> : ''}. Puedes adelantarlo si quieres.</p><div class="portal-copy-row"><a class="portal-button portal-button-secondary" href="/portal/pagos/nuevo">Adelantar el pago <span aria-hidden="true">→</span></a></div></section>}
  {nextStepReady && dashboard.balanceMinor === 0 && dashboard.pendingMinor === 0 && dashboard.charges.length > 0 && <section class="portal-next-step is-done" aria-labelledby="next-step-title"><h2 id="next-step-title">Estás al día.</h2><p>No debes nada. Tus comprobantes están abajo.</p></section>}
  {draftCount > 0 && !draftsActionable && <section class="portal-next-step is-calm" aria-labelledby="email-drafts-title"><h2 id="email-drafts-title">{draftCount === 1 ? 'Recibimos un comprobante por correo.' : `Recibimos ${draftCount} comprobantes por correo.`}</h2><p>{draftCount === 1 ? 'No hay mensualidad pendiente donde registrarlo, así que' : 'No hay mensualidad pendiente donde registrarlos, así que'} <strong>no tienes que hacer nada</strong>.</p><p class="portal-next-aside">{draftCount === 1 ? 'Si era un pago adelantado, regístralo cuando se publique la próxima mensualidad.' : 'Si eran pagos adelantados, regístralos cuando se publique la próxima mensualidad.'} {draftCount === 1 ? 'Vence' : 'El primero vence'} el {dayLabel(draftsByExpiry[0].expiresAt)}; si {draftCount === 1 ? 'vence' : 'vencen'} antes, {draftCount === 1 ? 'envíalo' : 'envíalos'} otra vez.</p><details class="portal-history"><summary>Ver {draftCount === 1 ? 'el archivo' : `los ${draftCount} archivos`}</summary><ul class="portal-draft-list">{draftsByExpiry.map(draft => <li><div><strong>Recibido el {dateTimeLabel(draft.createdAt)}</strong><span>{fileKindLabel(draft.type)} · vence el {dayLabel(draft.expiresAt)}</span></div><DiscardDraft id={draft.id} /></li>)}</ul></details></section>}
  <nav class="portal-subnav" aria-label="Secciones de mi cuenta"><a href="#atletas">Tus atletas</a><a href="#mensualidades">Mensualidades</a><a href="#pagos">Pagos</a><a href="#comprobantes">Comprobantes</a></nav>
  <dl class="portal-stats"><div class:list={['portal-stat', 'portal-stat-primary', { 'portal-stat-zero': dashboard.balanceMinor === 0 }]}><dt>Saldo pendiente</dt><dd>{money(dashboard.balanceMinor)}</dd>{dashboard.balanceMinor > 0 && nextDue ? <dd class="portal-stat-note">{overdueUncovered > 0 ? <><strong>{overdueUncovered} {overdueUncovered === 1 ? 'mensualidad vencida' : 'mensualidades vencidas'}</strong>. </> : overdueCount > 0 ? <>Lo vencido ya está en revisión. </> : <><strong>{dueLabel(nextDue, todayCR)}</strong>. </>}{futureMinor > 0 && dueNowMinor > 0 ? <>Incluye {money(futureMinor)} que {nextFutureDue ? dueLabel(nextFutureDue, todayCR).toLowerCase() : 'vence el próximo mes'}.</> : ''}</dd> : dashboard.charges.length > 0 ? <dd class="portal-stat-note">No tienes saldo pendiente. Estás al día.</dd> : <dd class="portal-stat-note">Mensualidades pendientes de confirmación.</dd>}</div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.pendingMinor === 0 }]}><dt>Pagos en revisión</dt><dd>{money(dashboard.pendingMinor)}</dd><dd class="portal-stat-note">La Asociación los está comprobando en el banco; todavía no bajan tu saldo.</dd></div><div class:list={['portal-stat', { 'portal-stat-zero': dashboard.creditMinor === 0 }]}><dt>Saldo a favor</dt><dd>{money(dashboard.creditMinor)}</dd><dd class="portal-stat-note">Pagaste de más: queda guardado y se aplica a tus próximas mensualidades. No se pierde.</dd></div></dl>
  <section class="portal-section" id="atletas"><div class="portal-section-heading"><h2>Tus atletas</h2>{dashboard.athletes.length ? <a class="portal-link" href="/portal/inscribir#compartir">Compartir acceso <span aria-hidden="true">→</span></a> : <p>Los atletas que ves con tu cuenta.</p>}</div>{dashboard.athletes.length ? <div class="portal-athletes">{dashboard.athletes.map(athlete => { const balance = athleteBalance(athlete.id); return <article class="portal-athlete"><div><h3>{athlete.name}</h3><p>{athlete.category}{athlete.active ? '' : ' · Inscripción inactiva'}</p></div><div class:list={['portal-athlete-balance', balance === 0 ? 'is-clear' : athleteOverdue(athlete.id) ? 'is-due' : undefined]}><strong>{money(balance)}</strong><span>{balance === 0 ? 'Al día' : 'Saldo pendiente'}</span>{athleteOverdue(athlete.id) > 0 && <p>{money(athleteOverdue(athlete.id))} vencidos</p>}{balance > 0 && <a class="portal-link" href={`/portal/pagos/nuevo?atleta=${encodeURIComponent(athlete.id)}#allocation-group`} aria-label={`Pagar mensualidades de ${athlete.name}`}>Pagar <span aria-hidden="true">→</span></a>}</div></article>; })}</div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>Tu cuenta aún no tiene atletas.</h3><p>Toca tu enlace de invitación en este teléfono y aparecen aquí. <a class="portal-link" href="/portal/invitacion">Pegarlo manualmente <span aria-hidden="true">→</span></a> o <a class="portal-link" href="https://wa.me/50687686102">pedirlo por WhatsApp <span aria-hidden="true">↗</span></a>.</p></div></div>}</section>
  {upcomingEvents.length > 0 && <section class="portal-section"><div class="portal-section-heading"><h2>Próximos eventos</h2><a class="portal-link" href="/portal/eventos">Ver el calendario <span aria-hidden="true">→</span></a></div><EventAgenda occurrences={upcomingEvents} nowIso={new Date().toISOString()} /></section>}
  <section class="portal-section" id="mensualidades"><div class="portal-section-heading"><h2>Mensualidades</h2><p>Vencen el día 8 de cada mes. «Confirmado» es lo que ya se comprobó en el banco.</p></div>{dashboard.charges.length ? <>{openCharges.length ? <ChargesTable charges={openCharges} todayCR={todayCR} covered={coveredIds} caption="Mensualidades pendientes, pagos confirmados y saldo" label="Mensualidades pendientes; desplázate para ver todas las columnas" /> : <p class="portal-section-caption">Estás al día: no debes ninguna mensualidad publicada.</p>}{settledCharges.length > 0 && <details class="portal-history"><summary>Ver {settledCharges.length} {settledCharges.length === 1 ? 'mensualidad pagada' : 'mensualidades pagadas'}</summary><ChargesTable charges={settledCharges} todayCR={todayCR} caption="Mensualidades ya pagadas" label="Mensualidades pagadas; desplázate para ver todas las columnas" /></details>}</> : <p class="portal-section-caption">Todavía no hay mensualidades publicadas para tus atletas. Aparecen aquí al inicio de cada mes.</p>}</section>
  <section class="portal-section" id="pagos"><div class="portal-section-heading"><h2>Pagos registrados</h2><a class="portal-link" href="/portal/pagos/nuevo">Registrar pago <span aria-hidden="true">→</span></a></div><PaymentsTable payments={visiblePayments} allowedReceiptIds={receiptIds} />{olderPayments.length > 0 && <details class="portal-history"><summary>Ver {olderPayments.length} pagos resueltos anteriores</summary><PaymentsTable payments={olderPayments} allowedReceiptIds={receiptIds} label="Pagos resueltos anteriores; desplázate para ver todas las columnas" caption="Pagos resueltos anteriores y su estado" /></details>}</section>
  <section class="portal-section" id="comprobantes"><div class="portal-section-heading"><h2>Comprobantes</h2><p>El comprobante oficial aparece aquí cuando se confirma el pago en el banco.</p></div><FamilyReceipts receipts={dashboard.receipts.slice(0, 5)} />{dashboard.receipts.length > 5 && <details class="portal-history"><summary>Ver {dashboard.receipts.length - 5} comprobantes anteriores</summary><FamilyReceipts receipts={dashboard.receipts.slice(5)} label="Comprobantes anteriores" caption="Comprobantes anteriores y estado del correo" /></details>}</section>
</PortalLayout>
