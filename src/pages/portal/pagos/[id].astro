---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHeader from '../../../components/portal/PageHeader.astro';
import ChargeAllocator from '../../../components/portal/ChargeAllocator.astro';
import PaymentHistory from '../../../components/portal/PaymentHistory.astro';
import EvidenceViewer from '../../../components/portal/EvidenceViewer.astro';
import SlipUploader from '../../../components/portal/SlipUploader.astro';
import DateInput from '../../../components/portal/DateInput.astro';
import OcrReview from '../../../components/portal/OcrReview.astro';
import { money, plainMoney, dateLabel, paymentLabels, monthLabel, referenceLabel } from '../../../components/portal/format';
import { authorizePortal } from '../../../lib/portal/access';
import { getPaymentDetail, getParentDashboard, getChargesForAdult, listFamilies } from '../../../lib/portal/domain';
import { getPaymentExtractions } from '../../../lib/portal/ocr';
import { getOcrAvailability } from '../../../lib/portal/ocr-policy';
import { allowPortalDemo } from '../../../lib/portal/demo-policy';
import { portalMessagePage } from '../../../lib/portal/http';
import type { PaymentDetail } from '../../../lib/portal/types';
import { resolveBusinessConfiguration } from '../../../lib/portal/business-config';
import { listEmailDrafts } from '../../../lib/portal/slip-upload';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const businessReady = Boolean(resolveBusinessConfiguration(Astro.request, env));
let detail: PaymentDetail;
try { detail = await getPaymentDetail(env.DB, actor, Astro.params.id ?? ''); } catch { return portalMessagePage('Pago no disponible.', 'No encontramos ese pago o ya no está disponible para tu cuenta. Tus pagos registrados están en tu cuenta.', 404); }
const { payment } = detail;
const extractions = await getPaymentExtractions(env.DB,actor,payment.id);
const ocr = getOcrAvailability(actor,env,{demoAllowed:allowPortalDemo(Astro.url,import.meta.env.DEV,env)});
const canRevise = payment.status === 'needs_info' && (actor.isAdmin || actor.id === payment.submitterId);
const dashboard = canRevise && !actor.isAdmin ? await getParentDashboard(env.DB,actor) : null;
const designatedFamily = canRevise && actor.isAdmin ? (await listFamilies(env.DB)).find(family => family.adultId === payment.designatedAdultId) : null;
const charges = canRevise ? (actor.isAdmin ? await getChargesForAdult(env.DB,actor,payment.designatedAdultId) : dashboard?.charges ?? []) : [];
const athletes = (designatedFamily?.athletes ?? dashboard?.athletes ?? []).map(({id,name}) => ({id,name}));
const requested = Object.fromEntries(detail.requestedAllocations.map(allocation => [allocation.chargeId,allocation.amountMinor]));
const emailDrafts = canRevise ? await listEmailDrafts(env, actor).catch(() => []) : [];
---
<PortalLayout title="Detalle del pago" actor={actor} active="overview">
  <PageHeader title={paymentLabels[payment.status] ?? 'Detalle del pago'} eyebrow="Transferencia registrada" backHref="/portal" backLabel="Volver a mi cuenta" description={payment.status === 'pending' ? `La Asociación revisará los datos y comprobará el ingreso en el banco. El saldo de las mensualidades conserva su valor hasta confirmar el pago de ${money(payment.amountMinor)} del ${dateLabel(payment.transferDate)}.` : payment.status === 'needs_info' ? (payment.reviewNote ?? 'La Asociación necesita información adicional para completar la revisión. Completa el formulario de esta página.') : `${money(payment.verifiedAmountMinor ?? payment.amountMinor)} · ${dateLabel(payment.transferDate)} · Ref. ${referenceLabel(payment.bankReference)}${payment.reviewNote ? ` — ${payment.reviewNote}` : ''}`}>{detail.receipt && <a class="portal-button" href={`/portal/comprobantes/${detail.receipt.id}`}>Abrir comprobante <span aria-hidden="true">↗</span></a>}</PageHeader>
  <div class="portal-two-columns"><section class="portal-panel">
    <div class="portal-guidance portal-guidance-strong"><h3>¿Qué hago ahora?</h3>
      {payment.status === 'pending' && <p>Nada: la Asociación está comprobando tu transferencia en el banco. Tu saldo se actualiza cuando se confirme y el comprobante oficial aparecerá aquí y en tu cuenta. Si falta algún dato, te lo pedimos en esta misma página.</p>}
      {payment.status === 'needs_info' && canRevise && <p>Completa el formulario de abajo con lo que pidió la Asociación{payment.reviewNote ? <>: <strong>{payment.reviewNote}</strong></> : ''} y envíalo. Tu pago vuelve a revisión de inmediato.</p>}
      {payment.status === 'needs_info' && !canRevise && <p>Solo puede corregirlo <strong>la persona que registró este pago</strong> con su propia cuenta{payment.reviewNote ? <>. Esto es lo que se pidió: <strong>{payment.reviewNote}</strong></> : ''}. Avísale que entre a su cuenta y abra este pago. Si esa persona ya no puede entrar, <a class="portal-link" href="https://wa.me/50687686102">escríbenos por WhatsApp <span aria-hidden="true">↗</span></a>.</p>}
      {payment.status === 'verified' && <p>Ya está confirmado en el banco. {detail.receipt ? 'Tu comprobante oficial está con el botón de arriba.' : 'El comprobante aparecerá en tu cuenta.'} No necesitas hacer nada más.</p>}
      {payment.status === 'rejected' && <p>Este pago no se pudo aceptar{payment.reviewNote ? <>: <strong>{payment.reviewNote}</strong></> : ''}. Revisa el motivo: si la transferencia sí se hizo, registra el pago de nuevo con los datos correctos; si tienes dudas, <a class="portal-link" href="https://wa.me/50687686102">consúltanos por WhatsApp <span aria-hidden="true">↗</span></a> antes de transferir otra vez.</p>}
      {payment.status === 'void' && <p>Este pago se anuló{payment.reviewNote ? <>: <strong>{payment.reviewNote}</strong></> : ''}. El monto volvió a aparecer como saldo pendiente. Si necesitas pagarlo de nuevo, registra una transferencia nueva; ante cualquier duda, <a class="portal-link" href="https://wa.me/50687686102">escríbenos por WhatsApp <span aria-hidden="true">↗</span></a>.</p>}
      {(payment.status === 'rejected' || payment.status === 'void') && <p style="margin-top:14px"><a class="portal-button" href="/portal/pagos/nuevo">Registrar un pago nuevo <span aria-hidden="true">→</span></a></p>}
    </div>
    <h2>Datos de la transferencia</h2><dl class="portal-detail-list"><div><dt>Pagado por</dt><dd>{payment.payerName}</dd></div><div><dt>Monto registrado</dt><dd>{money(payment.amountMinor)}</dd></div>{payment.verifiedAmountMinor !== null && <div><dt>Monto confirmado</dt><dd>{money(payment.verifiedAmountMinor)}</dd></div>}<div><dt>Fecha</dt><dd>{dateLabel(payment.transferDate)}</dd></div><div><dt>Referencia</dt><dd>{referenceLabel(payment.bankReference)}</dd></div><div><dt>Estado</dt><dd><span class:list={['portal-status',`portal-status-${payment.status}`]}>{paymentLabels[payment.status]}</span></dd></div></dl>
    {detail.requestedAllocations.length > 0 && <section class="portal-section"><h2>Mensualidades indicadas</h2><dl class="portal-detail-list">{detail.requestedAllocations.map(allocation => <div><dt>{allocation.athleteName}<br />{monthLabel(allocation.period)}</dt><dd>{money(allocation.amountMinor)}</dd></div>)}</dl></section>}
    {canRevise && <form class="portal-form" action={`/api/portal/payments/${payment.id}/revise`} method="post" enctype="multipart/form-data" data-unsaved-guard data-draft-key={`corregir-${payment.id}`}>
      <input type="hidden" name="expectedRevision" value={payment.revision} /><input type="hidden" name="expectedStatus" value={payment.status} /><input type="hidden" name="expectedReviewNote" value={payment.reviewNote ?? ''} />
      <h2>Completar información</h2><p class="portal-help">{payment.reviewNote ?? 'Actualiza los datos solicitados por la Asociación.'}</p>
      <p class="portal-help">{actor.isAdmin ? <>Si el archivo nuevo está en tu correo de administración, envíalo a <strong>pagos@recibir.ajedrezbelen.com</strong> desde <strong>{actor.email}</strong> y actualiza esta página. Aparece en «Archivos enviados desde tu correo de administración», no entre los de la familia.</> : <>Si el archivo nuevo lo tienes en el correo, envíalo a <strong>pagos@recibir.ajedrezbelen.com</strong> desde <strong>{actor.email}</strong> (un JPG, PNG o PDF de hasta 3 MB) y actualiza esta página: aparecerá en «Archivos que nos enviaste por correo».</>}</p>
      <SlipUploader mode={ocr.mode} available={ocr.available && businessReady} eagerUpload={businessReady} athletes={athletes} required={false} savedDrafts={emailDrafts} savedLabel={actor.isAdmin ? 'Archivos enviados desde tu correo de administración' : undefined} savedHelp={actor.isAdmin ? 'Son los comprobantes que enviaste tú a pagos@recibir.ajedrezbelen.com desde el correo de esta cuenta, no los de la familia. Si eliges uno, se usa ese archivo y se descarta cualquier otro que hubieras seleccionado.' : undefined} />
      <div class="portal-field"><label for="payer-name">Nombre de quien transfirió</label><input id="payer-name" name="payerName" value={payment.payerName} type="text" maxlength="160" autocomplete="name" placeholder="Nombre y apellidos…" required /></div>
      <div class="portal-form-row"><div class="portal-field"><label for="amount">Monto transferido (₡)</label><input id="amount" name="amount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value={plainMoney(payment.amountMinor)} required /></div><DateInput id="transfer-date" name="transferDate" label="Fecha de transferencia" value={payment.transferDate} minYear={2020} /></div>
      <div class="portal-field"><label for="bank-reference">Referencia bancaria</label><input id="bank-reference" name="bankReference" type="text" maxlength="128" autocomplete="off" spellcheck="false" value={payment.bankReference} placeholder="Se completa al leer el comprobante" readonly aria-readonly="true" aria-describedby="reference-help" /><p id="reference-help" class="portal-help">La lectura del comprobante completa este dato. No hace falta escribirlo. Si adjuntas otro archivo, se vuelve a leer.</p></div>
      <ChargeAllocator charges={charges.filter(charge => charge.balanceMinor>0 || requested[charge.id])} values={requested} prefix="revision" />
      <div class="portal-field"><label for="revision-note">Información para la Asociación</label><textarea id="revision-note" name="note" maxlength="500" required></textarea></div>
      <button class="portal-button" type="submit" disabled={!charges.some(charge => charge.balanceMinor > 0 || requested[charge.id])}>Enviar información actualizada <span aria-hidden="true">→</span></button>
    </form>}
  </section><aside class="portal-panel">
    {detail.files.length > 0 ? <section class="portal-section"><h2>Archivo de la transferencia</h2><p class="portal-section-caption">Respaldo privado del pago. Conservamos las versiones anteriores cuando se corrige.</p>{detail.files.map((file,index) => index === 0 ? <EvidenceViewer file={file} title="Archivo actual" /> : <details class="portal-evidence-history"><summary>Archivo anterior · {dateLabel(file.createdAt)}</summary><EvidenceViewer file={file} title="Archivo anterior" /></details>)}</section> : <div class="portal-guidance"><h3>Archivo privado</h3><p>Esta cuenta puede consultar el registro del pago. El archivo de la transferencia conserva los permisos definidos al registrarlo.</p></div>}
    <OcrReview records={extractions} payment={payment} />
    <PaymentHistory detail={detail} />
    <a class="portal-link" href="/portal">Volver a mi cuenta <span aria-hidden="true">↗</span></a>
  </aside></div>
</PortalLayout>
