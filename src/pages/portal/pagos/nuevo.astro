---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHeader from '../../../components/portal/PageHeader.astro';
import ChargeAllocator from '../../../components/portal/ChargeAllocator.astro';
import SlipUploader from '../../../components/portal/SlipUploader.astro';
import { authorizePortal } from '../../../lib/portal/access';
import { getParentDashboard, getChargesForAdult, listFamilies } from '../../../lib/portal/domain';
import { getOcrAvailability } from '../../../lib/portal/ocr-policy';
import { allowPortalDemo } from '../../../lib/portal/demo-policy';
import { listEmailDrafts } from '../../../lib/portal/slip-upload';
import { resolveBusinessConfiguration } from '../../../lib/portal/business-config';
import { businessConfigurationUnavailable } from '../../../lib/portal/http';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const business = resolveBusinessConfiguration(Astro.request, env);
if (!business) return businessConfigurationUnavailable(Astro.request);
const ocr = getOcrAvailability(actor,env,{demoAllowed:allowPortalDemo(Astro.url,import.meta.env.DEV,env)});
const families = actor.isAdmin ? await listFamilies(env.DB) : [];
const selectedAdultId = actor.isAdmin ? Astro.url.searchParams.get('adult') : null;
const selectedAdult = families.find(family => family.active && family.adultId === selectedAdultId);
const staffAssisted = actor.isAdmin && selectedAdult?.adultId !== actor.id;
const dashboard = actor.isAdmin ? null : await getParentDashboard(env.DB, actor);
const allCharges = selectedAdult ? await getChargesForAdult(env.DB, actor, selectedAdult.adultId) : dashboard?.charges ?? [];
const athletes = (selectedAdult?.athletes ?? dashboard?.athletes ?? []).map(({id,name}) => ({id,name}));
const charges = allCharges.filter(charge => charge.balanceMinor > 0);
const emailDrafts = actor.isAdmin ? [] : await listEmailDrafts(env, actor).catch(() => []);
const today = new Intl.DateTimeFormat('en-CA', {timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
---
<PortalLayout title="Registrar pago" actor={actor} active="new-payment">
  <PageHeader title="Tu transferencia, en un solo lugar." eyebrow="Registrar un pago" description="Adjunta el archivo del banco, revisa los datos y elige las mensualidades. La Asociación comprobará el ingreso antes de emitir tu comprobante." />
  {actor.isAdmin && <form class="portal-month-form" action="/portal/pagos/nuevo" method="get"><div class="portal-field"><label for="adult">Registrar para una cuenta familiar</label><select id="adult" name="adult" required><option value="">Selecciona una persona</option>{families.filter(family => family.active).map(family => <option value={family.adultId} selected={selectedAdult?.adultId === family.adultId}>{family.adultName} · {family.email}</option>)}</select></div><button class="portal-button portal-button-secondary" type="submit">Elegir cuenta <span aria-hidden="true">→</span></button></form>}
  <div class="portal-two-columns">
    <section class="portal-panel"><form class="portal-form" action="/api/portal/payments" method="post" enctype="multipart/form-data">
      <input type="hidden" name="submissionId" value={crypto.randomUUID()} />
      {selectedAdult && <input type="hidden" name="designatedAdultId" value={selectedAdult.adultId} />}
      <SlipUploader mode={ocr.mode} available={ocr.available} athletes={athletes} savedDrafts={emailDrafts} />
      <div class="portal-form-step"><span aria-hidden="true">02</span><div><h2>Revisa los datos del pago.</h2><p>Completa la información o corrige las sugerencias de la lectura.</p></div></div>
      <div class="portal-field"><label for="payer-name">Nombre de quien realizó la transferencia</label><input id="payer-name" name="payerName" type="text" maxlength="160" autocomplete="name" value={selectedAdult?.adultName ?? actor.name} required /></div>
      <div class="portal-form-row"><div class="portal-field"><label for="amount">Monto transferido (₡)</label><input id="amount" name="amount" type="number" min="0.01" max="10000000" step="0.01" inputmode="decimal" required /></div><div class="portal-field"><label for="transfer-date">Fecha de la transferencia</label><input id="transfer-date" name="transferDate" type="date" max={today} value={today} required /></div></div>
      <div class="portal-field"><label for="bank-reference">Referencia bancaria</label><input id="bank-reference" name="bankReference" type="text" maxlength="128" required aria-describedby="reference-help" /><p id="reference-help" class="portal-help">Copia la referencia completa, incluidos los ceros iniciales. No uses el número de teléfono.</p></div>
      <div class="portal-form-step"><span aria-hidden="true">03</span><div><h2>Elige las mensualidades.</h2><p>Indica a qué atleta y mes corresponde cada parte del pago.</p></div></div>
      <ChargeAllocator charges={charges} />
      <p class="portal-help">Si la transferencia supera lo distribuido, la diferencia quedará como saldo a favor después de la verificación.</p>
      {actor.isAdmin && <label class="portal-checkbox"><input type="checkbox" name="shareEvidence" value="on" /><span>Permitir que la persona responsable seleccionada consulte el archivo de esta transferencia.</span></label>}
      {staffAssisted && <div class="portal-guidance"><h3>Correo para la familia seleccionada</h3>{selectedAdult ? <p>Después de verificar el ingreso en el banco, el comprobante se prepara para el correo verificado de <strong>{selectedAdult.adultName}</strong>: <strong>{selectedAdult.email}</strong>.</p> : <p>Elige arriba una cuenta familiar existente. Su persona adulta responsable será la destinataria del comprobante después de la verificación bancaria.</p>}<p>Se usa el correo registrado en esa cuenta familiar. Si no hay un correo válido y habilitado, la entrega queda retenida. La Asociación debe revisar los datos de la cuenta antes de preparar el envío.</p></div>}
      {!staffAssisted && <p class="portal-help">Después de verificar el ingreso en el banco, el comprobante se prepara únicamente para el correo verificado de la cuenta con la que registras este pago: <strong>{actor.email}</strong>.</p>}
      {actor.isAdmin && <div class="portal-field"><label for="audit-reason">Motivo del registro por administración</label><textarea id="audit-reason" name="auditReason" maxlength="500" required></textarea></div>}
      <button class="portal-button portal-button-wide" type="submit" disabled={charges.length === 0 || (actor.isAdmin && !selectedAdult)}>Enviar para revisión <span aria-hidden="true">→</span></button><p class="portal-help">Enviar este formulario registra el pago como pendiente. El comprobante de la Asociación se emite después de confirmarlo en el banco.</p>
    </form></section>
    <aside class="portal-panel"><div class="portal-guidance"><p class="portal-eyebrow">Antes de transferir</p><h3 style="margin-top:13px">Incluye el nombre del atleta.</h3><p>Escribe en el detalle de SINPE el nombre completo del atleta. Si pagas varias mensualidades, indica los nombres y el mes.</p><p><strong>Destino del pago</strong></p><p class="portal-number">{business.paymentDestination}</p><p>{business.associationName}</p></div><div class="portal-guidance"><h3>¿Prefieres enviarlo por correo?</h3><p>Envía el comprobante adjunto a <strong>pagos@recibir.ajedrezbelen.com</strong> desde el correo de tu cuenta. Aparecerá aquí listo para completar los datos del pago; tienes siete días para registrarlo.</p></div><div class="portal-guidance"><h3>De la transferencia al comprobante</h3><p>1. Realizas la transferencia y adjuntas el archivo.</p><p>2. La Asociación comprueba el ingreso en la cuenta.</p><p>3. El comprobante numerado queda disponible en el portal y el saldo se actualiza.</p></div><div class="portal-guidance"><h3>Consultas por WhatsApp</h3><p>Las respuestas a los correos automáticos del portal no se atienden. Para consultas sobre un pago, escribe a la Asociación.</p><a class="portal-link" href="https://wa.me/50687686102">Consultar por WhatsApp <span aria-hidden="true">↗</span></a></div><a class="portal-link" href={actor.isAdmin ? '/admin' : '/portal'}>Volver a la cuenta <span aria-hidden="true">↗</span></a></aside>
  </div>
</PortalLayout>
