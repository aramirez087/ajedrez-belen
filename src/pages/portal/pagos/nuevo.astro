---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHeader from '../../../components/portal/PageHeader.astro';
import ChargeAllocator from '../../../components/portal/ChargeAllocator.astro';
import SlipUploader from '../../../components/portal/SlipUploader.astro';
import DateInput from '../../../components/portal/DateInput.astro';
import { authorizePortal } from '../../../lib/portal/access';
import { getParentDashboard, getChargesForAdult, listFamilies } from '../../../lib/portal/domain';
import { getOcrAvailability } from '../../../lib/portal/ocr-policy';
import { allowPortalDemo } from '../../../lib/portal/demo-policy';
import { listEmailDrafts } from '../../../lib/portal/slip-upload';
import { resolveBusinessConfiguration } from '../../../lib/portal/business-config';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const business = resolveBusinessConfiguration(Astro.request, env);
if (!business) Astro.response.status = 503;
const ocr = business ? getOcrAvailability(actor,env,{demoAllowed:allowPortalDemo(Astro.url,import.meta.env.DEV,env)}) : { mode: 'off' as const, available: false };
const families = business && actor.isAdmin ? await listFamilies(env.DB) : [];
const selectedAdultId = actor.isAdmin ? Astro.url.searchParams.get('adult') : null;
const selectedAdult = families.find(family => family.active && family.adultId === selectedAdultId);
const ownDashboard = business ? await getParentDashboard(env.DB, actor).catch(() => null) : null;
// Dual role: an administrator defaults to paying for their own family (exactly
// like any guardian) and only switches to staff-assisted mode on request.
const staffMode = actor.isAdmin && (Astro.url.searchParams.has('adult') || Astro.url.searchParams.get('modo') === 'familia' || !(ownDashboard?.athletes.length));
const personalMode = !staffMode;
const staffAssisted = staffMode && selectedAdult?.adultId !== actor.id;
const dashboard = personalMode ? ownDashboard : null;
const allCharges = business && staffMode && selectedAdult ? await getChargesForAdult(env.DB, actor, selectedAdult.adultId) : dashboard?.charges ?? [];
const athletes = (staffMode ? selectedAdult?.athletes : dashboard?.athletes) ?? [];
const charges = allCharges.filter(charge => charge.balanceMinor > 0);
const emailDrafts = business && personalMode ? await listEmailDrafts(env, actor).catch(() => []) : [];
const today = new Intl.DateTimeFormat('en-CA', {timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
// A disabled form nobody can explain helps no one: say plainly why instead.
const noAthletes = personalMode && athletes.length === 0;
const upToDate = personalMode && athletes.length > 0 && charges.length === 0;
const showForm = !noAthletes && !upToDate;
---
<PortalLayout title="Registrar pago" actor={actor} active="new-payment">
  <PageHeader title={business ? "Registra tu transferencia." : "El registro de pagos está en pausa."} eyebrow="Registrar un pago" description={business ? "Son tres pasos cortos: adjuntas la foto o el PDF de tu banco, confirmas el monto y eliges qué mensualidad pagas. Después la Asociación comprueba el ingreso y te emite el comprobante." : "La Asociación está confirmando la configuración de cobro. Tu cuenta y tus comprobantes siguen disponibles."} />
  {!business && <div class="portal-two-columns"><section class="portal-panel"><div class="portal-guidance portal-guidance-strong"><h2>Qué significa esta pausa</h2><p>Por ahora no es posible registrar ni confirmar transferencias nuevas mientras la Asociación confirma la configuración de cobro. No realices una transferencia nueva con datos anteriores sin confirmarlo antes.</p><p>Tu cuenta, tus mensualidades y tus comprobantes ya emitidos siguen disponibles con normalidad.</p><div class="portal-copy-row"><a class="portal-button" href={actor.isAdmin ? '/admin' : '/portal'}>{actor.isAdmin ? 'Volver al resumen' : 'Volver a mi cuenta'} <span aria-hidden="true">→</span></a><a class="portal-link" href="https://wa.me/50687686102">Consultar por WhatsApp <span aria-hidden="true">↗</span></a></div></div></section><aside class="portal-panel"><h2>Mientras tanto</h2><p class="portal-section-caption">Si ya realizaste una transferencia y aún no aparece registrada, conserva el comprobante del banco y avisa a la Asociación por WhatsApp para coordinar su registro en cuanto se reactive el portal.</p></aside></div>}
  {business && <>
  {actor.isAdmin && <div class="portal-role-switch" role="navigation" aria-label="Tipo de registro de pago"><a href="/portal/pagos/nuevo" aria-current={personalMode ? 'page' : undefined}>Pago de mi familia</a><a href="/portal/pagos/nuevo?modo=familia" aria-current={staffMode ? 'page' : undefined}>Registrar para otra familia</a></div>}
  {staffMode && <form class="portal-month-form" action="/portal/pagos/nuevo" method="get"><div class="portal-field"><label for="adult">Registrar para una cuenta familiar</label><select id="adult" name="adult" required><option value="">Selecciona una persona</option>{families.filter(family => family.active).map(family => <option value={family.adultId} selected={selectedAdult?.adultId === family.adultId}>{family.adultName} · {family.email}</option>)}</select></div><button class="portal-button portal-button-secondary" type="submit">Elegir cuenta <span aria-hidden="true">→</span></button></form>}
  {personalMode && actor.isAdmin && !(ownDashboard?.athletes.length) && <div class="portal-guidance" style="margin-bottom:18px"><h3>Todavía no tienes atletas vinculados a tu cuenta</h3><p>Cuando tu familia quede vinculada (desde <a class="portal-link" href="/admin/familias">Familias</a>, con «Vincularme como encargado» en el atleta, o aceptando una invitación), aquí verás tus mensualidades para pagarlas como cualquier encargado. Mientras tanto puedes registrar para otra familia.</p></div>}
  {noAthletes && <div class="portal-two-columns"><section class="portal-panel"><div class="portal-guidance portal-guidance-strong"><h2>Aún no vemos atletas en tu cuenta.</h2><p>Por eso todavía no puedes registrar pagos: primero hay que conectar tu correo con tus atletas usando tu <strong>enlace de invitación</strong>. Ábrelo en este mismo teléfono, o pégalo en la página de invitación.</p><div class="portal-copy-row" style="margin-top:18px"><a class="portal-button" href="/portal/invitacion">Usar mi enlace de invitación <span aria-hidden="true">→</span></a><a class="portal-button portal-button-secondary" href="https://wa.me/50687686102">Pedirlo por WhatsApp <span aria-hidden="true">↗</span></a></div></div></section><aside class="portal-panel"><h2>¿Ya transferiste?</h2><p class="portal-section-caption">Guarda la foto o el PDF de tu banco. En cuanto tu cuenta quede conectada, registras el pago aquí con ese mismo archivo; no se pierde.</p></aside></div>}
  {upToDate && <div class="portal-two-columns"><section class="portal-panel"><div class="portal-guidance portal-guidance-strong"><h2>Estás al día: no debes nada.</h2><p>No hay mensualidades pendientes para tus atletas, así que no hay nada que registrar por ahora. Las del próximo mes aparecen en tu cuenta apenas se publiquen.</p><div class="portal-copy-row" style="margin-top:18px"><a class="portal-button" href="/portal">Volver a mi cuenta <span aria-hidden="true">→</span></a></div></div></section><aside class="portal-panel"><h2>¿Transferiste por adelantado?</h2><p class="portal-section-caption">Avisa a la Asociación por WhatsApp y guarda el comprobante de tu banco: lo registras en cuanto se publique la mensualidad correspondiente.</p><a class="portal-link" href="https://wa.me/50687686102">Avisar por WhatsApp <span aria-hidden="true">↗</span></a></aside></div>}
  {showForm && <>
  {!staffMode && <section class="portal-next-step" aria-labelledby="sinpe-title" data-copy-scope><h2 id="sinpe-title">Antes de empezar: ¿ya transferiste?</h2><p>Transfiere a <strong>{business.paymentDestination}</strong> ({business.associationName}) y escribe en el detalle de SINPE el <strong>nombre completo del atleta</strong>. Si pagas varios meses, indica los nombres y el mes.</p><div class="portal-copy-row"><button class="portal-button portal-button-secondary" type="button" data-copy-value={business.paymentDestination}>Copiar destino <span aria-hidden="true">↗</span></button><span class="portal-copy-feedback" data-copy-feedback role="status"></span></div><p>¿Ya transferiste? Perfecto: sigue con el paso 01 aquí abajo.</p></section>}
  <div class="portal-two-columns">
    <section class="portal-panel"><form class="portal-form" action="/api/portal/payments" method="post" enctype="multipart/form-data" data-unsaved-guard data-draft-key="nuevo-pago">
      <input type="hidden" name="submissionId" value={crypto.randomUUID()} />
      {staffMode && selectedAdult && <input type="hidden" name="designatedAdultId" value={selectedAdult.adultId} />}
      {personalMode && actor.isAdmin && <input type="hidden" name="designatedAdultId" value={actor.id} />}
      <SlipUploader mode={ocr.mode} available={ocr.available} athletes={athletes} savedDrafts={emailDrafts} />
      <div class="portal-form-step"><span aria-hidden="true">02</span><div><h2>Revisa los datos del pago.</h2><p>Completa la información o corrige las sugerencias de la lectura.</p></div></div>
      <div class="portal-field"><label for="payer-name">Nombre de quien realizó la transferencia</label><input id="payer-name" name="payerName" type="text" maxlength="160" autocomplete="name" placeholder="Nombre y apellidos…" value={selectedAdult?.adultName ?? actor.name} required /></div>
      <div class="portal-form-row"><div class="portal-field"><label for="amount">Monto que transferiste (₡)</label><input id="amount" name="amount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="27000…" required aria-describedby="amount-help" /><p id="amount-help" class="portal-help">Solo el número, como sale en tu banco: 27000 o 27.000.</p></div><DateInput id="transfer-date" name="transferDate" label="Fecha de la transferencia" value={today} minYear={2020} /></div>
      <div class="portal-field"><label for="bank-reference">Referencia bancaria</label><input id="bank-reference" name="bankReference" type="text" maxlength="128" autocomplete="off" spellcheck="false" placeholder="Ej.: 00002026…" required aria-describedby="reference-help" /><p id="reference-help" class="portal-help">Copia la referencia completa, incluidos los ceros iniciales. No uses el número de teléfono.</p></div>
      <div class="portal-form-step"><span aria-hidden="true">03</span><div><h2>Elige qué mensualidades pagas.</h2><p>Toca «Pagar todo» en cada una que cubra tu transferencia.</p></div></div>
      <ChargeAllocator charges={charges} />
      <p class="portal-help">Si transferiste de más, la diferencia queda guardada a tu favor para el próximo mes. No se pierde.</p>
      {staffAssisted && <label class="portal-checkbox"><input type="checkbox" name="shareEvidence" value="on" /><span>Permitir que la persona responsable seleccionada consulte el archivo de esta transferencia.</span></label>}
      {staffAssisted && <div class="portal-guidance"><h3>Correo para la familia seleccionada</h3>{selectedAdult ? <p>Después de verificar el ingreso en el banco, el comprobante se prepara para el correo verificado de <strong>{selectedAdult.adultName}</strong>: <strong>{selectedAdult.email}</strong>.</p> : <p>Elige arriba una cuenta familiar existente. Su persona adulta responsable será la destinataria del comprobante después de la verificación bancaria.</p>}<p>Se usa el correo registrado en esa cuenta familiar. Si no hay un correo válido y habilitado, la entrega queda retenida. La Asociación debe revisar los datos de la cuenta antes de preparar el envío.</p></div>}
      {!staffAssisted && <p class="portal-help">Después de verificar el ingreso en el banco, el comprobante se prepara únicamente para el correo verificado de la cuenta con la que registras este pago: <strong>{actor.email}</strong>.</p>}
      {staffAssisted && <div class="portal-field"><label for="audit-reason">Motivo del registro por administración</label><textarea id="audit-reason" name="auditReason" maxlength="500" required></textarea></div>}
      <button class="portal-button portal-button-wide" type="submit" disabled={charges.length === 0 || (staffMode && !selectedAdult)}>Enviar mi pago <span aria-hidden="true">→</span></button><p class="portal-help">Al enviarlo, tu pago queda «en revisión»: la Asociación comprueba el ingreso en el banco y después te emite el comprobante oficial. Puedes seguir su estado en tu cuenta.</p>{charges.length === 0 && staffMode && selectedAdult && <p class="portal-help">Esta familia no tiene mensualidades pendientes: por eso el botón está desactivado.</p>}{staffMode && !selectedAdult && <p class="portal-help">Primero elige arriba la cuenta familiar para activar el botón.</p>}
    </form></section>
    <aside class="portal-panel"><div class="portal-guidance"><h3>¿Prefieres enviarlo por correo?</h3><p>Envía la foto o el PDF de tu transferencia a <strong>pagos@recibir.ajedrezbelen.com</strong> desde el correo de tu cuenta. Aparecerá aquí listo para completar los datos; tienes siete días para registrarlo.</p></div><div class="portal-guidance"><h3>¿Qué pasa después de enviarlo?</h3><p>1. Tu pago queda «en revisión» (todavía no baja tu saldo).</p><p>2. La Asociación comprueba el ingreso en el banco.</p><p>3. Tu saldo se actualiza y el comprobante oficial aparece en tu cuenta. Si falta un dato, te lo pedimos ahí mismo.</p></div><div class="portal-guidance"><h3>¿Algo no sale?</h3><p>Los correos automáticos del portal no reciben respuestas. Para cualquier duda con un pago, escríbenos y te guiamos.</p><a class="portal-link" href="https://wa.me/50687686102">Consultar por WhatsApp <span aria-hidden="true">↗</span></a></div><a class="portal-link" href={staffMode ? '/admin' : '/portal'}>Volver a la cuenta <span aria-hidden="true">↗</span></a></aside>
  </div>
  </>}
  </>}
</PortalLayout>
