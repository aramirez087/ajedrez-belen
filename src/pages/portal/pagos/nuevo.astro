---
import { env } from 'cloudflare:workers';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHeader from '../../../components/portal/PageHeader.astro';
import ChargeAllocator from '../../../components/portal/ChargeAllocator.astro';
import SlipUploader from '../../../components/portal/SlipUploader.astro';
import DateInput from '../../../components/portal/DateInput.astro';
import { authorizePortal } from '../../../lib/portal/access';
import { getParentDashboard } from '../../../lib/portal/domain';
import { getOcrAvailability } from '../../../lib/portal/ocr-policy';
import { allowPortalDemo } from '../../../lib/portal/demo-policy';
import { listEmailDrafts } from '../../../lib/portal/slip-upload';
import EmailSlipHelp from '../../../components/portal/EmailSlipHelp.astro';
import { resolveBusinessConfiguration } from '../../../lib/portal/business-config';
import { dateLabel, plainMoney } from '../../../components/portal/format';
export const prerender = false;
const access = await authorizePortal(Astro, env);
if (!access.ok) return access.response;
const { actor } = access;
const business = resolveBusinessConfiguration(Astro.request, env);
if (!business) Astro.response.status = 503;
const ocr = business ? getOcrAvailability(actor,env,{demoAllowed:allowPortalDemo(Astro.url,import.meta.env.DEV,env)}) : { mode: 'off' as const, available: false };
// This page always registers for the viewer's own family, including
// administrators acting as guardians. Registering for another family lives
// in administration, never here.
const dashboard = business ? await getParentDashboard(env.DB, actor).catch(() => null) : null;
const allCharges = dashboard?.charges ?? [];
const athletes = dashboard?.athletes ?? [];
const charges = allCharges.filter(charge => charge.balanceMinor > 0);
const emailDrafts = business ? await listEmailDrafts(env, actor).catch(() => []) : [];
const today = new Intl.DateTimeFormat('en-CA', {timeZone:'America/Costa_Rica',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
// A disabled form nobody can explain helps no one: say plainly why instead.
const dashboardUnavailable = dashboard === null;
if (business && dashboardUnavailable) Astro.response.status = 503;
const noAthletes = !dashboardUnavailable && athletes.length === 0;
const upToDate = athletes.length > 0 && charges.length === 0;
const dueNowMinor = charges.filter(charge => charge.dueDate <= today).reduce((total, charge) => total + charge.balanceMinor, 0);
const showForm = !dashboardUnavailable && !noAthletes && !upToDate;
const earliestDraftExpiry = emailDrafts.reduce<string | null>((earliest, draft) => earliest === null || draft.expiresAt < earliest ? draft.expiresAt : earliest, null);
---
<PortalLayout title="Registrar pago" actor={actor} active="new-payment">
  <PageHeader title={business ? "Registra tu transferencia." : "El registro de pagos está en pausa."} eyebrow="Registrar un pago" description={business ? "Adjunta el comprobante de tu banco, revisa los datos y elige las mensualidades que pagaste." : "La Asociación está confirmando la configuración de cobro. Tu cuenta y tus comprobantes siguen disponibles."} />
  {!business && <div class="portal-two-columns"><section class="portal-panel"><div class="portal-guidance portal-guidance-strong"><h2>Qué significa esta pausa</h2><p>Por ahora no es posible registrar ni confirmar transferencias nuevas mientras la Asociación confirma la configuración de cobro. No realices una transferencia nueva con datos anteriores sin confirmarlo antes.</p><p>Tu cuenta, tus mensualidades y tus comprobantes ya emitidos siguen disponibles con normalidad.</p><div class="portal-copy-row"><a class="portal-button" href="/portal">Volver a mi cuenta <span aria-hidden="true">→</span></a><a class="portal-link" href="https://wa.me/50687686102">Consultar por WhatsApp <span aria-hidden="true">↗</span></a></div></div></section><aside class="portal-panel"><h2>Mientras tanto</h2><p class="portal-section-caption">Si ya realizaste una transferencia y aún no aparece registrada, conserva el comprobante del banco y avisa a la Asociación por WhatsApp para coordinar su registro en cuanto se reactive el portal.</p></aside></div>}
  {business && <>
  {dashboardUnavailable && <section class="portal-panel"><div class="portal-guidance portal-guidance-strong" role="alert"><h2>No pudimos cargar tus mensualidades.</h2><p>Recarga la página para volver a consultar el saldo antes de registrar el pago.</p><a class="portal-button" href="/portal/pagos/nuevo">Volver a intentar <span aria-hidden="true">→</span></a></div></section>}
  {actor.isAdmin && noAthletes && <div class="portal-guidance" style="margin-bottom:18px"><h3>Estás en tu vista familiar</h3><p>Aquí solo se registra para tu propia familia. Para registrar el pago de otra familia, usa <a class="portal-link" href="/admin/pagos/nuevo">Registrar pago en administración</a>.</p></div>}
  {noAthletes && !actor.isAdmin && <div class="portal-two-columns"><section class="portal-panel"><div class="portal-guidance portal-guidance-strong"><h2>Aún no vemos atletas en tu cuenta.</h2><p>Por eso todavía no puedes registrar pagos: primero hay que conectar tu correo con tus atletas usando tu <strong>enlace de invitación</strong>. Ábrelo en este mismo teléfono, o pégalo en la página de invitación.</p><div class="portal-copy-row" style="margin-top:18px"><a class="portal-button" href="/portal/invitacion">Usar mi enlace de invitación <span aria-hidden="true">→</span></a><a class="portal-button portal-button-secondary" href="https://wa.me/50687686102">Pedirlo por WhatsApp <span aria-hidden="true">↗</span></a></div></div></section><aside class="portal-panel"><h2>¿Ya transferiste?</h2><p class="portal-section-caption">Guarda la foto o el PDF de tu banco. En cuanto tu cuenta quede conectada, registras el pago aquí con ese mismo archivo; no se pierde.</p></aside></div>}
  {upToDate && <div class="portal-two-columns"><section class="portal-panel"><div class="portal-guidance portal-guidance-strong"><h2>Estás al día: no debes nada.</h2><p>No hay mensualidades pendientes para tus atletas, así que no hay nada que registrar por ahora. Las del próximo mes aparecen en tu cuenta apenas se publiquen.</p><div class="portal-copy-row" style="margin-top:18px"><a class="portal-button" href="/portal">Volver a mi cuenta <span aria-hidden="true">→</span></a></div></div></section><aside class="portal-panel"><h2>¿Transferiste por adelantado?</h2><p class="portal-section-caption">Avisa a la Asociación por WhatsApp y guarda el comprobante de tu banco: lo registras en cuanto se publique la mensualidad correspondiente.</p>{emailDrafts.length > 0 && <p class="portal-section-caption">{emailDrafts.length === 1 ? 'El archivo que enviaste por correo ya llegó' : `Los ${emailDrafts.length} archivos que enviaste por correo ya llegaron`}, pero aún no hay mensualidad donde registrarlo{earliestDraftExpiry ? <>. {emailDrafts.length === 1 ? 'Vence' : 'El primero vence'} el <strong>{dateLabel(earliestDraftExpiry)}</strong></> : ''}. Guarda también el original: si vence antes de que se publique la mensualidad, lo adjuntas de nuevo aquí y listo.</p>}<a class="portal-link" href="https://wa.me/50687686102">Avisar por WhatsApp <span aria-hidden="true">↗</span></a></aside></div>}
  {showForm && <>
  {emailDrafts.length > 0 && <section class="portal-next-step" aria-labelledby="email-draft-title"><h2 id="email-draft-title">{emailDrafts.length === 1 ? 'Ya llegó el archivo que enviaste por correo.' : `Ya llegaron ${emailDrafts.length} archivos que enviaste por correo.`}</h2><p>El correo por sí solo no registra el pago: elige el archivo en el <strong>paso 01</strong>, revisa el monto y las mensualidades, y envía el formulario. Si la foto ya se leyó, el monto y la referencia vienen completos.{earliestDraftExpiry ? <> {emailDrafts.length === 1 ? 'Tienes hasta el' : 'El primero vence el'} <strong>{dateLabel(earliestDraftExpiry)}</strong>.</> : ''}</p><div class="portal-copy-row"><a class="portal-button portal-button-secondary" href="#slip-saved">Usar el archivo que envié por correo <span aria-hidden="true">↓</span></a></div></section>}
  {(dashboard?.pendingMinor ?? 0) > 0 && <p class="portal-help">Ya tienes un pago en revisión. Antes de hacer otra transferencia, <a class="portal-link" href="/portal#pagos">revisa tus pagos registrados</a>: el saldo todavía incluye lo que está en revisión.</p>}

  <section class="portal-pay-to" aria-labelledby="pay-to-title" data-copy-scope><div class="portal-pay-to-body"><p class="portal-pay-to-label" id="pay-to-title">¿Aún no has transferido? Transfiere a</p><p class="portal-pay-to-value">{business.paymentDestination}</p><p class="portal-pay-to-note">{business.associationName}. En el detalle de SINPE escribe el <strong>nombre completo del atleta</strong>.</p></div><div class="portal-pay-to-action"><button class="portal-button portal-button-secondary" type="button" data-copy-value={business.paymentDestination}>Copiar destino</button><span class="portal-copy-feedback" data-copy-feedback role="status"></span></div></section>

  <div class="portal-two-columns">
    <section class="portal-panel"><form class="portal-form" action="/api/portal/payments" method="post" enctype="multipart/form-data" data-unsaved-guard data-draft-key="nuevo-pago" data-draft-success="submitted">
      <input type="hidden" name="submissionId" value={crypto.randomUUID()} />
      {actor.isAdmin && <input type="hidden" name="designatedAdultId" value={actor.id} />}
      <SlipUploader mode={ocr.mode} available={ocr.available} athletes={athletes} savedDrafts={emailDrafts} />
      <div class="portal-form-step"><span aria-hidden="true">02</span><div><h2>Revisa los datos del pago.</h2><p>{ocr.available ? 'Completa el monto y la fecha, o corrige lo que haya leído el comprobante. La referencia no se escribe.' : 'Escribe el monto y la fecha tal como salen en tu banco.'}</p></div></div>
      <div class="portal-field"><label for="payer-name">Nombre de quien realizó la transferencia</label><input id="payer-name" name="payerName" type="text" maxlength="160" autocomplete="name" placeholder="Nombre y apellidos…" value={actor.name} required /></div>
      <div class="portal-form-row"><div class="portal-field"><label for="amount">Monto que transferiste (₡)</label><input id="amount" name="amount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder={dueNowMinor > 0 ? `Ej. ${plainMoney(dueNowMinor)}` : 'Ej. 12000'} required aria-describedby="amount-help" /><p id="amount-help" class="portal-help">Solo el número, como sale en tu banco: 27000 o 27.000.</p></div><DateInput id="transfer-date" name="transferDate" label="Fecha de la transferencia" value={today} minYear={2020} quickToday /></div>
      {ocr.available ? <div class="portal-field"><label for="bank-reference">Referencia bancaria</label><input id="bank-reference" name="bankReference" type="text" maxlength="128" autocomplete="off" spellcheck="false" placeholder="Se completa al leer el comprobante" readonly aria-readonly="true" aria-describedby="reference-help" /><p id="reference-help" class="portal-help">La lectura del comprobante completa este dato. No hace falta escribirlo. Si no se lee, el pago se puede enviar igual.</p></div> : <input id="bank-reference" name="bankReference" type="hidden" value="" />}
      <div class="portal-form-step"><span aria-hidden="true">03</span><div><h2>Elige qué mensualidades pagas.</h2><p>Toca «Pagar todo lo que vence» si esta transferencia cubre lo que ya se debe. Adelantar el próximo mes es opcional.</p></div></div>
      <ChargeAllocator charges={charges} />
      <p class="portal-help">Si transferiste de más, la diferencia queda guardada a tu favor para el próximo mes. No se pierde.</p>
      <p class="portal-help">El comprobante oficial se enviará al correo de tu cuenta: <strong>{actor.email}</strong>.</p>
      <button class="portal-button portal-button-wide" type="submit" disabled={charges.length === 0}>Enviar mi pago <span aria-hidden="true">→</span></button><p class="portal-help">Después de enviarlo, tu pago queda «en revisión» mientras la Asociación comprueba el ingreso en el banco.</p>
    </form></section>
    <aside class="portal-panel"><EmailSlipHelp accountEmail={actor.email} /><div class="portal-guidance"><h3>¿Qué pasa después de enviar el formulario?</h3><p>1. Tu pago queda «en revisión» (todavía no baja tu saldo).</p><p>2. La Asociación comprueba el ingreso en el banco.</p><p>3. Tu saldo se actualiza y el comprobante oficial aparece en tu cuenta. Si falta un dato, te lo pedimos ahí mismo.</p></div><div class="portal-guidance"><h3>¿Algo no sale?</h3><p>Los correos automáticos del portal no reciben respuestas. Para cualquier duda con un pago, escríbenos y te guiamos.</p><a class="portal-link" href="https://wa.me/50687686102">Consultar por WhatsApp <span aria-hidden="true">↗</span></a></div><a class="portal-link" href="/portal"><span aria-hidden="true">←</span> Volver a la cuenta</a></aside>
  </div>
  </>}
  {!showForm && <EmailSlipHelp accountEmail={actor.email} />}
  </>}
</PortalLayout>
<script>
  // A shortcut from an athlete card takes the person to that athlete's rows.
  const athleteId = new URLSearchParams(window.location.search).get('atleta');
  if (athleteId) {
    const row = Array.from(document.querySelectorAll<HTMLElement>('[data-allocation-athlete-id]')).find(row => row.dataset.allocationAthleteId === athleteId);
    if (row) {
      row.classList.add('portal-allocation-suggested');
      const folded = row.closest('details'); if (folded) folded.open = true;
      row.focus({ preventScroll: true }); row.scrollIntoView({ block: 'center' });
    }
  }
  // Arriving from the account page's email link opens the collapsed panel.
  if (window.location.hash === '#enviar-por-correo') {
    const panel = document.querySelector<HTMLDetailsElement>('#enviar-por-correo');
    if (panel) { panel.open = true; panel.scrollIntoView({ block: 'start' }); }
  }
</script>
