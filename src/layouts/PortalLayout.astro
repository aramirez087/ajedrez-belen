---
import '@fontsource-variable/dm-sans';
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import '../styles/portal.css';
import Notice from '../components/portal/Notice.astro';
interface Props { title: string; actor?: { id: string; email: string; name: string; isAdmin: boolean; mode: 'demo' | 'workos' }; active?: string; hideNav?: boolean; }
const { title, actor, active = '', hideNav = false } = Astro.props;
const stagingTest = env.STAGING_PORTAL_TEST === 'true';
const stagingNotices = new Map([
  ['athlete_created', 'Atleta ficticio inscrito. Ya puedes vincularlo a la cuenta de prueba.'],
  ['month_published', 'Mensualidades de prueba publicadas. Solo la cuenta autorizada puede consultarlas.'],
  ['published', 'Mensualidades de prueba publicadas. Solo la cuenta autorizada puede consultarlas.'],
  ['submitted', 'Recibimos la información de la transferencia ficticia. La prueba queda pendiente de revisión simulada; no se recibieron fondos reales.'],
  ['verified', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['verified_email_pending', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['approved', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['needs_info', 'Se solicitó información adicional en el registro ficticio. Solo la cuenta autorizada puede consultar el motivo.'],
  ['reject', 'Pago ficticio rechazado. El motivo quedó en el historial.'],
  ['void', 'Pago ficticio anulado. Se revirtió su aplicación y se conservó el comprobante con su historial.'],
]);
const stagingNotice = stagingTest && !Astro.url.searchParams.has('error')
  ? stagingNotices.get(Astro.url.searchParams.get('notice') ?? '') : undefined;
const admin = actor?.isAdmin ?? false;
const nav = admin
  ? [['/admin', 'Resumen', 'overview'], ['/admin/familias', 'Familias', 'families'], ['/admin/mensualidades', 'Mensualidades', 'charges'], ['/admin/comprobantes', 'Comprobantes', 'receipts']]
  : [['/portal', 'Mi cuenta', 'overview'], ['/portal/pagos/nuevo', 'Registrar pago', 'new-payment']];
---
<!doctype html>
<html lang="es">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="same-origin" /><link rel="icon" type="image/png" href="/media/favicon.png" /><title>{title} · Ajedrez Belén</title></head>
  <body class="portal-page">
    <a class="skip-link" href="#portal-main">Saltar al contenido</a>
    {stagingTest && <aside class="portal-test-banner" aria-label="Entorno de prueba"><div class="portal-shell"><strong>Entorno de prueba</strong><span>Solo registros ficticios. No realices transferencias. Correos simulados · OCR desactivado.</span></div></aside>}
    {actor?.mode === 'demo' && <div class="portal-demo-banner"><span class="checker-mark" aria-hidden="true"></span>Demostración local · datos ficticios<a href="/demo">Cambiar cuenta</a></div>}
    <div class="portal-shell">
      <header class="portal-header">
        <a class="portal-brand" href={admin ? '/admin' : '/portal'}><img src="/media/crest-provisional.webp" alt="" width="35" height="44" /><span>Ajedrez Belén<small>Portal de pagos{stagingTest && <span class="portal-test-badge">Prueba</span>}</small></span></a>
        <div class="portal-session">{actor ? <><span>{actor.name || actor.email}<small>{admin ? 'Administración' : 'Cuenta familiar'}</small></span>{actor.mode === 'workos' && <form action="/auth/logout" method="post"><button class="portal-link portal-text-button" type="submit">Salir <span aria-hidden="true">↗</span></button></form>}</> : !hideNav && <a class="portal-link" href="/auth/parent">Iniciar sesión <span aria-hidden="true">↗</span></a>}</div>
      </header>
      {!hideNav && <nav class="portal-navigation" aria-label={admin ? 'Administración de pagos' : 'Mi cuenta'}>{nav.map(([href, label, key]) => <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>)}{admin && <a class="portal-family-view" href="/portal">Ver cuenta familiar <span aria-hidden="true">↗</span></a>}</nav>}
      <main id="portal-main" tabindex="-1">{stagingNotice ? <div class="portal-notice" role="status"><p>{stagingNotice}</p></div> : <Notice />}<slot /></main>
      <footer class="portal-footer"><span>Ajedrez Belén · Belén, Heredia</span><a href="https://wa.me/50687686102">¿Dudas con un pago? Escríbenos por WhatsApp <span aria-hidden="true">↗</span></a><a href="/">Volver al sitio <span aria-hidden="true">↗</span></a></footer>
    </div>
  </body>
</html>
<script>
  // Keep native navigation and the clicked submitter's name/value intact.
  // Disabling buttons during submit would omit actions such as reject/needs_info.
  document.querySelectorAll<HTMLFormElement>('form[method="post"]').forEach(form => {
    const buttons = Array.from(form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button[type="submit"], input[type="submit"]'));
    const status = document.createElement('p');
    status.className = 'portal-submit-status';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');
    status.hidden = true;
    form.appendChild(status);
    let pending = false;
    const originalStates = buttons.map(button => button.getAttribute('aria-disabled'));
    function restore() {
      pending = false;
      delete form.dataset.submitting;
      status.hidden = true;
      status.textContent = '';
      buttons.forEach((button, index) => {
        const state = originalStates[index];
        if (state === null) button.removeAttribute('aria-disabled');
        else if (state !== undefined) button.setAttribute('aria-disabled', state);
      });
    }
    form.addEventListener('submit', event => {
      if (pending) { event.preventDefault(); return; }
      pending = true;
      queueMicrotask(() => {
        // Other page-specific validation may cancel submission later in this event.
        if (event.defaultPrevented) { restore(); return; }
        form.dataset.submitting = 'true';
        buttons.forEach(button => button.setAttribute('aria-disabled', 'true'));
        status.hidden = false;
        status.textContent = 'Enviando… Espera la respuesta antes de volver a enviar.';
      });
    });
    window.addEventListener('pageshow', restore);
  });
  // Destructive or batch actions ask once before the native submit continues.
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach(form => {
    form.addEventListener('submit', event => {
      if (form.dataset.confirmed === 'true') return;
      if (!window.confirm(form.dataset.confirm || '¿Confirmas esta acción?')) { event.preventDefault(); return; }
      form.dataset.confirmed = 'true';
    });
    window.addEventListener('pageshow', () => { delete form.dataset.confirmed; });
  });
  // Warn before losing a half-completed payment form.
  document.querySelectorAll<HTMLFormElement>('form[data-unsaved-guard]').forEach(form => {
    let dirty = false;
    form.addEventListener('input', () => { dirty = true; });
    form.addEventListener('change', () => { dirty = true; });
    form.addEventListener('submit', () => { dirty = false; });
    form.addEventListener('reset', () => { dirty = false; });
    window.addEventListener('beforeunload', event => { if (dirty) event.preventDefault(); });
    window.addEventListener('pageshow', () => { dirty = false; });
  });
  // Copy-to-clipboard helpers (payment destination, invitation links).
  document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach(button => {
    button.addEventListener('click', async () => {
      const feedback = button.closest('[data-copy-scope]')?.querySelector<HTMLElement>('[data-copy-feedback]')
        ?? button.parentElement?.querySelector<HTMLElement>('[data-copy-feedback]');
      try {
        await navigator.clipboard.writeText(button.dataset.copyValue ?? '');
        if (feedback) feedback.textContent = 'Copiado.';
      } catch {
        if (feedback) feedback.textContent = 'Selecciona el texto y cópialo manualmente.';
      }
    });
  });
</script>
