---
import '@fontsource-variable/dm-sans';
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import '../styles/portal.css';
import Notice from '../components/portal/Notice.astro';
interface Props { title: string; actor?: { id: string; email: string; name: string; isAdmin: boolean; mode: 'demo' | 'workos' }; active?: string; hideNav?: boolean; homeHref?: string; }
const { title, actor, active = '', hideNav = false, homeHref } = Astro.props;
const stagingTest = env.STAGING_PORTAL_TEST === 'true';
const stagingNotices = new Map([
  ['athlete_created', 'Atleta ficticio inscrito. Ya puedes vincularlo a la cuenta de prueba.'],
  ['month_published', 'Mensualidades de prueba publicadas. Solo la cuenta autorizada puede consultarlas.'],
  ['published', 'Mensualidades de prueba publicadas. Solo la cuenta autorizada puede consultarlas.'],
  ['submitted', 'Recibimos la información de la transferencia ficticia. La prueba queda pendiente de revisión simulada; no se recibieron fondos reales.'],
  ['verified', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['verified_email_pending', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['verified_email_sent', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['verified_email_dry_run', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['verified_email_attention', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['approved', 'Prueba confirmada y comprobante ficticio emitido. No se envían correos en esta prueba.'],
  ['needs_info', 'Se solicitó información adicional en el registro ficticio. Solo la cuenta autorizada puede consultar el motivo.'],
  ['reject', 'Pago ficticio rechazado. El motivo quedó en el historial.'],
  ['void', 'Pago ficticio anulado. Se revirtió su aplicación y se conservó el comprobante con su historial.'],
]);
const stagingNotice = stagingTest && !Astro.url.searchParams.has('error')
  ? stagingNotices.get(Astro.url.searchParams.get('notice') ?? '') : undefined;
const admin = actor?.isAdmin ?? false;
// Dual role: administrators who are also guardians move between the two
// contexts with one explicit switch; the current section decides which one
// is active. Non-admins only ever see the family context.
const inFamily = Astro.url.pathname === '/portal' || Astro.url.pathname.startsWith('/portal/');
const familyContext = !admin || inFamily;
const brandHref = homeHref || (admin && !familyContext ? '/admin' : '/portal');
const pendingInvitation = Boolean(actor) && Astro.cookies.has('pending-invitation') && Astro.url.pathname !== '/portal/invitacion';
const pendingAdminInvitation = Boolean(actor) && Astro.cookies.has('pending-admin-invitation') && Astro.url.pathname !== '/portal/admin-invitacion';
const nav = admin && !familyContext
  ? [['/admin', 'Resumen', 'overview'], ['/admin/familias', 'Familias', 'families'], ['/admin/administradores', 'Administradores', 'admins'], ['/admin/mensualidades', 'Mensualidades', 'charges'], ['/admin/comprobantes', 'Comprobantes', 'receipts'], ['/admin/pagos/nuevo', 'Registrar pago', 'new-payment'], ['/admin/eventos', 'Eventos', 'events']]
  : [['/portal', 'Mi cuenta', 'overview'], ['/portal/eventos', 'Eventos', 'events'], ['/portal/pagos/nuevo', 'Registrar pago', 'new-payment'], ['/portal/inscribir', 'Mis atletas', 'my-athletes']];
const currentSection = nav.find(([, , key]) => key === active)?.[1] ?? (familyContext ? 'Mi cuenta' : 'Administración');
---
<!doctype html>
<html lang="es">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="same-origin" /><link rel="icon" type="image/png" href="/media/favicon.png" /><link rel="manifest" href="/manifest.webmanifest" /><meta name="theme-color" content="#8c302f" /><title>{title} · Ajedrez Belén</title></head>
  <body class="portal-page" data-portal-account={actor?.id ?? 'guest'} data-portal-notice={Astro.url.searchParams.get('notice') ?? ''} data-portal-error={Astro.url.searchParams.get('error') ?? ''}>
    <a class="skip-link" href="#portal-main">Saltar al contenido</a>
    {stagingTest && <aside class="portal-test-banner" aria-label="Entorno de prueba"><div class="portal-shell"><strong>Entorno de prueba</strong><span>Solo registros ficticios. No realices transferencias. Correos simulados · OCR desactivado.</span></div></aside>}
    {actor?.mode === 'demo' && <div class="portal-demo-banner"><span class="checker-mark" aria-hidden="true"></span>Demostración local · datos ficticios<a href="/demo">Cambiar cuenta</a></div>}
    <div class="portal-shell">
      <header class="portal-header">
        <a class="portal-brand" href={brandHref}><img src="/media/crest-provisional.webp" alt="" width="35" height="44" /><span>Ajedrez Belén<small>Portal de pagos{stagingTest && <span class="portal-test-badge">Prueba</span>}</small></span></a>
        <div class="portal-session">{actor ? <><span>{actor.name || actor.email}<small>{admin ? (familyContext ? 'Mi familia · también administración' : 'Administración') : 'Cuenta familiar'}</small></span>{actor.mode === 'workos' && <form action="/auth/logout" method="post"><button class="portal-link portal-text-button" type="submit">Salir <span aria-hidden="true">↗</span></button></form>}</> : !hideNav && <a class="portal-link" href="/auth/entrar">Iniciar sesión <span aria-hidden="true">↗</span></a>}</div>
      </header>
      {!hideNav && admin && <div class="portal-role-switch" role="navigation" aria-label="Cambiar entre administración y mi familia"><a href="/admin" aria-current={!familyContext ? 'page' : undefined}>Administración</a><a href="/portal" aria-current={familyContext ? 'page' : undefined}>Mi familia</a></div>}
      {!hideNav && <nav class="portal-navigation" aria-label={admin && !familyContext ? 'Administración de pagos' : 'Mi cuenta'}>{nav.map(([href, label, key]) => <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>)}</nav>}
      {!hideNav && <details class="portal-mobile-navigation"><summary><span>{currentSection}</span><span>Menú <span aria-hidden="true">+</span></span></summary><nav aria-label="Secciones del portal">{nav.map(([href, label, key]) => <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>)}</nav></details>}
      <main id="portal-main" tabindex="-1">{stagingNotice ? <div class="portal-notice" role="status"><p>{stagingNotice}</p></div> : <Notice />}{pendingAdminInvitation && <div class="portal-alert" role="status" style="margin-top:25px"><span class="checker-mark" aria-hidden="true"></span><div class="portal-alert-text"><strong>Tienes una invitación de administración.</strong><p>Ábrela para terminar el acceso.</p></div><a class="portal-button portal-button-secondary" href="/portal/admin-invitacion">Abrir invitación <span aria-hidden="true">→</span></a></div>}{pendingInvitation && <div class="portal-alert" role="status" style="margin-top:25px"><span class="checker-mark" aria-hidden="true"></span><div class="portal-alert-text"><strong>Tienes una invitación pendiente.</strong><p>Acéptala para ver a tus atletas.</p></div><a class="portal-button portal-button-secondary" href="/portal/invitacion">Aceptar mi invitación <span aria-hidden="true">→</span></a></div>}<slot /></main>
      <aside class="portal-help-bar"><p><strong>¿Necesitas ayuda?</strong> Escríbenos por WhatsApp al <a href="https://wa.me/50687686102">8768-6102 <span aria-hidden="true">↗</span></a> y te guiamos paso a paso.</p></aside>
      <footer class="portal-footer"><span>Ajedrez Belén · Belén, Heredia</span><a href="https://ajedrezbelen.com/privacy/">Política de privacidad <span aria-hidden="true">↗</span></a><a href="https://wa.me/50687686102">¿Dudas con un pago? Escríbenos por WhatsApp <span aria-hidden="true">↗</span></a><a href="/">Volver al sitio <span aria-hidden="true">↗</span></a></footer>
    </div>
    <dialog class="portal-confirm-dialog" id="portal-confirm" aria-labelledby="portal-confirm-title" aria-describedby="portal-confirm-message">
      <h2 id="portal-confirm-title">Confirma esta acción</h2>
      <p id="portal-confirm-message" data-confirm-message></p>
      <div class="portal-form-actions">
        <button class="portal-button portal-button-danger" type="button" data-confirm-yes>Sí, continuar <span aria-hidden="true">→</span></button>
        <button class="portal-button portal-button-secondary" type="button" data-confirm-no>Volver</button>
      </div>
    </dialog>
  </body>
</html>
<script>
  // Keep native navigation and the clicked submitter's name/value intact.
  // Disabling buttons during submit would omit actions such as reject/needs_info.
  document.querySelectorAll<HTMLFormElement>('form[method="post"]').forEach(form => {
    const buttons = Array.from(form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button[type="submit"], input[type="submit"]'));
    const status = document.createElement('p');
    status.className = 'portal-submit-status';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');
    status.hidden = true;
    form.appendChild(status);
    let pending = false;
    const originalStates = buttons.map(button => button.getAttribute('aria-disabled'));
    function restore() {
      pending = false;
      delete form.dataset.submitting;
      status.hidden = true;
      status.textContent = '';
      buttons.forEach((button, index) => {
        const state = originalStates[index];
        if (state === null) button.removeAttribute('aria-disabled');
        else if (state !== undefined) button.setAttribute('aria-disabled', state);
      });
    }
    form.addEventListener('submit', event => {
      if (pending) { event.preventDefault(); return; }
      pending = true;
      queueMicrotask(() => {
        // Other page-specific validation may cancel submission later in this event.
        if (event.defaultPrevented) { restore(); return; }
        form.dataset.submitting = 'true';
        buttons.forEach(button => button.setAttribute('aria-disabled', 'true'));
        status.hidden = false;
        status.textContent = 'Enviando… Espera la respuesta antes de volver a enviar.';
      });
    });
    window.addEventListener('pageshow', restore);
  });
  // Destructive or batch actions ask once in a designed dialog before the
  // native submit continues (replaces window.confirm, which cannot explain
  // consequences or style the danger action).
  const confirmDialog = document.querySelector<HTMLDialogElement>('#portal-confirm');
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach(form => {
    form.addEventListener('submit', event => {
      if (form.dataset.confirmed === 'true') return;
      const prompt = form.dataset.confirm || '¿Confirmas esta acción?';
      if (!confirmDialog || typeof confirmDialog.showModal !== 'function') {
        if (!window.confirm(prompt)) event.preventDefault();
        return;
      }
      event.preventDefault();
      const message = confirmDialog.querySelector<HTMLElement>('[data-confirm-message]');
      if (message) message.textContent = prompt;
      const yes = confirmDialog.querySelector<HTMLButtonElement>('[data-confirm-yes]');
      const no = confirmDialog.querySelector<HTMLButtonElement>('[data-confirm-no]');
      const cleanup = () => { yes?.removeEventListener('click', onYes); no?.removeEventListener('click', onNo); confirmDialog.removeEventListener('cancel', cleanup); };
      const onYes = () => {
        cleanup(); confirmDialog.close(); form.dataset.confirmed = 'true';
        const submitter = (event as SubmitEvent).submitter;
        form.requestSubmit(submitter instanceof HTMLButtonElement || submitter instanceof HTMLInputElement ? submitter : undefined);
        // Approval belongs to this attempt, even if later validation cancels it.
        delete form.dataset.confirmed;
      };
      const onNo = () => { cleanup(); confirmDialog.close(); };
      yes?.addEventListener('click', onYes);
      no?.addEventListener('click', onNo);
      confirmDialog.addEventListener('cancel', cleanup);
      confirmDialog.showModal();
      no?.focus();
    });
    window.addEventListener('pageshow', () => { delete form.dataset.confirmed; });
  });
  // Warn before losing a half-completed payment form.
  document.querySelectorAll<HTMLFormElement>('form[data-unsaved-guard]').forEach(form => {
    let dirty = false;
    form.addEventListener('input', () => { dirty = true; });
    form.addEventListener('change', () => { dirty = true; });
    form.addEventListener('submit', event => {
      queueMicrotask(() => { if (!event.defaultPrevented) dirty = false; });
    });
    form.addEventListener('reset', () => { dirty = false; });
    window.addEventListener('beforeunload', event => { if (dirty) event.preventDefault(); });
    form.addEventListener('portal:draft-restored', () => { dirty = true; });
  });
  // Same-tab drafts are scoped to the signed-in account and form. Only the
  // successful submission clears its draft; unrelated notices never erase work.
  const initializeDrafts = () => {
    const prefix = `portal-draft:v2:${document.body.dataset.portalAccount}:`;
    const pendingKey = `${prefix}pending`;
    try {
      const pending = JSON.parse(sessionStorage.getItem(pendingKey) ?? 'null') as { key: string; notices: string[]; at: number } | null;
      const notice = document.body.dataset.portalNotice ?? '';
      if (pending && Date.now() - pending.at < 30 * 60 * 1000 && pending.key.startsWith(prefix)
        && !document.body.dataset.portalError && pending.notices.includes(notice)) {
        sessionStorage.removeItem(pending.key);
        sessionStorage.removeItem(pendingKey);
      }
      if (document.body.dataset.portalError || (pending && Date.now() - pending.at >= 30 * 60 * 1000)) sessionStorage.removeItem(pendingKey);
    } catch { /* Storage may be unavailable; forms still work. */ }
    type DraftField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    document.querySelectorAll<HTMLFormElement>('form[data-draft-key]').forEach(form => {
      const storageKey = prefix + form.dataset.draftKey;
      const fields = (): DraftField[] => Array.from(form.elements)
        .filter(field => field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)
        .map(field => field as unknown as DraftField)
        // Never restore server identity, concurrency tokens, actions, passwords,
        // or positional charge IDs from stale browser storage.
        .filter(field => field.name && !['file', 'submit', 'button', 'password'].includes(field.type)
          && (field.type !== 'hidden' || field.name === 'draftId'));
      const keyOf = (field: DraftField, list: DraftField[]) =>
        field.name === 'allocationAmount[]' ? `allocation:${field.id}`
          : `${field.name}#${list.filter(item => item.name === field.name).indexOf(field)}`;
      const save = () => {
        const list = fields();
        const data: Record<string, string | boolean> = {};
        list.forEach(field => { data[keyOf(field, list)] = field.type === 'checkbox' || field.type === 'radio' ? (field as HTMLInputElement).checked : field.value; });
        try { sessionStorage.setItem(storageKey, JSON.stringify({ at: Date.now(), data })); } catch { /* optional enhancement */ }
      };
      try {
        const raw = sessionStorage.getItem(storageKey);
        if (raw) {
          const parsed = JSON.parse(raw) as { at?: number; data?: Record<string, string | boolean> };
          if (parsed.data && Date.now() - (parsed.at ?? 0) < 30 * 60 * 1000) {
            form.dispatchEvent(new CustomEvent('portal:before-draft-restore', { detail: parsed.data }));
            const list = fields();
            let restored = false;
            list.forEach(field => {
              const value = parsed.data?.[keyOf(field, list)];
              if (value === undefined) return;
              if (field.type === 'checkbox' || field.type === 'radio') {
                const checked = value === true;
                if ((field as HTMLInputElement).checked !== checked) { (field as HTMLInputElement).checked = checked; restored = true; }
              } else if (typeof value === 'string' && field.value !== value) {
                // Empty text is intentional too (e.g. a cleared optional note).
                field.value = value; restored = true;
              }
            });
            if (restored) {
              const draftId = form.querySelector<HTMLInputElement>('input[name="draftId"]');
              const fileInput = form.querySelector<HTMLInputElement>('input[type="file"][name="slip"]');
              const slipStatus = form.querySelector<HTMLElement>('[data-slip-status]');
              if (draftId?.value && fileInput) {
                fileInput.required = false;
                const savedSelect = form.querySelector('[data-slip-saved]') as unknown as HTMLSelectElement | null;
                const emailed = savedSelect && Array.from(savedSelect.options).some(option => option.value === draftId.value);
                if (emailed && savedSelect) {
                  savedSelect.value = draftId.value;
                  savedSelect.dispatchEvent(new Event('change', { bubbles: true }));
                } else if (slipStatus) slipStatus.textContent = 'Recuperamos el archivo que ya habías adjuntado. Si quieres cambiarlo, adjunta uno nuevo.';
              }
              form.dispatchEvent(new CustomEvent('portal:draft-restored', { bubbles: true }));
              form.dispatchEvent(new Event('input', { bubbles: true }));
              const status = document.createElement('p');
              status.className = 'portal-draft-status';
              status.setAttribute('role', 'status');
              status.textContent = 'Recuperamos tus datos sin enviar. Revísalos antes de continuar.';
              form.insertBefore(status, form.firstChild);
            }
          } else sessionStorage.removeItem(storageKey);
        }
      } catch { /* A broken draft must never break the form. */ }
      form.addEventListener('input', save);
      form.addEventListener('change', save);
      form.addEventListener('submit', event => {
        queueMicrotask(() => {
          if (event.defaultPrevented) return;
          save();
          try {
            sessionStorage.setItem(pendingKey, JSON.stringify({ key: storageKey, notices: (form.dataset.draftSuccess ?? '').split(','), at: Date.now() }));
          } catch { /* optional enhancement */ }
        });
      });
    });
  };
  // Let page components register their dynamic-field restoration hooks first.
  if (document.readyState !== 'complete') document.addEventListener('DOMContentLoaded', initializeDrafts, { once: true });
  else initializeDrafts();
  // Copy-to-clipboard helpers (payment destination, invitation links).
  document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach(button => {
    button.addEventListener('click', async () => {
      const feedback = button.closest('[data-copy-scope]')?.querySelector<HTMLElement>('[data-copy-feedback]')
        ?? button.parentElement?.querySelector<HTMLElement>('[data-copy-feedback]');
      try {
        await navigator.clipboard.writeText(button.dataset.copyValue ?? '');
        if (feedback) feedback.textContent = 'Copiado.';
      } catch {
        if (feedback) feedback.textContent = 'Selecciona el texto y cópialo manualmente.';
      }
    });
  });
</script>
