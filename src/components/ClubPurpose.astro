---
import { clubPurpose } from '../data/club-purpose';
---
<div class="club-purpose" id="proposito">
  <div class="purpose-statement">
    <p class="purpose-label">Nuestro propósito</p>
    <blockquote><p>«{clubPurpose.quote}»</p></blockquote>
  </div>
  <div class="purpose-values">
    {[clubPurpose.mission, clubPurpose.vision].map((item, index) => (
      <div class="purpose-value">
        <h3>{item.title}</h3>
        <p class="purpose-summary">{item.summary}</p>
        <details>
          <summary>Leer {index === 0 ? 'misión' : 'visión'} completa <span aria-hidden="true">+</span></summary>
          <div class="purpose-full">
            {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </details>
      </div>
    ))}
  </div>
</div>
<style>
  .club-purpose {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 36px 56px;
    margin-top: 56px;
    scroll-margin-top: calc(var(--header-height) + 20px);
  }
  .purpose-label {
    color: var(--red);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  blockquote { margin: 0; padding-left: 22px; border-left: 3px solid var(--red); }
  blockquote p {
    max-width: 24ch;
    font-family: var(--display);
    font-size: clamp(23px, 2.4vw, 32px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -.035em;
    text-wrap: pretty;
    color: var(--ink);
  }
  .purpose-value { padding-block: 22px 4px; border-top: 1px solid var(--line-strong); }
  .purpose-value + .purpose-value { margin-top: 22px; }
  h3 { font-family: var(--display); font-size: var(--fs-title); font-weight: 640; letter-spacing: -.035em; }
  .purpose-summary, .purpose-full p { color: var(--muted); font-size: var(--fs-body); line-height: 1.8; }
  .purpose-summary { margin-top: 10px; }
  summary { color: var(--red); font-size: var(--fs-small); font-weight: 600; }
  summary:hover { color: var(--red-hover); }
  .purpose-full { padding-bottom: 18px; }
  .purpose-full p + p { margin-top: 16px; }
  @media (max-width: 759px) {
    .club-purpose { grid-template-columns: minmax(0, 1fr); margin-top: 40px; gap: 32px; }
    blockquote p { max-width: 34ch; }
  }
</style>
