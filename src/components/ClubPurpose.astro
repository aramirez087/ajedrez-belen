---
import { clubPurpose } from '../data/club-purpose';
---
<div class="club-purpose" id="proposito">
  <figure class="purpose-statement" data-reveal>
    <figcaption class="purpose-label">Nuestro propósito</figcaption>
    <blockquote><p><span class="purpose-mark" aria-hidden="true">«</span>{clubPurpose.quote}<span aria-hidden="true">»</span></p></blockquote>
  </figure>
  <div class="purpose-values">
    {[clubPurpose.mission, clubPurpose.vision].map((item, index) => (
      <div class="purpose-value" data-reveal style={`--d: ${index}`}>
        <h3>{item.title}</h3>
        <p class="purpose-summary">{item.summary}</p>
        <details>
          <summary>Leer {index === 0 ? 'misión' : 'visión'} completa <span class="plus" aria-hidden="true"></span></summary>
          <div class="purpose-full">
            {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </details>
      </div>
    ))}
  </div>
</div>
<style>
  .club-purpose {
    margin-top: clamp(72px, 9vw, 140px);
    scroll-margin-top: calc(var(--header-offset, var(--header-h)) + 20px);
  }
  .purpose-statement { position: relative; max-width: 960px; margin: 0 auto; }
  .purpose-label {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 22px;
  }
  blockquote { margin: 0; }
  blockquote p {
    font-family: var(--sans);
    font-size: clamp(25px, 3vw, 42px);
    font-style: normal;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -.01em;
    text-wrap: pretty;
    color: var(--ink);
  }
  /* Hung into the margin so the first line keeps a clean left edge. */
  .purpose-mark { margin-left: -.5em; color: var(--red); }
  .purpose-values {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 3.4vw, 56px);
    margin-top: clamp(48px, 5vw, 80px);
  }
  .purpose-value { padding-top: 20px; border-top: 2px solid var(--ink); }
  h3 { font-family: var(--display); font-size: clamp(28px, 2.4vw, 36px); font-weight: 600; line-height: 1.2; letter-spacing: -.015em; }
  .purpose-summary, .purpose-full p { color: var(--muted); font-size: 16px; line-height: 1.7; }
  .purpose-summary { margin-top: 12px; max-width: 34em; }
  summary { min-height: 52px; margin-top: 8px; color: var(--red); font-size: 14px; }
  summary:hover { color: var(--red-deep); }
  .purpose-full { padding-bottom: 18px; }
  .purpose-full p + p { margin-top: 14px; }
  @media (max-width: 759px) {
    .purpose-values { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .purpose-mark { margin-left: 0; }
  }
</style>
