---
interface Props { src: string }
const { src } = Astro.props;
---
<div class="knight-scene">
  <div class="chess-square" aria-hidden="true"></div>
  <div class="knight-shadow" aria-hidden="true"></div>
  <img src={src} class="knight-piece" alt="Caballo Staunton tallado en madera clara." width="750" height="1000" fetchpriority="high" decoding="async"/>
</div>
