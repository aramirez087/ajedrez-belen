---
import { knightImage } from '../data/landing-media';
interface Props { src: string }
const { src } = Astro.props;
const image = knightImage(src);
---
<figure class="cover-knight">
  <img {...image} alt="Caballo de ajedrez tallado en madera clara." width="750" height="1000" fetchpriority="high" />
</figure>
