---
import type { Payment } from '../../lib/portal/types';
import type { SlipExtraction } from '../../lib/portal/ocr';
import { dateLabel } from './format';
interface Props { records?: Array<{ fileId: string; revision: number; extraction: SlipExtraction }>; payment?: Payment; interactive?: boolean; }
const { records = [], payment, interactive = false } = Astro.props;
const fields = [['amount', 'Monto (₡)'], ['transferDate', 'Fecha'], ['bankReference', 'Referencia'], ['payerName', 'Persona que transfirió']] as const;
function differs(key: string, value: string | null) {
  if (!payment || !value) return false;
  if (key === 'amount') { const [whole, cents = ''] = value.split('.'); return Number(`${whole}${cents.padEnd(2, '0')}`) !== payment.amountMinor; }
  return value !== payment[key as 'transferDate' | 'bankReference' | 'payerName'];
}
function warningLabel(code: string) {
  const labels: Record<string,string> = {demo_fixture:'Datos ficticios de demostración; no fueron leídos del archivo.',unreadable:'El archivo no se lee con claridad.',ambiguous:'Algunos datos son ambiguos. Revísalos en el original.',not_transfer:'No se identificó un comprobante de transferencia.',unsupported_currency:'La moneda no se identifica como colones.',date_uncertain:'La fecha no está clara.',reference_uncertain:'La referencia no está clara.',instruction_like_text:'El archivo contiene texto adicional que requiere revisión.',invalid_amount:'El monto no pudo identificarse.',currency_uncertain:'La moneda no está clara.',invalid_date:'La fecha no pudo identificarse.',future_date:'La fecha detectada es posterior a hoy.',invalid_payer_name:'El nombre de quien transfirió no pudo identificarse.',invalid_bank_reference:'La referencia no pudo identificarse.',invalid_description:'El detalle no pudo identificarse.',unverified_pdf_derivative:'La lectura usa una imagen convertida del PDF; revisa el original.'};
  return labels[code] ?? 'Revisa los datos de la lectura contra el archivo original.';
}
---
{interactive ? <section class="portal-ocr-review" data-ocr-review hidden aria-label="Datos sugeridos del archivo"><header><p class="portal-eyebrow">Lectura del archivo <span data-ocr-mode-label></span></p><h3>Revisa los datos sugeridos.</h3><p class="portal-help" data-ocr-summary>La lectura ayuda a completar el formulario. Comprueba cada dato en tu archivo.</p></header><dl class="portal-ocr-fields">{fields.map(([key,label]) => <div data-ocr-row={key}><dt>{label}</dt><dd><span data-ocr-value={key}>Por completar</span><small data-ocr-field-status={key}></small></dd></div>)}</dl><ul class="portal-ocr-warnings" data-ocr-warnings></ul><p class="portal-help">Los campos que ya editaste conservan tu información. Puedes corregir cualquier dato antes de enviarlo.</p></section> : records.length > 0 && <section class="portal-section"><h2>Lectura del archivo</h2><p class="portal-section-caption">Sugerencias sin verificar. Los datos registrados por la familia y la comprobación bancaria se revisan por separado.</p>{records.map(record => <article class="portal-ocr-review"><header><p class="portal-eyebrow">Versión {record.revision} · {record.extraction.mode === 'demo' ? 'Lectura simulada' : 'Lectura asistida'}</p><h3>{record.extraction.status === 'ready' ? 'Datos detectados' : 'Lectura sin datos disponibles'}</h3><p class="portal-help">{dateLabel(record.extraction.createdAt)}{record.extraction.mode === 'demo' && ' · Datos ficticios de demostración; no corresponden al archivo.'}</p></header>{record.extraction.suggestions && <><dl class="portal-ocr-fields">{fields.map(([key,label]) => <div class:list={{'portal-ocr-different': differs(key,record.extraction.suggestions?.[key] ?? null)}}><dt>{label}</dt><dd><span>{record.extraction.suggestions?.[key] ?? 'Sin detectar'}</span>{differs(key,record.extraction.suggestions?.[key] ?? null) && <small>Difiere del dato registrado</small>}</dd></div>)}</dl>{record.extraction.suggestions.description && <p class="portal-help">Detalle detectado: {record.extraction.suggestions.description}</p>}{record.extraction.suggestions.warnings.length > 0 && <ul class="portal-ocr-warnings">{record.extraction.suggestions.warnings.map(warning => <li>{warningLabel(warning)}</li>)}</ul>}</>}{record.extraction.sourceKind === 'pdf_preview' && <p class="portal-ocr-source-note">Lectura de la primera página convertida a imagen. Comprueba los datos contra el PDF original y el ingreso bancario.</p>}<p class="portal-help">Esta lectura no confirma que el dinero haya ingresado a la cuenta.</p></article>)}</section>}
