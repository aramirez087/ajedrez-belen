---
import type { Receipt } from '../../lib/portal/types';
import { money, dateLabel, familyEmailLabels } from './format';
interface Props { receipts: Receipt[]; }
const { receipts } = Astro.props;
---
{receipts.length ? <div class="portal-table-wrap" role="region" aria-label="Comprobantes emitidos" tabindex="0"><table class="portal-table portal-table-list"><caption class="visually-hidden">Comprobantes emitidos y estado del correo</caption><thead><tr><th scope="col">Comprobante</th><th scope="col" class="portal-num-head">Total</th><th scope="col">Correo</th><th scope="col">Documento</th></tr></thead><tbody>{receipts.map(receipt => <tr><th scope="row">{receipt.number}<span class="portal-subtext">{dateLabel(receipt.snapshot.issuedAt)}{receipt.status === 'void' ? ' · Anulado' : ''}</span></th><td class="portal-number portal-key" data-label="Total">{money(receipt.snapshot.amountMinor)}</td><td data-label="Correo">{receipt.status === 'void' ? 'Sin correo: comprobante anulado' : familyEmailLabels[receipt.emailStatus ?? 'pending'] ?? 'Aún no enviado'}{receipt.status !== 'void' && receipt.emailStatus !== 'accepted' && receipt.emailStatus !== 'sent' && <span class="portal-subtext">Tu comprobante sigue disponible aquí.</span>}</td><td data-label="Documento"><a class="portal-link" href={`/portal/comprobantes/${receipt.id}`} aria-label={`Abrir comprobante ${receipt.number}`}>Abrir comprobante <span aria-hidden="true">→</span></a></td></tr>)}</tbody></table></div> : <p class="portal-section-caption">Tus comprobantes aparecerán aquí cuando se confirme un pago.</p>}
