---
import type { Payment } from '../../lib/portal/types';
import { money, dateLabel, paymentLabels } from './format';
interface Props { payments: Payment[]; admin?: boolean; }
const { payments, admin = false } = Astro.props;
---
{payments.length ? <div class="portal-table-wrap" role="region" aria-label="Pagos registrados; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Pagos registrados y su estado</caption><thead><tr><th scope="col">Transferencia</th><th scope="col">Monto</th><th scope="col">Estado</th><th scope="col">Detalle</th></tr></thead><tbody>{payments.map(payment => <tr><th scope="row">{payment.payerName}<span class="portal-subtext">{dateLabel(payment.transferDate)}</span><span class="portal-subtext">Ref. {payment.bankReference}</span></th><td class="portal-number">{money(payment.verifiedAmountMinor ?? payment.amountMinor)}</td><td><span class:list={['portal-status', `portal-status-${payment.status}`]}>{paymentLabels[payment.status] ?? payment.status}</span>{payment.reviewNote && <span class="portal-subtext">{payment.reviewNote}</span>}</td><td><a class="portal-link" href={`${admin ? '/admin' : '/portal'}/pagos/${payment.id}`}>{admin ? 'Revisar' : 'Ver pago'} <span aria-hidden="true">↗</span></a>{payment.receiptId && <a class="portal-link" href={`/portal/comprobantes/${payment.receiptId}`}>Comprobante <span aria-hidden="true">↗</span></a>}</td></tr>)}</tbody></table></div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>No hay pagos registrados.</h3><p>Cuando se registre una transferencia aparecerá aquí junto con su estado de revisión.</p></div></div>}
