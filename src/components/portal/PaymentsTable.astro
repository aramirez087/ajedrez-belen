---
import type { Payment } from '../../lib/portal/types';
import { money, dateLabel, paymentLabels, paymentHints, referenceLabel } from './format';
interface Props { payments: Array<Payment & { canOpenDetail?: boolean }>; admin?: boolean; allowedReceiptIds?: ReadonlySet<string>; emptyTitle?: string; emptyDescription?: string; }
const { payments, admin = false, allowedReceiptIds, emptyTitle = 'No hay pagos registrados.', emptyDescription = 'Cuando registres una transferencia aparecerá aquí junto con su estado.' } = Astro.props;
---
{payments.length ? <div class="portal-table-wrap" role="region" aria-label="Pagos registrados; desplázate para ver todas las columnas" tabindex="0"><table class="portal-table"><caption class="visually-hidden">Pagos registrados y su estado</caption><thead><tr><th scope="col">Transferencia</th><th scope="col" class="portal-num-head">Monto</th><th scope="col">Estado</th><th scope="col">Detalle</th></tr></thead><tbody>{payments.map(payment => <tr><th scope="row">{payment.payerName}<span class="portal-subtext">{dateLabel(payment.transferDate)}</span><span class="portal-subtext">Ref. {referenceLabel(payment.bankReference)}</span></th><td class="portal-number" data-label="Monto">{money(payment.verifiedAmountMinor ?? payment.amountMinor)}</td><td data-label="Estado"><span class:list={['portal-status', `portal-status-${payment.status}`]}>{paymentLabels[payment.status] ?? payment.status}</span>{!admin && paymentHints[payment.status] && <span class="portal-subtext">{paymentHints[payment.status]}</span>}{payment.reviewNote && <span class:list={['portal-subtext', { 'portal-subtext-clamp': payment.status !== 'needs_info' }]}>{payment.reviewNote}</span>}</td><td data-label="Detalle">{admin || payment.canOpenDetail === true ? <a class="portal-link" href={`${admin ? '/admin' : '/portal'}/pagos/${payment.id}`} aria-label={`${admin ? 'Revisar' : payment.status === 'needs_info' ? 'Completar información del pago de' : 'Ver pago de'} ${payment.payerName}, ${dateLabel(payment.transferDate)}`}>{admin ? 'Revisar' : payment.status === 'needs_info' ? 'Completar información' : 'Ver pago'} <span aria-hidden="true">↗</span></a> : <span class="portal-subtext">El detalle lo puede abrir la persona que registró este pago.</span>}{payment.receiptId && (admin || allowedReceiptIds?.has(payment.receiptId)) && <a class="portal-link" href={`/portal/comprobantes/${payment.receiptId}`} aria-label={`Comprobante del pago de ${payment.payerName}, ${dateLabel(payment.transferDate)}`}>Comprobante <span aria-hidden="true">↗</span></a>}</td></tr>)}</tbody></table></div> : <div class="portal-empty"><span class="checker-mark" aria-hidden="true"></span><div><h3>{emptyTitle}</h3><p>{emptyDescription}</p></div></div>}
