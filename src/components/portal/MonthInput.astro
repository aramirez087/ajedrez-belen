---
import { MONTHS_ES } from './format';
interface Props { id: string; name: string; label: string; value: string; minYear?: number; maxYear?: number; }
const { id, name, label, value, minYear, maxYear } = Astro.props;
const [yearPart, monthPart] = (value ?? '').split('-');
const currentYear = new Date().getFullYear();
const from = minYear ?? currentYear - 1;
const to = maxYear ?? currentYear + 2;
const years = Array.from({ length: to - from + 1 }, (_, i) => to - i);
const selectedMonth = Number(monthPart) || 0;
const selectedYear = Number(yearPart) || currentYear;
---
<div class="portal-field">
  <span class="portal-label" id={`${id}-label`}>{label}</span>
  <div class="portal-date-row portal-date-row-month" role="group" aria-labelledby={`${id}-label`}>
    <label class="visually-hidden" for={`${id}-month`}>Mes</label>
    <select id={`${id}-month`} name={`${name}Month`} required>
      <option value="" selected={selectedMonth === 0}>Elige el mes</option>
      {MONTHS_ES.map((month, i) => <option value={i + 1} selected={selectedMonth === i + 1}>{month}</option>)}
    </select>
    <label class="visually-hidden" for={`${id}-year`}>Año</label>
    <select id={`${id}-year`} name={`${name}Year`} required>
      {years.map(year => <option value={year} selected={selectedYear === year}>{year}</option>)}
    </select>
  </div>
</div>
