---
import type { Charge } from '../../lib/portal/types';
import { money, monthLabel, dueLabel, dueState } from './format';
// `covered`: months a payment in review already pays in full. They read as waiting, not overdue.
interface Props { charges: Charge[]; todayCR: string; caption: string; label: string; covered?: ReadonlySet<string>; }
const { charges, todayCR, caption, label, covered } = Astro.props;
---
<div class="portal-table-wrap" role="region" aria-label={label} tabindex="0"><table class="portal-table portal-table-list portal-table-charges"><caption class="visually-hidden">{caption}</caption><thead><tr><th scope="col">Atleta / mes</th><th scope="col" class="portal-num-head">Mensualidad</th><th scope="col" class="portal-num-head">Confirmado</th><th scope="col" class="portal-num-head">Saldo</th></tr></thead><tbody>{charges.map(charge => {
  const due = dueState(charge.dueDate, todayCR);
  return <tr><th scope="row">{charge.athleteName}<span class="portal-subtext">{monthLabel(charge.period)} · {dueLabel(charge.dueDate, todayCR).toLowerCase()}</span></th><td class="portal-number" data-label="Mensualidad">{money(charge.totalMinor)}{charge.discountMinor > 0 && <span class="portal-subtext">{charge.discountReason ?? 'Descuento'} · −{money(charge.discountMinor)}</span>}</td><td class:list={['portal-number', { 'is-zero': charge.paidMinor === 0 }]} data-label="Confirmado">{money(charge.paidMinor)}</td><td class="portal-number portal-key" data-label="Saldo">{money(charge.balanceMinor)}{charge.balanceMinor > 0 && covered?.has(charge.id) ? <span class="portal-status portal-status-pending portal-status-tag">En revisión</span> : <>{charge.balanceMinor > 0 && due.kind === 'overdue' && <span class="portal-status portal-status-needs_info portal-status-tag">Vencida</span>}{charge.balanceMinor > 0 && due.kind === 'today' && <span class="portal-status portal-status-pending portal-status-tag">Vence hoy</span>}</>}</td></tr>;
})}</tbody></table></div>
