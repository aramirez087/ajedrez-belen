---
import type { Charge } from '../../lib/portal/types';
import { money } from './format';
import AllocationRow from './AllocationRow.astro';
// `voice` keeps family wording ("tu transferencia") out of administration; `intro={false}` is for
// pages whose step heading already asks the question, so it is not asked twice.
// `allowEmpty` is for forms that review or revise an advance, which names no month on purpose.
interface Props { charges: Charge[]; values?: Record<string, number>; legend?: string; prefix?: string; intro?: boolean; voice?: 'family' | 'admin'; allowEmpty?: boolean; emptyNote?: string | false; }
const { charges, values = {}, legend = '¿Qué mensualidades pagas con esta transferencia?', prefix = 'allocation', intro = true, voice = 'family', allowEmpty = false, emptyNote = 'No hay mensualidades pendientes para esta cuenta.' } = Astro.props;
const staff = voice === 'admin';
const todayCR = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Costa_Rica', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const currentPeriod = todayCR.slice(0, 7);
const capOf = (charge: Charge) => Math.max(charge.balanceMinor, values[charge.id] ?? 0);
const dueNow = charges.filter(charge => charge.period <= currentPeriod);
const future = charges.filter(charge => charge.period > currentPeriod);
const showFutureFold = future.length > 0 && dueNow.length > 0;
const payAll = dueNow.length > 0 ? dueNow : charges;
const payAllIds = new Set(payAll.map(charge => charge.id));
const payAllMinor = payAll.reduce((total, charge) => total + capOf(charge), 0);
const futureMinor = future.reduce((total, charge) => total + capOf(charge), 0);
const payAllLabel = dueNow.length > 0 ? 'Pagar todo lo que vence' : 'Pagar todo el saldo';
---
<fieldset id={`${prefix}-group`} class="portal-fieldset" data-allocator data-prefix={prefix} data-voice={voice} data-allow-empty={allowEmpty ? '1' : undefined} tabindex="-1" aria-describedby={`${prefix}-amount-check`}>
  <legend class:list={{ 'visually-hidden': !intro }}>{legend}</legend>
  {intro && <p class="portal-help" style="margin:0 0 13px">{staff ? <>Toca <strong>«{payAllLabel}»</strong> para llenar lo que ya se debe, o escribe el monto de cada mensualidad.</> : showFutureFold ? <>Toca <strong>«{payAllLabel}»</strong> y llenamos las mensualidades que ya se deben. El próximo mes queda aparte, por si quieres adelantarlo.</> : <>Escribe cuánto de tu transferencia va para cada mensualidad, o toca <strong>«{payAllLabel}»</strong> y lo llenamos por ti. Deja en blanco las que no pagas hoy.</>}{staff ? '' : ' Si ya indicaste el monto transferido, lo conservamos.'}</p>}
  {payAllMinor > 0 && <div class="portal-copy-row" style="margin:0 0 6px"><button class="portal-button portal-button-secondary" type="button" data-pay-all>{payAllLabel} · {money(payAllMinor)} <span aria-hidden="true">→</span></button></div>}
  {(showFutureFold ? dueNow : charges).map(charge => <AllocationRow charge={charge} prefix={prefix} cap={capOf(charge)} filled={values[charge.id] ?? 0} today={todayCR} inPayAll={payAllIds.has(charge.id)} />)}
  {showFutureFold && <details class="portal-future-charges" open={future.some(charge => (values[charge.id] ?? 0) > 0)}><summary>Adelantar próximos meses (opcional) · {money(futureMinor)}</summary>{future.map(charge => <AllocationRow charge={charge} prefix={prefix} cap={capOf(charge)} filled={values[charge.id] ?? 0} today={todayCR} inPayAll={false} />)}</details>}
  {charges.length === 0 && emptyNote && <p class="portal-help">{emptyNote}</p>}
  <div class="portal-total"><span>{staff ? 'Total aplicado' : 'Total que pagas con esta transferencia'}</span><output data-allocation-total aria-live="polite">{money(Object.values(values).reduce((total, value) => total + value, 0))}</output></div>
  <p id={`${prefix}-amount-check`} class="portal-help" data-allocation-status role="status" aria-live="polite" hidden></p>
</fieldset>
<script>
  import { allocationSummary, minorAmount } from '../../lib/portal/allocation-validation';
  import { advanceMinor, advanceSelection } from '../../lib/portal/advance';
  const formatter = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const wholeFormatter = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 });
  const formatMinor = (minor: number) => minor % 100 === 0 ? wholeFormatter.format(minor / 100) : formatter.format(minor / 100);
  const moneyHint = 'Escribe solo el número en colones, por ejemplo 27000 o 27.000.';
  document.querySelectorAll<HTMLElement>('[data-allocator]').forEach(group => {
    const form = group.closest<HTMLFormElement>('form');
    const output = group.querySelector<HTMLOutputElement>('[data-allocation-total]');
    const status = group.querySelector<HTMLElement>('[data-allocation-status]');
    const inputs = Array.from(group.querySelectorAll<HTMLInputElement>('[data-allocation]'));
    const transfer = form?.querySelector<HTMLInputElement>('input[name="amount"], input[name="verifiedAmount"]');
    const staff = group.dataset.voice === 'admin';
    // Paying months ahead names no month: the "Adelantar meses" field (when the form has one) adds to the amount.
    const advanceField = form?.querySelector<HTMLInputElement>('input[name="advanceMonths"]') ?? null;
    const advanceRate = Number(form?.querySelector<HTMLElement>('[data-advance]')?.dataset.rateMinor ?? 0);
    const allowEmpty = group.dataset.allowEmpty === '1';
    const monthsAhead = () => advanceField ? (advanceSelection(advanceField.value) ?? 0) : 0;
    const submitters = Array.from(form?.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button[type="submit"], input[type="submit"]') ?? []);
    const initiallyDisabled = submitters.map(button => button.disabled);
    let interacted = inputs.some(input => input.value !== '');
    // Inline error for the transfer-amount field itself (it lives outside
    // this fieldset): created once, announced where the mistake is.
    let amountError: HTMLElement | null = null;
    if (transfer && form) {
      amountError = form.querySelector<HTMLElement>('[data-amount-error]');
      if (!amountError) {
        amountError = document.createElement('p');
        amountError.className = 'portal-help portal-field-error'; amountError.dataset.amountError = '';
        amountError.setAttribute('role', 'alert'); amountError.hidden = true;
        (transfer.closest('.portal-field') ?? transfer.parentElement)?.appendChild(amountError);
      }
      amountError.id = amountError.id || `${group.dataset.prefix || 'allocation'}-amount-error`;
      amountError.classList.add('portal-field-error');
      const described = new Set((transfer.getAttribute('aria-describedby') ?? '').split(' ').filter(Boolean));
      described.add(amountError.id);
      transfer.setAttribute('aria-describedby', [...described].join(' '));
    }
    const plain = (minor: number) => minor % 100 === 0 ? String(minor / 100) : (minor / 100).toFixed(2);
    // One tap covers what is due now. Next month stays as the person left it,
    // and the transfer amount follows the new total while it is still automatic.
    const fillAll = () => {
      const targets = inputs.filter(input => input.dataset.payAllTarget === '1');
      const chosen = targets.length > 0 ? targets : inputs;
      let filled = 0;
      chosen.forEach(input => { const cap = Number(input.dataset.maxMinor ?? 0); if (cap > 0) { input.value = plain(cap); filled += cap; } });
      if (transfer && filled > 0 && transfer.value === '') transfer.dataset.autoAmount = '1';
      interacted = true;
      (form ?? group).dispatchEvent(new Event('input', { bubbles: true }));
      transfer?.focus();
    };
    group.querySelector<HTMLButtonElement>('[data-pay-all]')?.addEventListener('click', fillAll);
    group.querySelectorAll<HTMLButtonElement>('[data-quick-fill]').forEach(button => {
      button.addEventListener('click', () => {
        const target = group.querySelector<HTMLInputElement>(`#${CSS.escape(button.dataset.quickFill ?? '')}`);
        if (!target) return;
        target.value = button.dataset.amount ?? '';
        target.dispatchEvent(new Event('input', { bubbles: true }));
        target.focus();
      });
    });
    const update = (force = false): boolean => {
      const showErrors = interacted || force;
      const eligible = inputs.filter(input => Number(input.dataset.maxMinor ?? 0) > 0);
      const months = monthsAhead();
      const ahead = advanceMinor(months, advanceRate);
      const advancing = months > 0 || allowEmpty;
      submitters.forEach((button, index) => { button.disabled = initiallyDisabled[index] || (eligible.length === 0 && !advancing); });
      transfer?.setCustomValidity(''); transfer?.removeAttribute('aria-invalid');
      let advanceValid = true;
      if (advanceField) {
        advanceValid = advanceSelection(advanceField.value) !== null;
        advanceField.setCustomValidity(advanceValid ? '' : 'Escribe un número de 0 a 12.');
        if (advanceValid) advanceField.removeAttribute('aria-invalid'); else advanceField.setAttribute('aria-invalid', 'true');
      }
      if (status) { status.style.color = ''; status.hidden = !showErrors; }
      let valid = true;
      inputs.forEach(input => {
        input.setCustomValidity('');
        const minor = input.value === '' ? 0 : minorAmount(input.value, true);
        if (minor === null) input.setCustomValidity(moneyHint);
        else if (minor > Number(input.dataset.maxMinor ?? 0)) input.setCustomValidity(`Supera lo que se debe en esta mensualidad (${formatMinor(Number(input.dataset.maxMinor ?? 0))}).`);
        if (showErrors && !input.validity.valid) { input.setAttribute('aria-invalid', 'true'); valid = false; }
        else { input.removeAttribute('aria-invalid'); if (!input.validity.valid) valid = false; }
        const error = input.closest('.portal-field')?.querySelector<HTMLElement>('[data-allocation-error]');
        if (error) { error.hidden = !showErrors || input.validity.valid; error.textContent = error.hidden ? '' : input.validationMessage; }
      });
      const summary = allocationSummary(inputs.map(input => input.value));
      valid = valid && summary.kind !== 'invalid' && advanceValid;
      const total = summary.totalMinor;
      if (output) output.value = valid ? formatMinor(total + ahead) : 'Revisa los montos';
      // Mirror: until the person types the amount themselves, the transfer
      // amount follows the distributed total so it is never typed twice.
      const target = total + ahead;
      if (transfer && target > 0 && summary.kind !== 'invalid' && (transfer.dataset.autoAmount === '1' || transfer.value === '')) {
        transfer.value = plain(target); transfer.dataset.autoAmount = '1';
      }
      // The amount field reports its own error first; never let an
      // allocation message mask a malformed transfer amount (B-2).
      if (transfer && transfer.value !== '' && minorAmount(transfer.value) === null) {
        transfer.setCustomValidity(moneyHint); transfer.setAttribute('aria-invalid', 'true');
        if (amountError && (showErrors || interacted)) { amountError.hidden = false; amountError.textContent = `Ese monto no se entiende. ${moneyHint}`; }
        if (showErrors) { if (status) { status.textContent = `Revisa el monto que transferiste. ${moneyHint}`; status.style.color = 'var(--red)'; status.hidden = false; } return false; }
      } else if (amountError) { amountError.hidden = true; amountError.textContent = ''; }
      if (!showErrors) {
        // Nothing typed yet: stay quiet instead of opening with a red error.
        inputs.forEach(input => input.setCustomValidity(''));
        return (summary.kind === 'ready' || advancing) && advanceValid;
      }
      const allocationError = eligible.length === 0 && !advancing
        ? 'No hay mensualidades disponibles para esta operación. Podrás continuar cuando haya una mensualidad pendiente.'
        : !advanceValid ? 'Escribe un número de 0 a 12 en los meses por adelantar.'
        : !valid ? `Revisa los montos de las mensualidades. ${moneyHint}`
        : summary.kind !== 'ready' && !advancing ? 'Toca «Pagar todo» en al menos una mensualidad, o escribe cuánto pagas de cada una.' : '';
      if (allocationError) {
        if (status) { status.textContent = allocationError; status.style.color = 'var(--red)'; }
        if (valid && eligible.length > 0) { eligible[0]!.setCustomValidity(allocationError); eligible[0]!.setAttribute('aria-invalid', 'true'); }
        return false;
      }
      // Applying existing credit has no transfer input, but still requires a positive allocation.
      if (!transfer) { if (status) status.textContent = 'Revisa las mensualidades y los montos antes de aplicar el saldo.'; return true; }
      const amount = minorAmount(transfer.value);
      if (transfer.value !== '' && amount === null) transfer.setCustomValidity(moneyHint);
      if (amount === null || !transfer.validity.valid) { if (transfer.value !== '') transfer.setAttribute('aria-invalid', 'true'); if (status) status.textContent = `${staff ? 'Escribe arriba el monto para compararlo.' : 'Escribe arriba el monto que transferiste para compararlo.'} ${moneyHint}`; return false; }
      if (total > amount) {
        const message = staff
          ? `El total supera el monto por ${formatMinor(total - amount)}. Baja algún monto o corrige el monto de arriba.`
          : `El total supera tu transferencia por ${formatMinor(total - amount)}. Baja algún monto o corrige el monto transferido.`;
        if (status) { status.textContent = message; status.style.color = 'var(--red)'; }
        if (amountError) { amountError.hidden = false; amountError.textContent = message; }
        transfer.setCustomValidity(message); transfer.setAttribute('aria-invalid', 'true'); return false;
      }
      const monthsLabel = `${months} ${months === 1 ? 'mes' : 'meses'}`;
      if (ahead > 0 && total + ahead > amount) {
        const message = `Con ${formatMinor(amount)} no alcanza para ${monthsLabel} por adelantar (${formatMinor(ahead)}). Baja los meses o corrige el monto${staff ? '' : ' transferido'}.`;
        if (status) { status.textContent = message; status.style.color = 'var(--red)'; }
        if (amountError) { amountError.hidden = false; amountError.textContent = message; }
        transfer.setCustomValidity(message); transfer.setAttribute('aria-invalid', 'true'); return false;
      }
      if (ahead > 0) {
        if (status) status.textContent = `Adelantas ${monthsLabel} (${formatMinor(ahead)}). Se aplican solos cuando se publique cada mensualidad.`;
        return true;
      }
      if (status) status.textContent = staff
        ? (total === amount ? 'El total coincide con el monto.' : `Aplicas ${formatMinor(total)} de ${formatMinor(amount)}. Los ${formatMinor(amount - total)} restantes quedan como saldo a favor de la familia.`)
        : total === amount
        ? 'El total coincide con tu transferencia. El pago se aplica cuando la Asociación confirme el ingreso en el banco.'
        : `Distribuiste ${formatMinor(total)} de ${formatMinor(amount)}. Los ${formatMinor(amount - total)} restantes quedarán a tu favor para el próximo mes, después de la confirmación en el banco.`;
      return true;
    };
    transfer?.addEventListener('input', () => { delete transfer.dataset.autoAmount; });
    const onInteract = () => { interacted = true; update(); };
    (form ?? group).addEventListener('input', onInteract);
    (form ?? group).addEventListener('change', onInteract);
    form?.addEventListener('submit', event => {
      if (!update(true)) { event.preventDefault(); if (!inputs.length) group.focus(); else form.reportValidity(); }
    });
    // Native validation can stop submission before the submit event. Reveal
    // the relevant month and its inline explanation when that happens.
    form?.addEventListener('invalid', event => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement) || (field !== transfer && !inputs.includes(field))) return;
      const folded = field.closest('details'); if (folded) folded.open = true;
      update(true);
    }, true);
    form?.addEventListener('portal:draft-restored', () => {
      inputs.filter(input => input.value !== '' && minorAmount(input.value, true) !== 0).forEach(input => {
        const folded = input.closest('details'); if (folded) folded.open = true;
      });
      update();
    });
    form?.addEventListener('reset', () => queueMicrotask(() => update()));
    window.addEventListener('pageshow', () => update());
    update();
  });
</script>
