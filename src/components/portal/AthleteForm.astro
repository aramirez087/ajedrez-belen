---
import type { Athlete } from '../../lib/portal/types';
import MonthInput from './MonthInput.astro';
import { ATHLETE_CATEGORIES, DEFAULT_FEES, athleteFeeSnapshot } from '../../lib/portal/domain';
import { money } from './format';
interface Props { athlete?: Athlete; month: string; fees?: Record<string, number>; }
const { athlete, month, fees = DEFAULT_FEES } = Astro.props;
const prefix = athlete?.id ?? 'new';
const feeLabel = (category: string) => `${money(fees[category] ?? 0)} al mes`;
const feeLabels = Object.fromEntries(ATHLETE_CATEGORIES.map(category => [category, feeLabel(category)]));
const currentCategory = athlete?.category ?? 'Iniciación';
const legacyCategory = athlete !== undefined && !(ATHLETE_CATEGORIES as readonly string[]).includes(currentCategory);
---
<form class="portal-form" action={athlete ? `/api/admin/athletes/${athlete.id}` : '/api/admin/athletes'} method="post">
  {athlete && <input type="hidden" name="expectedSnapshot" value={athleteFeeSnapshot(athlete)} />}
  <div class="portal-form-row"><div class="portal-field"><label for={`${prefix}-name`}>Nombre completo del atleta</label><input id={`${prefix}-name`} name="name" type="text" maxlength="160" autocomplete="off" placeholder="Nombre y apellidos…" value={athlete?.name ?? ''} required /></div><div class="portal-field"><label for={`${prefix}-category`}>Grupo</label><select id={`${prefix}-category`} name="category" required data-category-select>{legacyCategory && <option value="" selected>Elige el grupo actual…</option>}{ATHLETE_CATEGORIES.map(category => <option value={category} selected={currentCategory === category}>{category} · {feeLabel(category)}</option>)}</select></div></div>
  {legacyCategory && <p class="portal-help" style="color:var(--red)">Este atleta quedó con una categoría anterior («{currentCategory}») que ya no se usa. Elige su grupo actual para poder guardar; no se cambia solo.</p>}
  <p class="portal-help" data-fee-note>Mensualidad según el grupo: <strong data-fee-value>{legacyCategory ? 'elige un grupo' : feeLabel(currentCategory)}</strong>. Si la familia tiene 2 o más atletas, el descuento de hermanos (25 %) se aplica solo al publicar el mes; no hay que calcularlo a mano.</p>
  <div class="portal-form-row"><MonthInput id={`${prefix}-start`} name="startPeriod" label="Mes de inicio de cobro" value={athlete?.startPeriod ?? month} /><label class="portal-checkbox" style="align-self:center"><input type="checkbox" name="active" value="on" checked={athlete?.active ?? true} /><span>Inscripción activa</span></label></div>
  <button class="portal-button" type="submit">{athlete ? 'Guardar datos' : 'Inscribir atleta'} <span aria-hidden="true">→</span></button>
  {athlete && <p class="portal-help">La cuota según la categoría se usa en meses que aún no se han publicado. Para corregir un cargo existente, registra un ajuste en Mensualidades.</p>}
</form>
<script define:vars={{ feeLabels }}>
  document.querySelectorAll('[data-category-select]').forEach(select => {
    const form = select.closest('form');
    const target = form?.querySelector('[data-fee-value]');
    if (!target) return;
    select.addEventListener('change', () => { target.textContent = feeLabels[select.value] ?? ''; });
  });
</script>
