---
import type { Charge } from '../../lib/portal/types';
import { money, plainMoney, monthLabel, dueLabel } from './format';
interface Props { charge: Charge; prefix: string; cap: number; filled: number; today: string; inPayAll: boolean; }
const { charge, prefix, cap, filled, today, inPayAll } = Astro.props;
---
<div class="portal-allocation-row" data-allocation-athlete-id={charge.athleteId} role="group" tabindex="-1" aria-label={`Mensualidad de ${charge.athleteName}, ${monthLabel(charge.period)}`}>
  <div><label for={`${prefix}-${charge.id}`}>{charge.athleteName}<small id={`${prefix}-${charge.id}-balance`}>{monthLabel(charge.period)} · se deben {money(charge.balanceMinor)} · {dueLabel(charge.dueDate, today).toLowerCase()}</small></label>{cap > 0 && <button class="portal-quick-fill" type="button" data-quick-fill={`${prefix}-${charge.id}`} data-amount={plainMoney(cap)}>Pagar todo · {money(cap)}</button>}</div>
  <input type="hidden" name="allocationChargeId[]" value={charge.id} />
  <div class="portal-field"><input id={`${prefix}-${charge.id}`} name="allocationAmount[]" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" data-max-minor={cap} data-pay-all-target={inPayAll ? '1' : undefined} value={filled > 0 ? plainMoney(filled) : ''} placeholder={`${plainMoney(cap)}…`} aria-label={`Monto en colones para ${charge.athleteName}, ${monthLabel(charge.period)}`} aria-describedby={`${prefix}-${charge.id}-balance ${prefix}-${charge.id}-error ${prefix}-amount-check`} data-allocation /><p id={`${prefix}-${charge.id}-error`} class="portal-help portal-field-error" data-allocation-error role="status" hidden></p></div>
</div>
