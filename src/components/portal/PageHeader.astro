---
interface Props { eyebrow?: string; title: string; description?: string; backHref?: string; backLabel?: string; }
const { eyebrow = 'Ajedrez Belén', title, description, backHref, backLabel = 'Volver' } = Astro.props;
---
<header class="portal-page-heading">
  <div>{backHref && <a class="portal-back-link" href={backHref}><span aria-hidden="true">←</span>{backLabel}</a>}<p class="portal-eyebrow"><span class="checker-mark" aria-hidden="true"></span>{eyebrow}</p><h1>{title}</h1>{description && <p class="portal-description">{description}</p>}</div>
  <div class="portal-heading-action"><slot /></div>
</header>
