const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');
---
{error && <div class="portal-notice portal-notice-error" id="portal-notice" tabindex="-1" role="alert"><strong><span aria-hidden="true">✗</span> No se pudo completar.</strong><p>{errors[error] ?? errors.invalid}</p><p style="margin-top:9px">¿No logras avanzar? <a class="portal-link" href="https://wa.me/50687686102">Escríbenos por WhatsApp <span aria-hidden="true">↗</span></a> y lo resolvemos contigo.</p></div>}
{notice && <div class="portal-notice portal-notice-success" id="portal-notice" tabindex="-1" role="status"><strong><span aria-hidden="true">✓</span> Listo.</strong><p>{notices[notice] ?? 'La acción se completó.'}</p></div>}
{(error || notice) && <script>
  // The message belongs to the action that just finished; refreshing or
  // sharing this URL must not announce it again as if it were new.
  const clean = new URL(window.location.href);
  const code = clean.searchParams.get('error');
  clean.searchParams.delete('notice');
  clean.searchParams.delete('error');
  window.history.replaceState(null, '', clean);
  // Land keyboard and screen-reader users on the outcome. Only link a field
  // when this error code names one; a required-but-empty control is not proof
  // that it caused the failure.
  const box = document.querySelector<HTMLElement>('#portal-notice');
  const anchors: Record<string, string> = {
    invalid_amount: '#amount',
    invalid_allocations: '#allocation-group',
    overallocated: '#allocation-group',
    allocation_exceeds_balance: '#allocation-group',
    allocation_mismatch: '#allocation-group',
    invalid_allocation: '#allocation-group',
  };
  const href = code ? anchors[code] : undefined;
  const field = href ? document.querySelector(href) : null;
  if (field && box && href) {
    const link = document.createElement('a');
    link.className = 'portal-link';
    link.href = href;
    link.textContent = 'Ir al dato que hay que corregir';
    box.appendChild(link);
  }
  box?.focus({ preventScroll: false });
</script>}
