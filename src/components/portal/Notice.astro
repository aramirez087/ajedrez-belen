const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');
---
{error && <div class="portal-notice portal-notice-error" role="alert"><strong><span aria-hidden="true">✗</span> No se pudo completar.</strong><p>{errors[error] ?? errors.invalid}</p><p style="margin-top:9px">¿No logras avanzar? <a class="portal-link" href="https://wa.me/50687686102">Escríbenos por WhatsApp <span aria-hidden="true">↗</span></a> y lo resolvemos contigo.</p></div>}
{notice && <div class="portal-notice portal-notice-success" role="status"><strong><span aria-hidden="true">✓</span> Listo.</strong><p>{notices[notice] ?? 'La acción se completó.'}</p></div>}
{(error || notice) && <script>
  // The message belongs to the action that just finished; refreshing or
  // sharing this URL must not announce it again as if it were new.
  const clean = new URL(window.location.href);
  clean.searchParams.delete('notice');
  clean.searchParams.delete('error');
  window.history.replaceState(null, '', clean);
</script>}
