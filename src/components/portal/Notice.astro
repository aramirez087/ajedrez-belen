---
const errors: Record<string, string> = {
  recipient_missing: 'No encontramos la cuenta familiar designada. Revisa ese registro antes de continuar; no se eligió otro destinatario.',
  recipient_pending: 'La cuenta destinataria todavía necesita revisión. Comprueba sus datos, verificación y permisos. El comprobante sigue disponible y no se preparó un correo nuevo.',
  existing_receipt_email: 'Este comprobante ya tiene un registro de correo. Se conserva su destinatario y su historial; esta acción no crea otro envío ni cambia su destino. Revisa su estado en la lista.',
  too_large: 'El archivo supera el límite de 3 MB. Adjunta un JPG, PNG o PDF más pequeño.',
  invalid_form: 'No pudimos leer el formulario. Revisa los datos y vuelve a enviarlo.',
  invalid_fields: 'Revisa que los campos obligatorios estén completos.',
  invalid_amount: 'Ingresa un monto válido en colones, con un máximo de dos decimales.',
  invalid_allocations: 'Revisa los montos que deseas aplicar a cada mensualidad.',
  duplicate_transfer: 'Esta referencia bancaria ya está registrada. Revisa el pago existente antes de enviar otro.',
  overallocated: 'El monto aplicado supera el pago o el saldo disponible de una mensualidad.',
  already_verified: 'Este pago ya fue confirmado. Consulta su comprobante e historial.',
  invalid_period: 'Selecciona un mes válido para las mensualidades.',
  invalid_discount: 'El descuento debe ser menor que la cuota y tener un motivo.',
  invitation_expired: 'La invitación venció. Solicita una nueva a la Asociación.',
  email_mismatch: 'Inicia sesión con el mismo correo al que se envió la invitación.',
  bank_check_required: 'Confirma primero la transferencia en la cuenta bancaria de la Asociación.',
  inactive_user: 'Esta cuenta o su vínculo ya no está activo. Contacta a la Asociación.',
  limit_reached: 'Se alcanzó el límite disponible para esta acción.',
  no_changes: 'No hay cambios que guardar.',
  not_retryable: 'Este correo necesita que se confirme su estado antes de reenviarlo.',
  setup_required: 'La configuración del servicio está pendiente.',
  operation_failed: 'No pudimos completar la acción. Revisa los datos y vuelve a intentarlo.',
  invalid: 'Revisa los campos. El monto, la fecha, la referencia y la distribución del pago deben ser válidos.',
  invalid_payment: 'Revisa los datos de la transferencia y las mensualidades seleccionadas.',
  invalid_allocation: 'La suma de las mensualidades debe coincidir con el monto transferido.',
  allocation_mismatch: 'La suma distribuida debe coincidir con el monto del pago.',
  duplicate_reference: 'Esta referencia bancaria ya está registrada. Revisa el pago existente antes de enviar otro.',
  duplicate: 'Este registro ya existe. Revisa los datos antes de continuar.',
  oversized: 'El archivo supera el límite de 3 MB. Adjunta un JPG, PNG o PDF más pequeño.',
  invalid_file: 'Adjunta un archivo JPG, PNG o PDF válido, de hasta 3 MB.',
  draft_expired: 'El archivo temporal venció. Vuelve a adjuntarlo para registrar el pago.',
  draft_not_found: 'El archivo temporal no está disponible. Vuelve a adjuntarlo.',
  draft_limit: 'Se alcanzó el límite de archivos temporales. Espera su vencimiento o contacta a la Asociación para su limpieza.',
  draft_mismatch: 'El archivo cambió después de guardarse. Selecciona de nuevo el original que corresponde a este pago.',
  original_missing: 'El archivo original no está disponible. Vuelve a adjuntarlo.',
  conflict: 'El registro cambió mientras lo revisabas. Actualiza la página para ver su estado actual.',
  forbidden: 'Tu cuenta no tiene acceso a esta acción.',
  not_found: 'No encontramos ese registro o ya no está disponible para tu cuenta.',
  bank_check: 'Confirma primero la transferencia en la cuenta bancaria de la Asociación.',
  invalid_invitation: 'La invitación venció, fue revocada o no corresponde al correo de tu cuenta.',
  invalid_state: 'Esta acción no está disponible para el estado actual del pago.',
  unavailable: 'No pudimos completar la acción. Vuelve a intentarlo en unos minutos.',
};
const notices: Record<string, string> = {
  email_prepared: 'La preparación del correo quedó registrada. Revisa su destinatario y estado en la lista; esta acción no realiza el envío.',
  athlete_created: 'Atleta inscrito. Ya puedes crear la invitación de sus encargados.',
  athlete_updated: 'Datos y cuota del atleta actualizados.',
  links_updated: 'Vínculos y preferencias actualizados.',
  month_published: 'Mensualidades publicadas. Los cargos de este mes ya están disponibles para las familias.',
  charge_adjusted: 'Ajuste guardado. El cargo conserva el registro de esta corrección.',
  invitation_created: 'Invitación creada. Copia el enlace que aparece abajo para compartirlo con la persona indicada.',
  invitation_redeemed: 'Invitación aceptada. Ya puedes consultar los atletas vinculados a tu cuenta.',
  verified: 'Pago confirmado y comprobante emitido. Revisa el estado del correo para confirmar si está preparado, enviado o necesita atención.',
  verified_email_pending: 'Pago confirmado y comprobante emitido. El correo está pendiente de procesar.',
  credit_applied: 'Saldo a favor aplicado a las mensualidades seleccionadas.',
  email_queued: 'Correo preparado para reintentar. Procesa el lote pendiente cuando estés listo.',
  email_processed: 'Se procesó el lote de correos. Revisa el estado de cada destinatario.',
  dry_run: 'Envío simulado completado. El estado de cada correo aparece en la lista.',
  drafts_cleaned: 'Se revisaron los borradores vencidos. Los archivos vinculados a pagos y sus versiones anteriores se conservan.',
  submitted: 'Recibimos la información de tu transferencia. El pago sigue pendiente hasta que la Asociación compruebe el ingreso en el banco.',
  revised: 'Guardamos la información actualizada. Tu pago vuelve a estar en revisión.',
  approved: 'Pago confirmado. El comprobante está disponible y el correo quedó preparado.',
  needs_info: 'Se solicitó información adicional. La familia puede consultar el motivo en su portal.',
  rejected: 'Pago rechazado. El motivo quedó en el historial.',
  voided: 'Pago anulado. Se revirtió su aplicación a las mensualidades y se conservó el historial.',
  saved: 'Cambios guardados.',
  published: 'Mensualidades publicadas. Los cargos de este mes ya están disponibles para las familias.',
  invited: 'Invitación creada. Copia su enlace y compártelo con la persona indicada.',
  redeemed: 'Invitación aceptada. Ya puedes consultar los atletas vinculados a tu cuenta.',
  revoked: 'Vínculo revocado.',
  email: 'Se procesó el correo. Revisa el estado de entrega en la lista.',
  demo: 'Sesión de demostración iniciada.',
};
const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');
---
{error && <div class="portal-notice portal-notice-error" role="alert"><strong>No se completó la acción.</strong><p>{errors[error] ?? errors.invalid}</p></div>}
{notice && <div class="portal-notice" role="status"><p>{notices[notice] ?? 'La acción se completó.'}</p></div>}
