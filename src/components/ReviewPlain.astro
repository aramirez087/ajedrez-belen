---
import '../styles/fonts.css';
interface Props { title: string; description: string; canonical: string }
const { title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/media/favicon.png" type="image/png" />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      body { margin: 0; background: #f3eee3; color: #16130f; font: 18px/1.65 var(--font-brand-body); overflow-wrap: anywhere; }
      main { max-width: 42rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
      main :global(h1) { font-family: var(--font-brand-display); font-size: 2.1rem; font-weight: 600; line-height: 1.25; margin: 0 0 1rem; }
      main :global(h2) { font-family: var(--font-brand-body); font-size: 1.25rem; font-weight: 600; line-height: 1.4; margin: 2rem 0 0.4rem; }
      main :global(p), main :global(li) { margin: 0.75rem 0; }
      main :global(a) { color: #b3222b; }
      .mark { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 1.25rem; font-family: var(--font-brand-body); font-weight: 650; }
      .mark img { width: 46px; height: 50px; }
    </style>
  </head>
  <body>
    <main>
      <p class="mark"><img src="/media/crest-provisional.webp" alt="" width="46" height="50" /> Asociación Ajedrez Belén</p>
      <slot />
    </main>
  </body>
</html>
