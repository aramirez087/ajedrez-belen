---
interface Props { title: string; description: string; canonical: string }
const { title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/media/favicon.png" type="image/png" />
    <style>
      body { margin: 0; background: #f7f4ec; color: #1c1a16; font: 18px/1.6 Georgia, "Iowan Old Style", Palatino, serif; }
      main { max-width: 42rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
      h1 { font-size: 2.1rem; line-height: 1.15; margin: 0 0 1rem; }
      h2 { font-size: 1.25rem; line-height: 1.3; margin: 2rem 0 0.4rem; }
      p, li { margin: 0.75rem 0; }
      a { color: #8e1d2c; }
      .mark { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 1.25rem; font-family: "Gill Sans", "Trebuchet MS", sans-serif; font-weight: 700; }
      .mark img { width: 46px; height: 50px; }
    </style>
  </head>
  <body>
    <main>
      <p class="mark"><img src="/media/crest-provisional.webp" alt="" width="46" height="50" /> Asociación Ajedrez Belén</p>
      <slot />
    </main>
  </body>
</html>
